import Mathlib
import MillenniumYangMills
import CompactLieGroupsSimplicity

noncomputable section

open scoped Matrix BigOperators Classical
open YangMills

namespace YangMills.CurvatureJetConstructive

/-! ============================================================================
    PART 1: FREE DIFFERENTIAL JET POLYNOMIAL RING `CoordPoly d`
    ============================================================================ -/

/-- Jet coordinate index `(α, μ, a)` representing `∂^α A_μ^a`, where `α : Multiset (Fin 4)`
    canonically identifies permutation-equivalent derivative multi-indices. -/
abbrev JetVar (d : ℕ) : Type := Multiset (Fin 4) × Fin 4 × Fin d

/-- Universal commutative differential polynomial ring `ℂ[∂^α A_μ^a]`. -/
abbrev CoordPoly (d : ℕ) : Type := MvPolynomial (JetVar d) ℂ

/-- Formal partial derivative `∂_μ` as a `ℂ`-derivation on `CoordPoly d`,
    sending generator `X (α, ν, a)` to `X (μ ::ₘ α, ν, a)`. -/
def coordDeriv {d : ℕ} (μ : Fin 4) : Derivation ℂ (CoordPoly d) (CoordPoly d) :=
  MvPolynomial.mkDerivation ℂ fun v => MvPolynomial.X (μ ::ₘ v.1, v.2.1, v.2.2)

@[simp]
theorem coordDeriv_X {d : ℕ} (μ : Fin 4) (α : Multiset (Fin 4)) (ν : Fin 4) (a : Fin d) :
    coordDeriv μ (MvPolynomial.X (α, ν, a) : CoordPoly d) = MvPolynomial.X (μ ::ₘ α, ν, a) := by
  simp [coordDeriv]

theorem coordDeriv_leibniz {d : ℕ} (μ : Fin 4) (f g : CoordPoly d) :
    coordDeriv μ (f * g) = coordDeriv μ f * g + f * coordDeriv μ g := by
  rw [Derivation.leibniz, smul_eq_mul, smul_eq_mul, mul_comm g (coordDeriv μ f)]
  ring

theorem coordDeriv_comm {d : ℕ} (μ ν : Fin 4) (f : CoordPoly d) :
    coordDeriv μ (coordDeriv ν f) = coordDeriv ν (coordDeriv μ f) := by
  induction f using MvPolynomial.induction_on with
  | C c => simp
  | add f g hf hg => simp [map_add, hf, hg]
  | mul_X f v hf =>
    have h_v : coordDeriv μ (coordDeriv ν (MvPolynomial.X v : CoordPoly d)) =
        coordDeriv ν (coordDeriv μ (MvPolynomial.X v : CoordPoly d)) := by
      rw [coordDeriv_X, coordDeriv_X, coordDeriv_X, coordDeriv_X, Multiset.cons_swap]
    simp only [coordDeriv_leibniz, map_add, hf, h_v]
    ring

/-- Complex conjugation involution on `CoordPoly d`, conjugating coefficients and fixing `X v`. -/
def coordConj {d : ℕ} : CoordPoly d →+* CoordPoly d :=
  MvPolynomial.eval₂Hom (MvPolynomial.C.comp (starRingEnd ℂ)) MvPolynomial.X

@[simp]
theorem coordConj_C {d : ℕ} (c : ℂ) :
    coordConj (MvPolynomial.C c : CoordPoly d) = MvPolynomial.C (starRingEnd ℂ c) := by
  simp [coordConj]

@[simp]
theorem coordConj_X {d : ℕ} (v : JetVar d) :
    coordConj (MvPolynomial.X v : CoordPoly d) = MvPolynomial.X v := by
  simp [coordConj]

theorem coordConj_involutive {d : ℕ} (f : CoordPoly d) : coordConj (coordConj f) = f := by
  induction f using MvPolynomial.induction_on with
  | C c => simp
  | add f g hf hg => simp [map_add, hf, hg]
  | mul_X f v hf => simp [map_mul, hf]

theorem coordConj_smul {d : ℕ} (c : ℂ) (f : CoordPoly d) :
    coordConj (c • f) = starRingEnd ℂ c • coordConj f := by
  rw [Algebra.smul_def, Algebra.smul_def, map_mul]
  simp [MvPolynomial.algebraMap_eq]

/-- Classical scaling weight of a jet variable `∂^α A_μ^a`: `dim(A) = 1`, `dim(∂) = 1`. -/
def jetWeight {d : ℕ} (v : JetVar d) : ℕ := v.1.card + 1

/-- Homogeneous degree-grading lift `CoordPoly d →ₐ[ℂ] Polynomial (CoordPoly d)`
    sending `X v ↦ X v * t^(jetWeight v)`. Evaluating at `t = 1` recovers `f`. -/
def homogLift {d : ℕ} : CoordPoly d →ₐ[ℂ] Polynomial (CoordPoly d) :=
  MvPolynomial.aeval fun v => Polynomial.C (MvPolynomial.X v) * Polynomial.X ^ jetWeight v

theorem eval_one_homogLift {d : ℕ} (f : CoordPoly d) :
    Polynomial.eval 1 (homogLift f) = f := by
  induction f using MvPolynomial.induction_on with
  | C c => simp [homogLift, MvPolynomial.algebraMap_eq]
  | add f g hf hg => simp only [map_add, Polynomial.eval_add, hf, hg]
  | mul_X f v hf =>
    simp only [map_mul, Polynomial.eval_mul, hf]
    simp [homogLift]

theorem homogLift_injective {d : ℕ} : Function.Injective (homogLift (d := d)) := by
  intro f g h
  have := congrArg (Polynomial.eval 1) h
  simpa [eval_one_homogLift] using this

/-- Weighted degree of `f : CoordPoly d` under `jetWeight`. -/
def coordWdeg {d : ℕ} (f : CoordPoly d) : ℕ :=
  (homogLift f).natDegree

theorem coordWdeg_zero {d : ℕ} : coordWdeg (0 : CoordPoly d) = 0 := by
  simp [coordWdeg]

theorem coordWdeg_one {d : ℕ} : coordWdeg (1 : CoordPoly d) = 0 := by
  simp [coordWdeg]

theorem coordWdeg_X {d : ℕ} (α : Multiset (Fin 4)) (ν : Fin 4) (a : Fin d) :
    coordWdeg (MvPolynomial.X (α, ν, a) : CoordPoly d) = α.card + 1 := by
  simp [coordWdeg, homogLift, jetWeight]

theorem coordWdeg_smul {d : ℕ} (c : ℂ) (hc : c ≠ 0) (f : CoordPoly d) :
    coordWdeg (c • f) = coordWdeg f := by
  dsimp [coordWdeg]
  rw [map_smul, Algebra.smul_def]
  have h_map : algebraMap ℂ (Polynomial (CoordPoly d)) c = Polynomial.C (MvPolynomial.C c) := rfl
  rw [h_map, Polynomial.natDegree_C_mul]
  simpa [MvPolynomial.C_eq_zero] using hc

theorem coordWdeg_add_le {d : ℕ} (f g : CoordPoly d) :
    coordWdeg (f + g) ≤ max (coordWdeg f) (coordWdeg g) := by
  dsimp [coordWdeg]
  rw [map_add]
  exact Polynomial.natDegree_add_le _ _

theorem coordWdeg_mul_le {d : ℕ} (f g : CoordPoly d) :
    coordWdeg (f * g) ≤ coordWdeg f + coordWdeg g := by
  dsimp [coordWdeg]
  rw [map_mul]
  exact Polynomial.natDegree_mul_le

theorem coordWdeg_mul {d : ℕ} {f g : CoordPoly d} (hf : f ≠ 0) (hg : g ≠ 0) :
    coordWdeg (f * g) = coordWdeg f + coordWdeg g := by
  dsimp [coordWdeg]
  rw [map_mul]
  have hf' : homogLift f ≠ 0 := fun h => hf (homogLift_injective (h.trans (map_zero _).symm))
  have hg' : homogLift g ≠ 0 := fun h => hg (homogLift_injective (h.trans (map_zero _).symm))
  exact Polynomial.natDegree_mul hf' hg'

theorem coordWdeg_coordConj {d : ℕ} (f : CoordPoly d) :
    coordWdeg (coordConj f) = coordWdeg f := by
  dsimp [coordWdeg]
  have h_map : homogLift (coordConj f) = Polynomial.map coordConj (homogLift f) := by
    induction f using MvPolynomial.induction_on with
    | C c =>
      simp [homogLift, coordConj, MvPolynomial.algebraMap_eq]
    | add f g hf hg =>
      simp only [map_add, Polynomial.map_add, hf, hg]
    | mul_X f v hf =>
      simp only [map_mul, Polynomial.map_mul, hf]
      simp [homogLift, coordConj]
  rw [h_map]
  exact Polynomial.natDegree_map_eq_of_injective
    (fun a b h => by simpa [coordConj_involutive] using congrArg coordConj h) _

/-- Weight of a monomial exponent `m : JetVar d →₀ ℕ`. -/
def monWeight {d : ℕ} (m : JetVar d →₀ ℕ) : ℕ :=
  m.sum fun v k => k * jetWeight v

@[simp]
theorem monWeight_zero {d : ℕ} : monWeight (0 : JetVar d →₀ ℕ) = 0 := by
  simp [monWeight]

@[simp]
theorem monWeight_single {d : ℕ} (v : JetVar d) (k : ℕ) :
    monWeight (Finsupp.single v k) = k * jetWeight v := by
  simp [monWeight]

theorem monWeight_add {d : ℕ} (m₁ m₂ : JetVar d →₀ ℕ) :
    monWeight (m₁ + m₂) = monWeight m₁ + monWeight m₂ := by
  dsimp [monWeight]
  exact Finsupp.sum_add_index' (fun _ => by simp) (fun _ _ _ => by ring)

theorem homogLift_monomial {d : ℕ} (m : JetVar d →₀ ℕ) (c : ℂ) :
    homogLift (MvPolynomial.monomial m c) =
      Polynomial.C (MvPolynomial.monomial m c) * Polynomial.X ^ monWeight m := by
  induction m using Finsupp.induction with
  | zero =>
    rw [← MvPolynomial.C_apply]
    simp [homogLift, MvPolynomial.algebraMap_eq]
  | single_add v k m hv hk ih =>
    have h_mul : MvPolynomial.monomial (Finsupp.single v k + m) c =
        (MvPolynomial.X v) ^ k * MvPolynomial.monomial m c := by
      rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.monomial_mul, one_mul]
    rw [h_mul, map_mul, map_pow, ih, monWeight_add, monWeight_single, pow_add]
    have hX : homogLift (MvPolynomial.X v : CoordPoly d) =
        Polynomial.C (MvPolynomial.X v) * Polynomial.X ^ jetWeight v := by
      simp [homogLift]
    rw [hX, mul_pow, ← Polynomial.C_pow, pow_mul', mul_assoc]
    rw [mul_left_comm ((Polynomial.X ^ jetWeight v) ^ k) (Polynomial.C (MvPolynomial.monomial m c))]
    rw [← mul_assoc (Polynomial.C (MvPolynomial.X v ^ k)) (Polynomial.C (MvPolynomial.monomial m c))]
    rw [← map_mul Polynomial.C]

theorem homogLift_coeff {d : ℕ} (f : CoordPoly d) (k : ℕ) :
    (homogLift f).coeff k =
      ∑ m ∈ f.support.filter (fun m => monWeight m = k), MvPolynomial.monomial m (f.coeff m) := by
  nth_rw 1 [MvPolynomial.as_sum f]
  simp only [map_sum, homogLift_monomial, Polynomial.finsetSum_coeff,
    Polynomial.coeff_C_mul_X_pow]
  rw [Finset.sum_filter]
  refine Finset.sum_congr rfl fun m _ => ?_
  by_cases h : k = monWeight m
  · simp [h, eq_comm]
  · simp [h, eq_comm]

theorem coordWdeg_le_iff {d : ℕ} (f : CoordPoly d) (N : ℕ) :
    coordWdeg f ≤ N ↔ ∀ m ∈ f.support, monWeight m ≤ N := by
  constructor
  · intro h m hm
    by_contra h_gt
    push Not at h_gt
    have h_zero : (homogLift f).coeff (monWeight m) = 0 :=
      Polynomial.coeff_eq_zero_of_natDegree_lt (lt_of_le_of_lt h h_gt)
    rw [homogLift_coeff] at h_zero
    have h_coeff := congrArg (fun p => MvPolynomial.coeff m p) h_zero
    rw [MvPolynomial.coeff_zero, MvPolynomial.coeff_sum, Finset.sum_eq_single m] at h_coeff
    · simp only [MvPolynomial.coeff_monomial] at h_coeff
      exact (MvPolynomial.mem_support_iff.mp hm) h_coeff
    · intro m' _ hne
      simp [MvPolynomial.coeff_monomial, hne]
    · intro h_not
      exfalso
      exact h_not (Finset.mem_filter.mpr ⟨hm, rfl⟩)
  · intro h
    apply Polynomial.natDegree_le_iff_coeff_eq_zero.mpr
    intro k hk
    rw [homogLift_coeff]
    apply Finset.sum_eq_zero
    intro m hm
    rcases Finset.mem_filter.mp hm with ⟨hm_supp, hm_w⟩
    have hm_le := h m hm_supp
    omega

theorem coordWdeg_X_pow_le {d : ℕ} (v : JetVar d) (k : ℕ) :
    coordWdeg ((MvPolynomial.X v : CoordPoly d) ^ k) ≤ k * jetWeight v := by
  induction k with
  | zero => simp [coordWdeg_one]
  | succ k ih =>
    rw [pow_succ, Nat.succ_mul]
    have hX : coordWdeg (MvPolynomial.X v : CoordPoly d) = jetWeight v := by
      simpa [jetWeight] using coordWdeg_X v.1 v.2.1 v.2.2
    have hmul := coordWdeg_mul_le ((MvPolynomial.X v : CoordPoly d) ^ k) (MvPolynomial.X v)
    omega

theorem coordWdeg_coordDeriv_X_pow_le {d : ℕ} (μ : Fin 4) (v : JetVar d) (k : ℕ) :
    coordWdeg (coordDeriv μ ((MvPolynomial.X v : CoordPoly d) ^ k)) ≤ k * jetWeight v + 1 := by
  induction k with
  | zero => simp [coordWdeg_zero]
  | succ k ih =>
    rw [pow_succ, coordDeriv_leibniz, Nat.succ_mul]
    refine le_trans (coordWdeg_add_le _ _) (max_le ?_ ?_)
    · refine le_trans (coordWdeg_mul_le _ _) ?_
      have hX : coordWdeg (MvPolynomial.X v : CoordPoly d) = jetWeight v := by
        simpa [jetWeight] using coordWdeg_X v.1 v.2.1 v.2.2
      omega
    · refine le_trans (coordWdeg_mul_le _ _) ?_
      have hk := coordWdeg_X_pow_le v k
      have hX' : coordWdeg (coordDeriv μ (MvPolynomial.X v : CoordPoly d)) = jetWeight v + 1 := by
        rw [coordDeriv_X]
        simpa [jetWeight] using coordWdeg_X (μ ::ₘ v.1) v.2.1 v.2.2
      omega

theorem coordWdeg_coordDeriv_monomial_le {d : ℕ} (μ : Fin 4) (m : JetVar d →₀ ℕ) (c : ℂ) :
    coordWdeg (coordDeriv μ (MvPolynomial.monomial m c)) ≤ monWeight m + 1 := by
  induction m using Finsupp.induction with
  | zero =>
    have hC : MvPolynomial.monomial (0 : JetVar d →₀ ℕ) c = algebraMap ℂ (CoordPoly d) c := by
      rw [MvPolynomial.algebraMap_eq, MvPolynomial.C_apply]
    rw [hC, Derivation.map_algebraMap, coordWdeg_zero]
    omega
  | single_add v k m hv hk ih =>
    have h_mul : MvPolynomial.monomial (Finsupp.single v k + m) c =
        (MvPolynomial.X v) ^ k * MvPolynomial.monomial m c := by
      rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.monomial_mul, one_mul]
    rw [h_mul, coordDeriv_leibniz, monWeight_add, monWeight_single]
    refine le_trans (coordWdeg_add_le _ _) (max_le ?_ ?_)
    · refine le_trans (coordWdeg_mul_le _ _) ?_
      have h1 := coordWdeg_coordDeriv_X_pow_le μ v k
      have h2 : coordWdeg (MvPolynomial.monomial m c) ≤ monWeight m :=
        (coordWdeg_le_iff _ _).mpr fun m' hm' => by
          have := MvPolynomial.support_monomial_subset hm'
          rw [Finset.mem_singleton] at this
          subst this
          exact le_rfl
      omega
    · refine le_trans (coordWdeg_mul_le _ _) ?_
      have h1 := coordWdeg_X_pow_le v k
      omega

theorem coordWdeg_coordDeriv_le {d : ℕ} (μ : Fin 4) (f : CoordPoly d) :
    coordWdeg (coordDeriv μ f) ≤ coordWdeg f + 1 := by
  nth_rw 1 [MvPolynomial.as_sum f]
  rw [map_sum]
  refine (coordWdeg_le_iff _ _).mpr fun m' hm' => ?_
  rcases Finset.mem_biUnion.mp (MvPolynomial.support_sum hm') with ⟨m, hm, hm'⟩
  have h_le : monWeight m' ≤ monWeight m + 1 :=
    (coordWdeg_le_iff _ _).mp (coordWdeg_coordDeriv_monomial_le μ m (f.coeff m)) m' hm'
  have hm_le : monWeight m ≤ coordWdeg f :=
    (coordWdeg_le_iff f (coordWdeg f)).mp le_rfl m hm
  omega

/-- Any `ℂ`-subalgebra of `CoordPoly d` containing the order-0 generators `X (0, ν, a)` and
    closed under `coordDeriv μ` is the entire algebra `⊤`. -/
theorem coordPoly_generated_of_basis {d : ℕ} (S : Subalgebra ℂ (CoordPoly d))
    (h0 : ∀ (ν : Fin 4) (a : Fin d), (MvPolynomial.X (0, ν, a) : CoordPoly d) ∈ S)
    (hD : ∀ (μ : Fin 4) (f : CoordPoly d), f ∈ S → coordDeriv μ f ∈ S) :
    S = ⊤ := by
  have hX : ∀ (α : Multiset (Fin 4)) (ν : Fin 4) (a : Fin d),
      (MvPolynomial.X (α, ν, a) : CoordPoly d) ∈ S := by
    intro α ν a
    induction α using Multiset.induction_on with
    | empty => exact h0 ν a
    | cons μ α ih =>
      rw [← coordDeriv_X μ α ν a]
      exact hD μ _ ih
  rw [eq_top_iff]
  intro f _
  clear ‹f ∈ ⊤›
  induction f using MvPolynomial.induction_on with
  | C c => exact S.algebraMap_mem c
  | add f g hf hg => exact S.add_mem hf hg
  | mul_X f v hf => exact S.mul_mem hf (hX v.1 v.2.1 v.2.2)

/-- Universal evaluation of `CoordPoly d` at any permutation-invariant jet assignment. -/
def coordJetEval {d : ℕ} (jet : List (Fin 4) → Fin 4 → Fin d → ℂ)
    (h_perm : ∀ α β, α.Perm β → jet α = jet β) : CoordPoly d →ₐ[ℂ] ℂ :=
  MvPolynomial.aeval fun v =>
    Quot.liftOn v.1 (fun l => jet l v.2.1 v.2.2)
      (fun l₁ l₂ h => congrFun (congrFun (h_perm l₁ l₂ h) v.2.1) v.2.2)

@[simp]
theorem coordJetEval_X_foldr {d : ℕ} (jet : List (Fin 4) → Fin 4 → Fin d → ℂ)
    (h_perm : ∀ α β, α.Perm β → jet α = jet β)
    (α : List (Fin 4)) (ν : Fin 4) (a : Fin d) :
    coordJetEval jet h_perm (α.foldr (fun μ P => coordDeriv μ P) (MvPolynomial.X (0, ν, a))) =
      jet α ν a := by
  have h_fold : ∀ (l : List (Fin 4)),
      l.foldr (fun μ P => coordDeriv μ P) (MvPolynomial.X (0, ν, a) : CoordPoly d) =
        MvPolynomial.X (↑l, ν, a) := by
    intro l
    induction l with
    | nil => rfl
    | cons μ l ih =>
      simp only [List.foldr_cons, ih, coordDeriv_X]
      rfl
  rw [h_fold]
  simp [coordJetEval]

/-- Spacetime matrix action on list-indexed jet generators. -/
def actJetList {d : ℕ} (R : Matrix (Fin 4) (Fin 4) ℝ) :
    List (Fin 4) → Fin 4 → Fin d → CoordPoly d
  | [], ν, a => ∑ ν' : Fin 4, ((R ν' ν : ℝ) : ℂ) • MvPolynomial.X (0, ν', a)
  | μ :: l, ν, a => ∑ μ' : Fin 4, ((R μ' μ : ℝ) : ℂ) • coordDeriv μ' (actJetList R l ν a)

theorem actJetList_perm {d : ℕ} (R : Matrix (Fin 4) (Fin 4) ℝ)
    {l₁ l₂ : List (Fin 4)} (h : l₁.Perm l₂) (ν : Fin 4) (a : Fin d) :
    actJetList R l₁ ν a = actJetList R l₂ ν a := by
  induction h with
  | nil => rfl
  | cons x _ ih => simp only [actJetList, ih]
  | swap x y l =>
    simp only [actJetList, map_sum, Finset.smul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun μ' _ => ?_
    refine Finset.sum_congr rfl fun ν' _ => ?_
    rw [Derivation.map_smul, Derivation.map_smul, smul_smul, smul_smul,
        mul_comm ((R ν' y : ℝ) : ℂ), coordDeriv_comm]
  | trans _ _ ih₁ ih₂ => exact ih₁.trans ih₂

/-- Spacetime matrix action on `JetVar d`. -/
def actJet {d : ℕ} (R : Matrix (Fin 4) (Fin 4) ℝ) (v : JetVar d) : CoordPoly d :=
  Quot.liftOn v.1 (fun l => actJetList R l v.2.1 v.2.2)
    (fun _ _ h => actJetList_perm R h v.2.1 v.2.2)

@[simp]
theorem actJet_zero {d : ℕ} (R : Matrix (Fin 4) (Fin 4) ℝ) (ν : Fin 4) (a : Fin d) :
    actJet R (0, ν, a) = ∑ ν' : Fin 4, ((R ν' ν : ℝ) : ℂ) • MvPolynomial.X (0, ν', a) := rfl

@[simp]
theorem actJet_cons {d : ℕ} (R : Matrix (Fin 4) (Fin 4) ℝ)
    (μ : Fin 4) (α : Multiset (Fin 4)) (ν : Fin 4) (a : Fin d) :
    actJet R (μ ::ₘ α, ν, a) =
      ∑ μ' : Fin 4, ((R μ' μ : ℝ) : ℂ) • coordDeriv μ' (actJet R (α, ν, a)) := by
  induction α using Quot.inductionOn with
  | _ l => rfl

/-- `ℂ`-algebra endomorphism of `CoordPoly d` induced by `R : Matrix (Fin 4) (Fin 4) ℝ`. -/
def transformCoord {d : ℕ} (R : Matrix (Fin 4) (Fin 4) ℝ) : CoordPoly d →ₐ[ℂ] CoordPoly d :=
  MvPolynomial.aeval (actJet R)

@[simp]
theorem transformCoord_X {d : ℕ} (R : Matrix (Fin 4) (Fin 4) ℝ) (v : JetVar d) :
    transformCoord R (MvPolynomial.X v) = actJet R v :=
  MvPolynomial.aeval_X _ v

theorem actJet_one {d : ℕ} (v : JetVar d) :
    actJet (1 : Matrix (Fin 4) (Fin 4) ℝ) v = MvPolynomial.X v := by
  rcases v with ⟨α, ν, a⟩
  induction α using Multiset.induction_on with
  | empty =>
    rw [actJet_zero]
    simp [Matrix.one_apply]
  | cons μ α ih =>
    rw [actJet_cons, ih]
    simp only [Matrix.one_apply]
    rw [Finset.sum_eq_single μ]
    · simp [coordDeriv_X]
    · intro μ' _ hne; simp [hne]
    · intro h_not; exact absurd (Finset.mem_univ μ) h_not

theorem transformCoord_one {d : ℕ} :
    transformCoord (1 : Matrix (Fin 4) (Fin 4) ℝ) = AlgHom.id ℂ (CoordPoly d) := by
  ext v
  simp [actJet_one]

theorem transformCoord_deriv {d : ℕ} (R : Matrix (Fin 4) (Fin 4) ℝ) (μ : Fin 4) (f : CoordPoly d) :
    transformCoord R (coordDeriv μ f) =
      ∑ μ' : Fin 4, ((R μ' μ : ℝ) : ℂ) • coordDeriv μ' (transformCoord R f) := by
  induction f using MvPolynomial.induction_on with
  | C c =>
    simp [MvPolynomial.algebraMap_eq]
  | add f g hf hg =>
    simp only [map_add, hf, hg, smul_add, Finset.sum_add_distrib]
  | mul_X f v hf =>
    have h_v : transformCoord R (coordDeriv μ (MvPolynomial.X v : CoordPoly d)) =
        ∑ μ' : Fin 4, ((R μ' μ : ℝ) : ℂ) • coordDeriv μ' (transformCoord R (MvPolynomial.X v)) := by
      rcases v with ⟨α, ν, a⟩
      rw [coordDeriv_X, transformCoord_X, transformCoord_X, actJet_cons]
    simp only [coordDeriv_leibniz, map_add, map_mul, hf, h_v]
    simp only [Finset.sum_mul, Finset.mul_sum, smul_mul_assoc, mul_smul_comm, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun μ' _ => ?_
    rw [← smul_add]

theorem transformCoord_mul {d : ℕ} (R₁ R₂ : Matrix (Fin 4) (Fin 4) ℝ) (f : CoordPoly d) :
    transformCoord (R₁ * R₂) f = transformCoord R₁ (transformCoord R₂ f) := by
  have h_act : ∀ v : JetVar d, actJet (R₁ * R₂) v = transformCoord R₁ (actJet R₂ v) := by
    rintro ⟨α, ν, a⟩
    induction α using Multiset.induction_on with
    | empty =>
      rw [actJet_zero, actJet_zero, map_sum]
      conv_rhs =>
        arg 2; ext ν'
        rw [AlgHom.map_smul_of_tower, transformCoord_X, actJet_zero, Finset.smul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun ν'' _ => ?_
      have h_lhs : (((R₁ * R₂) ν'' ν : ℝ) : ℂ) =
          ∑ ν' : Fin 4, ((R₂ ν' ν : ℝ) : ℂ) * ((R₁ ν'' ν' : ℝ) : ℂ) := by
        rw [Matrix.mul_apply, Complex.ofReal_sum]
        refine Finset.sum_congr rfl fun ν' _ => by rw [Complex.ofReal_mul, mul_comm]
      rw [h_lhs, Finset.sum_smul]
      refine Finset.sum_congr rfl fun ν' _ => ?_
      rw [smul_smul]
    | cons μ α ih =>
      rw [actJet_cons, actJet_cons, ih, map_sum]
      conv_rhs =>
        arg 2; ext μ'
        rw [AlgHom.map_smul_of_tower, transformCoord_deriv, Finset.smul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun μ'' _ => ?_
      have h_lhs : (((R₁ * R₂) μ'' μ : ℝ) : ℂ) =
          ∑ μ' : Fin 4, ((R₂ μ' μ : ℝ) : ℂ) * ((R₁ μ'' μ' : ℝ) : ℂ) := by
        rw [Matrix.mul_apply, Complex.ofReal_sum]
        refine Finset.sum_congr rfl fun μ' _ => by rw [Complex.ofReal_mul, mul_comm]
      rw [h_lhs, Finset.sum_smul]
      refine Finset.sum_congr rfl fun μ' _ => ?_
      rw [smul_smul]
  induction f using MvPolynomial.induction_on with
  | C c => simp [MvPolynomial.algebraMap_eq]
  | add f g hf hg => simp [map_add, hf, hg]
  | mul_X f v hf => simp [map_mul, hf, h_act]

theorem coordWdeg_actJet_le {d : ℕ} (R : Matrix (Fin 4) (Fin 4) ℝ) (v : JetVar d) :
    coordWdeg (actJet R v) ≤ jetWeight v := by
  rcases v with ⟨α, ν, a⟩
  induction α using Multiset.induction_on with
  | empty =>
    rw [actJet_zero]
    refine (coordWdeg_le_iff _ _).mpr fun m hm => ?_
    rcases Finset.mem_biUnion.mp (MvPolynomial.support_sum hm) with ⟨ν', _, hm'⟩
    have h1 : coordWdeg (((R ν' ν : ℝ) : ℂ) • (MvPolynomial.X (0, ν', a) : CoordPoly d)) ≤ 1 := by
      by_cases hc : ((R ν' ν : ℝ) : ℂ) = 0
      · simp [hc, coordWdeg_zero]
      · rw [coordWdeg_smul _ hc, coordWdeg_X]
        simp
    exact (coordWdeg_le_iff _ _).mp h1 m hm'
  | cons μ α ih =>
    rw [actJet_cons]
    change _ ≤ (μ ::ₘ α).card + 1
    rw [Multiset.card_cons]
    refine (coordWdeg_le_iff _ _).mpr fun m hm => ?_
    rcases Finset.mem_biUnion.mp (MvPolynomial.support_sum hm) with ⟨μ', _, hm'⟩
    have h_deriv : coordWdeg (coordDeriv μ' (actJet R (α, ν, a))) ≤ α.card + 1 + 1 :=
      le_trans (coordWdeg_coordDeriv_le μ' _) (Nat.add_le_add_right ih 1)
    have h_smul : coordWdeg (((R μ' μ : ℝ) : ℂ) • coordDeriv μ' (actJet R (α, ν, a))) ≤
        α.card + 1 + 1 := by
      by_cases hc : ((R μ' μ : ℝ) : ℂ) = 0
      · simp [hc, coordWdeg_zero]
      · rw [coordWdeg_smul _ hc]; exact h_deriv
    exact (coordWdeg_le_iff _ _).mp h_smul m hm'

theorem coordWdeg_transformCoord_monomial_le {d : ℕ} (R : Matrix (Fin 4) (Fin 4) ℝ)
    (m : JetVar d →₀ ℕ) (c : ℂ) :
    coordWdeg (transformCoord R (MvPolynomial.monomial m c)) ≤ monWeight m := by
  induction m using Finsupp.induction generalizing c with
  | zero =>
    rw [← MvPolynomial.C_apply]
    simp [MvPolynomial.algebraMap_eq, coordWdeg]
  | single_add v k m₀ _ _ ih_m =>
    have h_pow : ∀ j : ℕ, coordWdeg ((actJet R v) ^ j) ≤ j * jetWeight v := by
      intro j
      induction j with
      | zero => simp [coordWdeg_one]
      | succ j ihj =>
        rw [pow_succ, Nat.succ_mul]
        have h1 := coordWdeg_mul_le ((actJet R v) ^ j) (actJet R v)
        have h2 := coordWdeg_actJet_le R v
        omega
    have h_mul : MvPolynomial.monomial (Finsupp.single v k + m₀) c =
        (MvPolynomial.X v) ^ k * MvPolynomial.monomial m₀ c := by
      rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.monomial_mul, one_mul]
    rw [h_mul, map_mul, map_pow, transformCoord_X, monWeight_add, monWeight_single]
    refine le_trans (coordWdeg_mul_le _ _) ?_
    have h_pk := h_pow k
    have h_m0 := ih_m c
    omega

theorem coordWdeg_transformCoord_le {d : ℕ} (R : Matrix (Fin 4) (Fin 4) ℝ) (f : CoordPoly d) :
    coordWdeg (transformCoord R f) ≤ coordWdeg f := by
  nth_rw 1 [MvPolynomial.as_sum f]
  rw [map_sum]
  refine (coordWdeg_le_iff _ _).mpr fun m' hm' => ?_
  rcases Finset.mem_biUnion.mp (MvPolynomial.support_sum hm') with ⟨m, hm, hm'⟩
  have hm_le : monWeight m ≤ coordWdeg f := (coordWdeg_le_iff f (coordWdeg f)).mp le_rfl m hm
  have h_mon := (coordWdeg_le_iff _ _).mp (coordWdeg_transformCoord_monomial_le R m (f.coeff m)) m' hm'
  omega

/-! ============================================================================
    PART 2: GENERAL `LieBasisData` → `AmbientLie` (BIANCHI & RICCI IDENTITIES)
    ============================================================================ -/

/-- Orthonormal Lie algebra & Lie group data of dimension `d > 0` for `G`,
    used to construct `CurvaturePolynomialAlgebra G` unconditionally. -/
structure LieBasisData (G : Type*) [TopologicalSpace G] [Group G] (d : ℕ) where
  hd : 0 < d
  Lie : Type
  [lieRing : LieRing Lie]
  [lieAlgebra : LieAlgebra ℝ Lie]
  [finDim : FiniteDimensional ℝ Lie]
  [topSpace : TopologicalSpace Lie]
  [t2Space : T2Space Lie]
  [topAddGroup : IsTopologicalAddGroup Lie]
  [contSMul : ContinuousSMul ℝ Lie]
  B : Fin d → Lie
  adjoint_action : G → Lie →ₗ[ℝ] Lie
  adjoint_action_one : adjoint_action 1 = LinearMap.id
  adjoint_action_mul : ∀ (g h : G) (X : Lie),
    adjoint_action (g * h) X = adjoint_action g (adjoint_action h X)
  adjoint_action_bracket : ∀ (g : G) (X Y : Lie),
    adjoint_action g ⁅X, Y⁆ = ⁅adjoint_action g X, adjoint_action g Y⁆
  lie_inner : Lie →ₗ[ℝ] Lie →ₗ[ℝ] ℝ
  lie_inner_symm : ∀ X Y : Lie, lie_inner X Y = lie_inner Y X
  lie_inner_pos : ∀ X : Lie, X ≠ 0 → 0 < lie_inner X X
  lie_inner_ad_inv : ∀ (g : G) (X Y : Lie),
    lie_inner (adjoint_action g X) (adjoint_action g Y) = lie_inner X Y
  orthonormal : ∀ i j : Fin d, lie_inner (B i) (B j) = if i = j then 1 else 0
  expand : ∀ X : Lie, X = ∑ i : Fin d, lie_inner X (B i) • B i
  su2_triple : ∃ (X Y Z : Lie),
    ⁅X, Y⁆ = Z ∧ ⁅Y, Z⁆ = X ∧ ⁅Z, X⁆ = Y ∧ lie_inner X X = 1 ∧
    ∀ X' Y' Z' : Lie, X' ≠ 0 → ⁅X', Y'⁆ = Z' → ⁅Y', Z'⁆ = X' → ⁅Z', X'⁆ = Y' →
      1 ≤ lie_inner X' X'
  casimir_adjoint : ℕ
  casimir_adjoint_pos : 2 ≤ casimir_adjoint
  killing_casimir_identity : ∀ X Y : Lie,
    let adX := LieAlgebra.ad ℝ Lie X
    let adY := LieAlgebra.ad ℝ Lie Y
    LinearMap.trace ℝ Lie (adX.comp adY) = - (casimir_adjoint : ℝ) * lie_inner X Y
  exp : Lie → G
  exp_zero : exp 0 = 1
  exp_add_of_commute : ∀ X Y : Lie, ⁅X, Y⁆ = 0 → exp (X + Y) = exp X * exp Y
  exp_continuous : Continuous exp
  exp_local_homeomorph :
    ∃ (U : Set Lie) (V : Set G),
      IsOpen U ∧ (0 : Lie) ∈ U ∧ IsOpen V ∧ (1 : G) ∈ V ∧
      Set.BijOn exp U V ∧ ContinuousOn exp U ∧
      ∀ ⦃x⦄, x ∈ U → ∀ ⦃O : Set Lie⦄, IsOpen O → x ∈ O →
        exp '' (U ∩ O) ∈ nhds (exp x)
  exp_one_param_bijection :
    ∀ γ : Multiplicative ℝ →* G, Continuous γ →
      ∃! X : Lie, ∀ t : ℝ, γ (Multiplicative.ofAdd t) = exp (t • X)
  exp_adjoint_conj : ∀ (g : G) (X : Lie),
    exp (adjoint_action g X) = g * exp X * g⁻¹
  hasDerivAt_adjoint_exp : ∀ X Y : Lie,
    HasDerivAt (fun t : ℝ => adjoint_action (exp (t • X)) Y) ⁅X, Y⁆ 0
  hasDerivAt_coord : ∀ A X Y : Lie,
    HasDerivAt (fun t : ℝ => lie_inner (adjoint_action (exp (t • A)) X) Y) (lie_inner ⁅A, X⁆ Y) 0
  lie_inner_ad_skew : ∀ Y X Z : Lie,
    lie_inner ⁅Y, X⁆ Z + lie_inner X ⁅Y, Z⁆ = 0

attribute [instance] LieBasisData.lieRing LieBasisData.lieAlgebra LieBasisData.finDim
  LieBasisData.topSpace LieBasisData.t2Space LieBasisData.topAddGroup LieBasisData.contSMul

section BuildCurvature

variable {G : Type*} [TopologicalSpace G] [Group G] {d : ℕ} (L : LieBasisData G d)

/-- Real structure constant `f_{a b c} = ⟨B_a, [B_b, B_c]⟩`. -/
def structConst (a b c : Fin d) : ℝ := L.lie_inner (L.B a) ⁅L.B b, L.B c⁆

/-- Infinitesimal ad-invariance of `lie_inner`: `⟨[Y, X], Z⟩ + ⟨X, [Y, Z]⟩ = 0`. -/
theorem lie_inner_ad_skew (Y X Z : L.Lie) :
    L.lie_inner ⁅Y, X⁆ Z + L.lie_inner X ⁅Y, Z⁆ = 0 :=
  L.lie_inner_ad_skew Y X Z

theorem structConst_skew_bc (a b c : Fin d) :
    structConst L a b c = - structConst L a c b := by
  simp only [structConst, ← lie_skew (L.B b) (L.B c), map_neg]

theorem structConst_skew_ac (a b c : Fin d) :
    structConst L a b c = - structConst L c b a := by
  have h := lie_inner_ad_skew L (L.B b) (L.B a) (L.B c)
  rw [L.lie_inner_symm ⁅L.B b, L.B a⁆ (L.B c)] at h
  dsimp [structConst]
  linarith

/-- Jacobi identity in structure constants:
    `∑ e, (f_{a b e} f_{e c k} + f_{a c e} f_{e k b} + f_{a k e} f_{e b c}) = 0`. -/
theorem structConst_jacobi (a b c k : Fin d) :
    ∑ e : Fin d, (structConst L a b e * structConst L e c k +
      structConst L a c e * structConst L e k b +
      structConst L a k e * structConst L e b c) = 0 := by
  have h_jac : ⁅L.B b, ⁅L.B c, L.B k⁆⁆ + ⁅L.B c, ⁅L.B k, L.B b⁆⁆ +
      ⁅L.B k, ⁅L.B b, L.B c⁆⁆ = 0 :=
    lie_jacobi (L.B b) (L.B c) (L.B k)
  have h_inner := congrArg (L.lie_inner (L.B a)) h_jac
  rw [map_zero, map_add, map_add] at h_inner
  have h_term : ∀ u v w : Fin d,
      L.lie_inner (L.B a) ⁅L.B u, ⁅L.B v, L.B w⁆⁆ =
        ∑ e : Fin d, structConst L a u e * structConst L e v w := by
    intro u v w
    conv_lhs => rw [L.expand ⁅L.B v, L.B w⁆]
    simp only [lie_sum, lie_smul, map_sum, LinearMap.map_smul, smul_eq_mul, structConst]
    refine Finset.sum_congr rfl fun e _ => ?_
    rw [L.lie_inner_symm ⁅L.B v, L.B w⁆ (L.B e), mul_comm]
  rw [h_term b c k, h_term c k b, h_term k b c] at h_inner
  simpa [Finset.sum_add_distrib] using h_inner

/-- Gauge potential component `A_μ^a = X (0, μ, a) ∈ CoordPoly d`. -/
def AComp (μ : Fin 4) (a : Fin d) : CoordPoly d :=
  MvPolynomial.X (0, μ, a)

/-- Ambient Lie-algebra-valued differential polynomials `Fin d → CoordPoly d`. -/
abbrev AmbientLie (d : ℕ) : Type := Fin d → CoordPoly d

/-- Field strength components `F_{μν}^a` in `CoordPoly d`:
    `F_{μν}^a = ∂_μ A_ν^a - ∂_ν A_μ^a + ∑_{b,c} f_{a b c} A_μ^b A_ν^c`. -/
def FVec (μ ν : Fin 4) : AmbientLie d := fun a =>
  coordDeriv μ (AComp ν a) - coordDeriv ν (AComp μ a) +
    ∑ b : Fin d, ∑ c : Fin d, ((structConst L a b c : ℝ) : ℂ) • (AComp μ b * AComp ν c)

/-- Covariant derivative `(D_μ Φ)^a = ∂_μ Φ^a + ∑_{b,c} f_{a b c} A_μ^b Φ^c`. -/
def covDerivAmb (μ : Fin 4) : AmbientLie d →ₗ[ℂ] AmbientLie d where
  toFun Φ a := coordDeriv μ (Φ a) +
    ∑ b : Fin d, ∑ c : Fin d, ((structConst L a b c : ℝ) : ℂ) • (AComp μ b * Φ c)
  map_add' Φ Ψ := by
    ext a
    simp only [Pi.add_apply, map_add, mul_add, smul_add, Finset.sum_add_distrib]
    ring
  map_smul' c Φ := by
    ext a
    simp only [Pi.smul_apply, RingHom.id_apply, Derivation.map_smul, mul_smul_comm,
      smul_comm _ c, Finset.smul_sum, smul_add]

/-- Lie bracket on `AmbientLie d`: `[Φ, Ψ]^a = ∑_{b,c} f_{a b c} Φ^b Ψ^c`. -/
def bracketAmb (Φ Ψ : AmbientLie d) : AmbientLie d := fun a =>
  ∑ b : Fin d, ∑ c : Fin d, ((structConst L a b c : ℝ) : ℂ) • (Φ b * Ψ c)

theorem FVec_antisymm (μ ν : Fin 4) : FVec L μ ν = - FVec L ν μ := by
  ext a
  simp only [FVec, Pi.neg_apply]
  have h_sum : ∑ b : Fin d, ∑ c : Fin d,
      ((structConst L a b c : ℝ) : ℂ) • (AComp μ b * AComp ν c) =
      - ∑ b : Fin d, ∑ c : Fin d,
        ((structConst L a b c : ℝ) : ℂ) • (AComp ν b * AComp μ c) := by
    rw [Finset.sum_comm, ← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun b _ => ?_
    rw [← Finset.sum_neg_distrib]
    refine Finset.sum_congr rfl fun c _ => ?_
    rw [structConst_skew_bc L a c b, Complex.ofReal_neg, neg_smul, mul_comm (AComp μ c)]
  rw [h_sum]
  ring

theorem bianchi_amb (l μ ν : Fin 4) :
    covDerivAmb L l (FVec L μ ν) + covDerivAmb L μ (FVec L ν l) +
      covDerivAmb L ν (FVec L l μ) = 0 := by
  funext a
  simp only [Pi.add_apply, Pi.zero_apply, covDerivAmb, LinearMap.coe_mk, AddHom.coe_mk, FVec,
    map_add, map_sub, map_sum, Derivation.map_smul, coordDeriv_leibniz, mul_add, smul_add,
    Finset.sum_add_distrib]
  -- Group into: (1) ∂∂A terms, (2) A·∂A terms, (3) A·A·A cubic terms
  have h1 :
      (coordDeriv l (coordDeriv μ (AComp ν a)) - coordDeriv l (coordDeriv ν (AComp μ a))) +
      (coordDeriv μ (coordDeriv ν (AComp l a)) - coordDeriv μ (coordDeriv l (AComp ν a))) +
      (coordDeriv ν (coordDeriv l (AComp μ a)) - coordDeriv ν (coordDeriv μ (AComp l a))) = 0 := by
    rw [coordDeriv_comm l μ, coordDeriv_comm μ ν, coordDeriv_comm ν l]
    ring
  have h2 :
      (∑ b : Fin d, ∑ c : Fin d, ((structConst L a b c : ℝ) : ℂ) •
          (coordDeriv l (AComp μ b) * AComp ν c + AComp μ b * coordDeriv l (AComp ν c))) +
      (∑ b : Fin d, ∑ c : Fin d, ((structConst L a b c : ℝ) : ℂ) •
          (AComp l b * (coordDeriv μ (AComp ν c) - coordDeriv ν (AComp μ c)))) +
      ((∑ b : Fin d, ∑ c : Fin d, ((structConst L a b c : ℝ) : ℂ) •
          (coordDeriv μ (AComp ν b) * AComp l c + AComp ν b * coordDeriv μ (AComp l c))) +
      (∑ b : Fin d, ∑ c : Fin d, ((structConst L a b c : ℝ) : ℂ) •
          (AComp μ b * (coordDeriv ν (AComp l c) - coordDeriv l (AComp ν c))))) +
      ((∑ b : Fin d, ∑ c : Fin d, ((structConst L a b c : ℝ) : ℂ) •
          (coordDeriv ν (AComp l b) * AComp μ c + AComp l b * coordDeriv ν (AComp μ c))) +
      (∑ b : Fin d, ∑ c : Fin d, ((structConst L a b c : ℝ) : ℂ) •
          (AComp ν b * (coordDeriv l (AComp μ c) - coordDeriv μ (AComp l c))))) = 0 := by
    have h_swap : ∀ (P : Fin d → Fin d → CoordPoly d),
        (∑ b : Fin d, ∑ c : Fin d, ((structConst L a b c : ℝ) : ℂ) • P b c) =
        ∑ b : Fin d, ∑ c : Fin d, - (((structConst L a b c : ℝ) : ℂ) • P c b) := by
      intro P
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun b _ => Finset.sum_congr rfl fun c _ => ?_
      rw [structConst_skew_bc L a c b, Complex.ofReal_neg, neg_smul]
    -- Rewrite the 1st half of each pair (with ∂A_1 * A_2) by swapping b ↔ c on the first summand:
    have h_pair : ∀ (x y z : Fin 4),
        (∑ b : Fin d, ∑ c : Fin d, ((structConst L a b c : ℝ) : ℂ) •
          (coordDeriv x (AComp y b) * AComp z c + AComp y b * coordDeriv x (AComp z c))) =
        (∑ b : Fin d, ∑ c : Fin d, ((structConst L a b c : ℝ) : ℂ) •
          (- (AComp z b * coordDeriv x (AComp y c)) + AComp y b * coordDeriv x (AComp z c))) := by
      intro x y z
      simp only [smul_add, Finset.sum_add_distrib]
      congr 1
      rw [h_swap (fun b c => coordDeriv x (AComp y b) * AComp z c)]
      refine Finset.sum_congr rfl fun b _ => Finset.sum_congr rfl fun c _ => ?_
      rw [smul_neg, mul_comm]
    rw [h_pair l μ ν, h_pair μ ν l, h_pair ν l μ]
    simp only [mul_sub, smul_add, smul_sub, smul_neg, ← Finset.sum_add_distrib]
    refine Finset.sum_eq_zero fun b _ => Finset.sum_eq_zero fun c _ => ?_
    simp only [sub_eq_add_neg]
    abel
  have h3 :
      (∑ b : Fin d, ∑ e : Fin d, ((structConst L a b e : ℝ) : ℂ) •
        (AComp l b * ∑ c : Fin d, ∑ k : Fin d, ((structConst L e c k : ℝ) : ℂ) • (AComp μ c * AComp ν k))) +
      (∑ c : Fin d, ∑ e : Fin d, ((structConst L a c e : ℝ) : ℂ) •
        (AComp μ c * ∑ k : Fin d, ∑ b : Fin d, ((structConst L e k b : ℝ) : ℂ) • (AComp ν k * AComp l b))) +
      (∑ k : Fin d, ∑ e : Fin d, ((structConst L a k e : ℝ) : ℂ) •
        (AComp ν k * ∑ b : Fin d, ∑ c : Fin d, ((structConst L e b c : ℝ) : ℂ) • (AComp l b * AComp μ c))) = 0 := by
    have h_rearrange :
        ∀ (T : Fin d → Fin d → Fin d → Fin d → CoordPoly d),
        (∑ x : Fin d, ∑ e : Fin d, ((structConst L a x e : ℝ) : ℂ) •
          (∑ y : Fin d, ∑ z : Fin d, T x e y z)) =
        ∑ x : Fin d, ∑ y : Fin d, ∑ z : Fin d, ∑ e : Fin d,
          ((structConst L a x e : ℝ) : ℂ) • T x e y z := by
      intro T
      refine Finset.sum_congr rfl fun x _ => ?_
      simp only [Finset.smul_sum]
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun y _ => Finset.sum_comm
    -- Expand each of the three sums into ∑ b, ∑ c, ∑ k, ∑ e
    simp only [Finset.mul_sum, Finset.smul_sum]
    have s1 : (∑ b : Fin d, ∑ e : Fin d, ∑ c : Fin d, ∑ k : Fin d,
