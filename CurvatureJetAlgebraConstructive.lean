    PART 4: `PolySub`, `Poly`, `tr_F_sq`, `stress_energy`, `uv_two_point_coeff`,
            AND `buildCurvaturePolynomialAlgebra`
    ============================================================================ -/

/-- Orthonormal basis of `L.Lie` constructed from `L.B` and `L.orthonormal`, `L.expand`. -/
noncomputable def lieOrthonormalBasis : Module.Basis (Fin d) ℝ L.Lie :=
  Module.Basis.mk
    (v := L.B)
    (by
      rw [Fintype.linearIndependent_iff]
      intro g hg i
      have h0 := congrArg (fun X => L.lie_inner X (L.B i)) hg
      simp only [map_zero, map_sum, map_smul, LinearMap.sum_apply, LinearMap.smul_apply,
        smul_eq_mul, L.orthonormal] at h0
      simpa using h0)
    (by
      intro X _
      rw [L.expand X]
      exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩))

theorem lie_finrank_eq : Module.finrank ℝ L.Lie = d := by
  rw [Module.finrank_eq_card_basis (lieOrthonormalBasis L), Fintype.card_fin]

/-- Helper: coefficient of `Finsupp.single v 2` in `f * f` when `f.coeff 0 = 0`. -/
theorem coeff_mul_single_two {f : CoordPoly d} (hf0 : f.coeff 0 = 0) (v : JetVar d) :
    (f * f).coeff (Finsupp.single v 2) = (f.coeff (Finsupp.single v 1)) ^ 2 := by
  rw [MvPolynomial.coeff_mul]
  trans (∑ p ∈ Finset.HasAntidiagonal.antidiagonal (Finsupp.single v 2),
      if p = (Finsupp.single v 1, Finsupp.single v 1) then (f.coeff (Finsupp.single v 1)) ^ 2 else 0)
  · refine Finset.sum_congr rfl fun p hp => ?_
    have hp_eq : p.1 + p.2 = Finsupp.single v 2 :=
      Finset.HasAntidiagonal.mem_antidiagonal.mp hp
    split_ifs with heq
    · rw [heq]; ring
    · by_cases h0a : p.1 = 0
      · rw [h0a, hf0, zero_mul]
      · by_cases h0b : p.2 = 0
        · rw [h0b, hf0, mul_zero]
        · exfalso; apply heq
          have hp1_le : ∀ w, p.1 w + p.2 w = if v = w then 2 else 0 := fun w => by
            simpa [Finsupp.add_apply, Finsupp.single_apply] using congrArg (fun g : JetVar d →₀ ℕ => g w) hp_eq
          have hv1 : p.1 v ≥ 1 := by
            by_contra hlt
            have hv0 : p.1 v = 0 := by omega
            apply h0a; ext w
            by_cases hw : v = w
            · subst w; exact hv0
            · have := hp1_le w; rw [if_neg hw] at this
              simp only [Finsupp.coe_zero, Pi.zero_apply] at *
              omega
          have hv2 : p.2 v ≥ 1 := by
            by_contra hlt
            have hv0 : p.2 v = 0 := by omega
            apply h0b; ext w
            by_cases hw : v = w
            · subst w; exact hv0
            · have := hp1_le w; rw [if_neg hw] at this
              simp only [Finsupp.coe_zero, Pi.zero_apply] at *
              omega
          have hv_eq : p.1 v + p.2 v = 2 := by simpa using hp1_le v
          ext w
          · by_cases hw : v = w
            · subst w; simp [Finsupp.single_apply]; omega
            · have := hp1_le w; rw [if_neg hw] at this; simp [Finsupp.single_apply, hw]; omega
          · by_cases hw : v = w
            · subst w; simp [Finsupp.single_apply]; omega
            · have := hp1_le w; rw [if_neg hw] at this; simp [Finsupp.single_apply, hw]; omega
  · have hmem : (Finsupp.single v 1, Finsupp.single v 1) ∈
        Finset.HasAntidiagonal.antidiagonal (Finsupp.single v 2) := by
      rw [Finset.HasAntidiagonal.mem_antidiagonal]
      ext w; simp [Finsupp.add_apply, Finsupp.single_apply]; split_ifs <;> omega
    rw [Finset.sum_ite_eq', if_pos hmem]

/-- Helper: coefficient of `Finsupp.single v₁ 1 + Finsupp.single v₂ 1` in `f * g`
    when `f.coeff 0 = 0`, `g.coeff 0 = 0`, and `v₁ ≠ v₂`. -/
theorem coeff_mul_single_add_single {f g : CoordPoly d}
    (hf0 : f.coeff 0 = 0) (hg0 : g.coeff 0 = 0) {v₁ v₂ : JetVar d} (hne : v₁ ≠ v₂) :
    (f * g).coeff (Finsupp.single v₁ 1 + Finsupp.single v₂ 1) =
      f.coeff (Finsupp.single v₁ 1) * g.coeff (Finsupp.single v₂ 1) +
      f.coeff (Finsupp.single v₂ 1) * g.coeff (Finsupp.single v₁ 1) := by
  rw [MvPolynomial.coeff_mul]
  let p12 := (Finsupp.single v₁ 1, Finsupp.single v₂ 1)
  let p21 := (Finsupp.single v₂ 1, Finsupp.single v₁ 1)
  have hp_ne : p12 ≠ p21 := by
    intro h
    have := congrArg (fun p : (JetVar d →₀ ℕ) × (JetVar d →₀ ℕ) => p.1 v₁) h
    simp [p12, p21, Finsupp.single_apply, hne] at this
  have h_sum : ∀ p ∈ Finset.HasAntidiagonal.antidiagonal (Finsupp.single v₁ 1 + Finsupp.single v₂ 1),
      f.coeff p.1 * g.coeff p.2 =
        (if p = p12 then f.coeff (Finsupp.single v₁ 1) * g.coeff (Finsupp.single v₂ 1) else 0) +
        (if p = p21 then f.coeff (Finsupp.single v₂ 1) * g.coeff (Finsupp.single v₁ 1) else 0) := by
    intro p hp
    have hp_eq : p.1 + p.2 = Finsupp.single v₁ 1 + Finsupp.single v₂ 1 :=
      Finset.HasAntidiagonal.mem_antidiagonal.mp hp
    by_cases h12 : p = p12
    · rw [if_pos h12, if_neg (h12 ▸ hp_ne), add_zero, h12]
    · rw [if_neg h12, zero_add]
      by_cases h21 : p = p21
      · rw [if_pos h21, h21]
      · rw [if_neg h21]
        by_cases h0a : p.1 = 0
        · rw [h0a, hf0, zero_mul]
        · by_cases h0b : p.2 = 0
          · rw [h0b, hg0, mul_zero]
          · exfalso
            have hp_at : ∀ w, p.1 w + p.2 w = (if v₁ = w then 1 else 0) + (if v₂ = w then 1 else 0) :=
              fun w => by
                simpa [Finsupp.add_apply, Finsupp.single_apply] using
                  congrArg (fun h : JetVar d →₀ ℕ => h w) hp_eq
            have hv1 : p.1 v₁ + p.2 v₁ = 1 := by simpa [hne, hne.symm] using hp_at v₁
            have hv2 : p.1 v₂ + p.2 v₂ = 1 := by simpa [hne, hne.symm] using hp_at v₂
            have h_other : ∀ w, w ≠ v₁ → w ≠ v₂ → p.1 w = 0 ∧ p.2 w = 0 := by
              intro w hw1 hw2
              have := hp_at w
              rw [if_neg (Ne.symm hw1), if_neg (Ne.symm hw2)] at this
              omega
            rcases (by omega : p.1 v₁ = 1 ∨ p.1 v₁ = 0) with ha1 | ha0
            · have hb1 : p.2 v₁ = 0 := by omega
              have ha2 : p.1 v₂ = 0 := by
                by_contra hne2
                have ha2' : p.1 v₂ = 1 := by omega
                have hb2 : p.2 v₂ = 0 := by omega
                apply h0b; ext w
                by_cases hw1 : w = v₁
                · subst w; exact hb1
                · by_cases hw2 : w = v₂
                  · subst w; exact hb2
                  · exact (h_other w hw1 hw2).2
              have hb2 : p.2 v₂ = 1 := by omega
              apply h12; ext w
              · by_cases hw1 : w = v₁
                · subst w; simp [p12, Finsupp.single_apply, ha1]
                · by_cases hw2 : w = v₂
                  · subst w; simp [p12, Finsupp.single_apply, ha2, hne]
                  · simp [p12, Finsupp.single_apply, Ne.symm hw1, (h_other w hw1 hw2).1]
              · by_cases hw1 : w = v₁
                · subst w; simp [p12, Finsupp.single_apply, hb1, hne.symm]
                · by_cases hw2 : w = v₂
                  · subst w; simp [p12, Finsupp.single_apply, hb2]
                  · simp [p12, Finsupp.single_apply, Ne.symm hw2, (h_other w hw1 hw2).2]
            · have hb1 : p.2 v₁ = 1 := by omega
              have ha2 : p.1 v₂ = 1 := by
                by_contra hne2
                have ha2' : p.1 v₂ = 0 := by omega
                apply h0a; ext w
                by_cases hw1 : w = v₁
                · subst w; exact ha0
                · by_cases hw2 : w = v₂
                  · subst w; exact ha2'
                  · exact (h_other w hw1 hw2).1
              have hb2 : p.2 v₂ = 0 := by omega
              apply h21; ext w
              · by_cases hw1 : w = v₁
                · subst w; simp [p21, Finsupp.single_apply, ha0, hne]
                · by_cases hw2 : w = v₂
                  · subst w; simp [p21, Finsupp.single_apply, ha2]
                  · simp [p21, Finsupp.single_apply, Ne.symm hw2, (h_other w hw1 hw2).1]
              · by_cases hw1 : w = v₁
                · subst w; simp [p21, Finsupp.single_apply, hb1]
                · by_cases hw2 : w = v₂
                  · subst w; simp [p21, Finsupp.single_apply, hb2, hne.symm]
                  · simp [p21, Finsupp.single_apply, Ne.symm hw1, (h_other w hw1 hw2).2]
  rw [Finset.sum_congr rfl h_sum, Finset.sum_add_distrib]
  have hp12_mem : p12 ∈ Finset.HasAntidiagonal.antidiagonal (Finsupp.single v₁ 1 + Finsupp.single v₂ 1) := by
    rw [Finset.HasAntidiagonal.mem_antidiagonal]
  have hp21_mem : p21 ∈ Finset.HasAntidiagonal.antidiagonal (Finsupp.single v₁ 1 + Finsupp.single v₂ 1) := by
    rw [Finset.HasAntidiagonal.mem_antidiagonal, add_comm]
  rw [Finset.sum_ite_eq', Finset.sum_ite_eq', if_pos hp12_mem, if_pos hp21_mem]

/-- Ambient trace pairing `∑ a, Φ a * Ψ a`. -/
def tracePairAmb (Φ Ψ : AmbientLie d) : CoordPoly d :=
  ∑ a : Fin d, Φ a * Ψ a

/-- Ambient invariant contraction. -/
noncomputable def invContractAmb (m : ℕ) (T : MultilinearMap ℝ (fun _ : Fin m => L.Lie) ℝ)
    (Φ : Fin m → AmbientLie d) : CoordPoly d :=
  ∑ idx : Fin m → Fin d, ((T (fun k => L.B (idx k)) : ℝ) : ℂ) • ∏ k : Fin m, Φ k (idx k)

/-- Inductive predicate characterizing `CoordPoly d` elements in `Poly`. -/
inductive InPoly : CoordPoly d → Prop
  | of_complex (c : ℂ) : InPoly (algebraMap ℂ (CoordPoly d) c)
  | trace_pair {Φ Ψ : AmbientLie d} : InLiePoly L Φ → InLiePoly L Ψ → InPoly (tracePairAmb Φ Ψ)
  | inv_contract (m : ℕ) (T : MultilinearMap ℝ (fun _ : Fin m => L.Lie) ℝ)
      (hT : ∀ (g : G) (v : Fin m → L.Lie), T (fun k => L.adjoint_action g (v k)) = T v)
      {Φ : Fin m → AmbientLie d} : (∀ k, InLiePoly L (Φ k)) → InPoly (invContractAmb L m T Φ)
  | add {P Q : CoordPoly d} : InPoly P → InPoly Q → InPoly (P + Q)
  | mul {P Q : CoordPoly d} : InPoly P → InPoly Q → InPoly (P * Q)

/-- `PolySub L` is the `ℂ`-subalgebra of `CoordPoly d` generated by `trace_pair` and `inv_contract`. -/
def PolySub : Subalgebra ℂ (CoordPoly d) where
  carrier := { P | InPoly L P }
  mul_mem' hP hQ := InPoly.mul hP hQ
  one_mem' := by simpa using InPoly.of_complex (L := L) 1
  add_mem' hP hQ := InPoly.add hP hQ
  zero_mem' := by simpa using InPoly.of_complex (L := L) 0
  algebraMap_mem' c := InPoly.of_complex c

abbrev PolyVal (d : ℕ) (L : LieBasisData G d) : Type := ↥(PolySub L)

theorem coordConj_inPoly {P : CoordPoly d} (hP : InPoly L P) : InPoly L (coordConj P) := by
  induction hP with
  | of_complex c =>
    rw [MvPolynomial.algebraMap_eq, coordConj_C]
    exact InPoly.of_complex (starRingEnd ℂ c)
  | @trace_pair Φ Ψ hΦ hΨ =>
    have h_eq : coordConj (tracePairAmb Φ Ψ) = tracePairAmb (conjAmb Φ) (conjAmb Ψ) := by
      simp [tracePairAmb, conjAmb, map_sum, map_mul]
    rw [h_eq]
    exact InPoly.trace_pair (conjAmb_inLiePoly L hΦ) (conjAmb_inLiePoly L hΨ)
  | @inv_contract m T hT Φ hΦ =>
    have h_eq : coordConj (invContractAmb L m T Φ) =
        invContractAmb L m T (fun k => conjAmb (Φ k)) := by
      simp [invContractAmb, conjAmb, map_sum, coordConj_real_smul, map_prod]
    rw [h_eq]
    exact InPoly.inv_contract m T hT (fun k => conjAmb_inLiePoly L (hΦ k))
  | add _ _ ih1 ih2 => rw [map_add]; exact InPoly.add ih1 ih2
  | mul _ _ ih1 ih2 => rw [map_mul]; exact InPoly.mul ih1 ih2

theorem transformCoord_inPoly (R : Matrix (Fin 4) (Fin 4) ℝ) {P : CoordPoly d}
    (hP : InPoly L P) : InPoly L (transformCoord R P) := by
  induction hP with
  | of_complex c =>
    rw [AlgHom.commutes]
    exact InPoly.of_complex c
  | @trace_pair Φ Ψ hΦ hΨ =>
    have h_eq : transformCoord R (tracePairAmb Φ Ψ) =
        tracePairAmb (transformAmb R Φ) (transformAmb R Ψ) := by
      simp [tracePairAmb, transformAmb, map_sum, map_mul]
    rw [h_eq]
    exact InPoly.trace_pair (transformAmb_inLiePoly L R hΦ) (transformAmb_inLiePoly L R hΨ)
  | @inv_contract m T hT Φ hΦ =>
    have h_eq : transformCoord R (invContractAmb L m T Φ) =
        invContractAmb L m T (fun k => transformAmb R (Φ k)) := by
      simp [invContractAmb, transformAmb, map_sum, AlgHom.map_smul_of_tower, map_prod]
    rw [h_eq]
    exact InPoly.inv_contract m T hT (fun k => transformAmb_inLiePoly L R (hΦ k))
  | add _ _ ih1 ih2 => rw [map_add]; exact InPoly.add ih1 ih2
  | mul _ _ ih1 ih2 => rw [map_mul]; exact InPoly.mul ih1 ih2

/-- `L^2` coefficient norm squared of a `CoordPoly d`, used for `uv_two_point_coeff`. -/
noncomputable def polyNormSq (P : CoordPoly d) : ℝ :=
  ∑ m ∈ P.support, Complex.normSq (P.coeff m)

theorem polyNormSq_pos {P : CoordPoly d} (hP : P ≠ 0) : 0 < polyNormSq P := by
  dsimp [polyNormSq]
  have hne : P.support.Nonempty := MvPolynomial.support_nonempty.mpr hP
  refine Finset.sum_pos (fun m hm => ?_) hne
  exact Complex.normSq_pos.mpr (MvPolynomial.mem_support_iff.mp hm)

/-- Infinitesimal ad-invariance of any `G`-invariant multilinear map `T` on `L.Lie`. -/
theorem multilinear_ad_invariant
    (m : ℕ) (T : MultilinearMap ℝ (fun _ : Fin m => L.Lie) ℝ)
    (hT : ∀ (g : G) (v : Fin m → L.Lie), T (fun k => L.adjoint_action g (v k)) = T v)
    (X : L.Lie) (v : Fin m → L.Lie) :
    ∑ k : Fin m, T (Function.update v k ⁅X, v k⁆) = 0 := by
  have h_expand_T : ∀ w : Fin m → L.Lie,
      T w = ∑ idx : Fin m → Fin d, T (fun k => L.B (idx k)) *
        ∏ k : Fin m, L.lie_inner (w k) (L.B (idx k)) := by
    intro w
    have hw : w = fun k => ∑ i : Fin d, L.lie_inner (w k) (L.B i) • L.B i :=
      funext fun k => L.expand (w k)
    conv_lhs => rw [hw]
    rw [T.map_sum_finset]
    refine Finset.sum_congr rfl fun idx _ => ?_
    rw [T.map_smul_univ]
    ring
  have h_const : (fun t : ℝ => T (fun k => L.adjoint_action (L.exp (t • X)) (v k))) =
      fun _ => T v := funext fun t => hT (L.exp (t • X)) v
  have h_factor_deriv : ∀ (Y Z : L.Lie),
      HasDerivAt (fun t : ℝ => L.lie_inner (L.adjoint_action (L.exp (t • X)) Y) Z)
        (L.lie_inner ⁅X, Y⁆ Z) 0 :=
    fun Y Z => L.hasDerivAt_coord X Y Z
  have h_prod_deriv : ∀ idx : Fin m → Fin d,
      HasDerivAt
        (fun t : ℝ => ∏ k : Fin m, L.lie_inner (L.adjoint_action (L.exp (t • X)) (v k)) (L.B (idx k)))
        (∑ k : Fin m, (∏ j ∈ Finset.univ.erase k, L.lie_inner (v j) (L.B (idx j))) *
          L.lie_inner ⁅X, v k⁆ (L.B (idx k))) 0 := by
    intro idx
    have h0 := HasDerivAt.finsetProd (u := Finset.univ)
      (f := fun k t => L.lie_inner (L.adjoint_action (L.exp (t • X)) (v k)) (L.B (idx k)))
      (f' := fun k => L.lie_inner ⁅X, v k⁆ (L.B (idx k)))
      (fun k _ => h_factor_deriv (v k) (L.B (idx k)))
    have h_fn : (∏ k : Fin m, fun t : ℝ =>
        L.lie_inner (L.adjoint_action (L.exp (t • X)) (v k)) (L.B (idx k))) =
        fun t : ℝ => ∏ k : Fin m,
          L.lie_inner (L.adjoint_action (L.exp (t • X)) (v k)) (L.B (idx k)) :=
      funext fun t => Finset.prod_apply t Finset.univ _
    rw [h_fn] at h0
    refine h0.congr_deriv ?_
    have h_val : ∀ j : Fin m,
        L.lie_inner (L.adjoint_action (L.exp ((0 : ℝ) • X)) (v j)) (L.B (idx j)) =
        L.lie_inner (v j) (L.B (idx j)) :=
      fun j => by rw [zero_smul, L.exp_zero, L.adjoint_action_one, LinearMap.id_apply]
    refine Finset.sum_congr rfl fun k _ => ?_
    congr 1
    refine Finset.prod_congr rfl fun j _ => h_val j
  have h_total_deriv :
      HasDerivAt (fun t : ℝ => T (fun k => L.adjoint_action (L.exp (t • X)) (v k)))
        (∑ idx : Fin m → Fin d, T (fun k => L.B (idx k)) *
          ∑ k : Fin m, (∏ j ∈ Finset.univ.erase k, L.lie_inner (v j) (L.B (idx j))) *
            L.lie_inner ⁅X, v k⁆ (L.B (idx k))) 0 := by
    have h_eq : (fun t : ℝ => T (fun k => L.adjoint_action (L.exp (t • X)) (v k))) =
        fun t => ∑ idx : Fin m → Fin d, T (fun k => L.B (idx k)) *
          ∏ k : Fin m, L.lie_inner (L.adjoint_action (L.exp (t • X)) (v k)) (L.B (idx k)) :=
      funext fun t => h_expand_T _
    rw [h_eq]
    exact HasDerivAt.fun_sum fun idx _ => (h_prod_deriv idx).const_mul _
  rw [h_const] at h_total_deriv
  have h_zero := (hasDerivAt_const 0 (T v)).unique h_total_deriv
  trans (∑ idx : Fin m → Fin d, T (fun k => L.B (idx k)) *
      ∑ k : Fin m, (∏ j ∈ Finset.univ.erase k, L.lie_inner (v j) (L.B (idx j))) *
        L.lie_inner ⁅X, v k⁆ (L.B (idx k)))
  · simp_rw [Finset.mul_sum]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun k _ => ?_
    rw [h_expand_T (Function.update v k ⁅X, v k⁆)]
    refine Finset.sum_congr rfl fun idx _ => ?_
    congr 1
    rw [← Finset.mul_prod_erase (s := Finset.univ) (f := fun j => L.lie_inner (Function.update v k ⁅X, v k⁆ j) (L.B (idx j))) (Finset.mem_univ k)]
    simp only [Function.update_self]
    rw [mul_comm]
    congr 1
    refine Finset.prod_congr rfl fun j hj => ?_
    rw [Function.update_of_ne (Finset.ne_of_mem_erase hj)]
  · exact h_zero.symm

/-- Ambient `tr_F_sq` element in `CoordPoly d`. -/
def trFSqAmb : CoordPoly d :=
  ∑ μ : Fin 4, ∑ ν : Fin 4,
    ((minkowskiMetric μ μ * minkowskiMetric ν ν : ℝ) : ℂ) • tracePairAmb (FVec L μ ν) (FVec L μ ν)

theorem trFSqAmb_inPoly : InPoly L (trFSqAmb L) :=
  Subalgebra.sum_mem (PolySub L) fun μ _ =>
    Subalgebra.sum_mem (PolySub L) fun ν _ =>
      Subalgebra.smul_mem (PolySub L)
        (InPoly.trace_pair (InLiePoly.F μ ν) (InLiePoly.F μ ν)) _

theorem trFSqAmb_coeff_single_two (μ₀ ν₀ : Fin 4) (h_ne : μ₀ ≠ ν₀) :
    (trFSqAmb L).coeff (Finsupp.single ({μ₀}, ν₀, ⟨0, L.hd⟩) 2) =
      2 * ((minkowskiMetric μ₀ μ₀ * minkowskiMetric ν₀ ν₀ : ℝ) : ℂ) := by
  let a₀ : Fin d := ⟨0, L.hd⟩
  let v : JetVar d := ({μ₀}, ν₀, a₀)
  simp only [trFSqAmb, tracePairAmb, MvPolynomial.coeff_sum, MvPolynomial.coeff_smul, smul_eq_mul]
  have h_term : ∀ μ ν a,
      (FVec L μ ν a * FVec L μ ν a).coeff (Finsupp.single v 2) =
        if (μ = μ₀ ∧ ν = ν₀ ∧ a = a₀) ∨ (μ = ν₀ ∧ ν = μ₀ ∧ a = a₀) then 1 else 0 := by
    intro μ ν a
    rw [coeff_mul_single_two (coeff_zero_of_inLiePoly L (InLiePoly.F μ ν) a)]
    by_cases h1 : μ = μ₀ ∧ ν = ν₀ ∧ a = a₀
    · rcases h1 with ⟨rfl, rfl, rfl⟩
      rw [if_pos (Or.inl ⟨rfl, rfl, rfl⟩), FVec_coeff_single L h_ne a₀ a₀, if_pos rfl, one_pow]
    · by_cases h2 : μ = ν₀ ∧ ν = μ₀ ∧ a = a₀
      · rcases h2 with ⟨rfl, rfl, rfl⟩
        rw [if_pos (Or.inr ⟨rfl, rfl, rfl⟩)]
        have h_eq : FVec L μ ν a₀ = - FVec L ν μ a₀ := by
          have := congrArg (fun Φ : AmbientLie d => Φ a₀) (FVec_antisymm L μ ν)
          simpa using this
        rw [h_eq, MvPolynomial.coeff_neg, FVec_coeff_single L h_ne a₀ a₀, if_pos rfl]
        norm_num
      · rw [if_neg (by tauto)]
        have hc0 : (FVec L μ ν a).coeff (Finsupp.single v 1) = 0 := by
          simp only [FVec, AComp, coordDeriv_X, MvPolynomial.coeff_add, MvPolynomial.coeff_sub,
            MvPolynomial.coeff_sum, MvPolynomial.coeff_smul, smul_eq_mul]
          have ha : (MvPolynomial.X (μ ::ₘ 0, ν, a) : CoordPoly d).coeff (Finsupp.single v 1) = 0 := by
            rw [MvPolynomial.coeff_X, if_neg]; intro heq
            have h' := (Finsupp.single_left_inj one_ne_zero).mp heq
            have hμ : μ = μ₀ := Multiset.singleton_inj.mp (Prod.mk.inj h').1
            have hν : ν = ν₀ := (Prod.mk.inj (Prod.mk.inj h').2).1
            have ha' : a = a₀ := (Prod.mk.inj (Prod.mk.inj h').2).2
            exact h1 ⟨hμ, hν, ha'⟩
          have hb : (MvPolynomial.X (ν ::ₘ 0, μ, a) : CoordPoly d).coeff (Finsupp.single v 1) = 0 := by
            rw [MvPolynomial.coeff_X, if_neg]; intro heq
            have h' := (Finsupp.single_left_inj one_ne_zero).mp heq
            have hν : ν = μ₀ := Multiset.singleton_inj.mp (Prod.mk.inj h').1
            have hμ : μ = ν₀ := (Prod.mk.inj (Prod.mk.inj h').2).1
            have ha' : a = a₀ := (Prod.mk.inj (Prod.mk.inj h').2).2
            exact h2 ⟨hμ, hν, ha'⟩
          have hc : ∀ b c : Fin d,
              (MvPolynomial.X (0, μ, b) * MvPolynomial.X (0, ν, c) : CoordPoly d).coeff
                (Finsupp.single v 1) = 0 := by
            intro b c
            rw [MvPolynomial.X, MvPolynomial.X, MvPolynomial.monomial_mul, one_mul,
              MvPolynomial.coeff_monomial, if_neg]
            intro heq
            have h_at := congrArg (fun f : JetVar d →₀ ℕ => f (0, μ, b)) heq
            simp only [Finsupp.add_apply, Finsupp.single_apply] at h_at
            have hne0 : v ≠ (0, μ, b) := fun hh => by
              have := congrArg Multiset.card (Prod.mk.inj hh).1; simp [v] at this
            rw [if_neg hne0] at h_at
            split_ifs at h_at <;> omega
          simp only [ha, hb, hc, sub_self, mul_zero, smul_zero, Finset.sum_const_zero, add_zero]
        rw [hc0, sq, mul_zero]
  rw [Finset.sum_congr rfl fun μ _ => Finset.sum_congr rfl fun ν _ =>
    congrArg _ (Finset.sum_congr rfl fun a _ => h_term μ ν a)]
  have h_sum_a : ∀ μ ν : Fin 4,
      (∑ a : Fin d, if (μ = μ₀ ∧ ν = ν₀ ∧ a = a₀) ∨ (μ = ν₀ ∧ ν = μ₀ ∧ a = a₀) then (1 : ℂ) else 0) =
        if (μ = μ₀ ∧ ν = ν₀) ∨ (μ = ν₀ ∧ ν = μ₀) then 1 else 0 := by
    intro μ ν
    by_cases h12 : (μ = μ₀ ∧ ν = ν₀) ∨ (μ = ν₀ ∧ ν = μ₀)
    · rw [if_pos h12]
      have : ∀ a : Fin d,
          (if (μ = μ₀ ∧ ν = ν₀ ∧ a = a₀) ∨ (μ = ν₀ ∧ ν = μ₀ ∧ a = a₀) then (1 : ℂ) else 0) =
          if a = a₀ then 1 else 0 := fun a => by
        by_cases ha : a = a₀
        · subst ha; simp [h12]
        · simp [ha]
      simp_rw [this, Finset.sum_ite_eq', Finset.mem_univ, if_pos]
    · rw [if_neg h12]
      refine Finset.sum_eq_zero fun a _ => if_neg (by tauto)
  simp_rw [h_sum_a]
  fin_cases μ₀ <;> fin_cases ν₀ <;>
    simp_all [minkowskiMetric, Matrix.diagonal_apply, toCoords, vec4, ofCoords,
      Fin.sum_univ_four, Fin.isValue, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.cons_val] <;>
    norm_num

theorem trFSqAmb_nonzero : trFSqAmb L ≠ 0 := by
  intro h
  have hc := congrArg (fun f : CoordPoly d => f.coeff (Finsupp.single ({(0 : Fin 4)}, (1 : Fin 4), ⟨0, L.hd⟩) 2)) h
  rw [trFSqAmb_coeff_single_two L 0 1 (by decide), MvPolynomial.coeff_zero] at hc
  simp [minkowskiMetric, Matrix.diagonal_apply, toCoords, vec4, ofCoords] at hc

/-- Ambient `stress_energy` tensor in `CoordPoly d`. -/
def stressEnergyAmb (μ ν : Fin 4) : CoordPoly d :=
  ∑ α : Fin 4, ((-minkowskiMetric α α : ℝ) : ℂ) • tracePairAmb (FVec L μ α) (FVec L ν α) +
    ((minkowskiMetric μ ν / 4 : ℝ) : ℂ) • trFSqAmb L

theorem stressEnergyAmb_inPoly (μ ν : Fin 4) : InPoly L (stressEnergyAmb L μ ν) :=
  InPoly.add
    (Subalgebra.sum_mem (PolySub L) fun α _ =>
      Subalgebra.smul_mem (PolySub L) (InPoly.trace_pair (InLiePoly.F μ α) (InLiePoly.F ν α)) _)
    (Subalgebra.smul_mem (PolySub L) (trFSqAmb_inPoly L) _)

theorem stressEnergyAmb_dim (μ ν : Fin 4) : coordWdeg (stressEnergyAmb L μ ν) = 4 := by
  have h_le : coordWdeg (stressEnergyAmb L μ ν) ≤ 4 := by
    refine le_trans (coordWdeg_add_le _ _) (max_le ?_ ?_)
    · refine (coordWdeg_le_iff _ _).mpr fun m hm => ?_
      rcases Finset.mem_biUnion.mp (MvPolynomial.support_sum hm) with ⟨α, _, hmα⟩
      have h_sub : coordWdeg (tracePairAmb (FVec L μ α) (FVec L ν α)) ≤ 4 := by
        refine (coordWdeg_le_iff _ _).mpr fun m' hm' => ?_
        rcases Finset.mem_biUnion.mp (MvPolynomial.support_sum hm') with ⟨a, _, hma⟩
        have h1 : coordWdeg (FVec L μ α a) ≤ 2 :=
          (coordWdeg_le_iff _ _).mpr fun m1 hm1 => (FVec_homogeneous_two L μ α a m1 hm1).le
        have h2 : coordWdeg (FVec L ν α a) ≤ 2 :=
          (coordWdeg_le_iff _ _).mpr fun m2 hm2 => (FVec_homogeneous_two L ν α a m2 hm2).le
        have hmul := le_trans (coordWdeg_mul_le (FVec L μ α a) (FVec L ν α a)) (add_le_add h1 h2)
        exact le_trans ((coordWdeg_le_iff _ _).mp hmul m' hma) (by omega)
      by_cases hc : ((-minkowskiMetric α α : ℝ) : ℂ) = 0
      · rw [hc, zero_smul] at hmα; simp at hmα
      · rw [← coordWdeg_smul _ hc] at h_sub
        exact (coordWdeg_le_iff _ _).mp h_sub m hmα
    · refine (coordWdeg_le_iff _ _).mpr fun m hm => ?_
      have h_tr : coordWdeg (trFSqAmb L) ≤ 4 := by
        refine (coordWdeg_le_iff _ _).mpr fun m' hm' => ?_
        rcases Finset.mem_biUnion.mp (MvPolynomial.support_sum hm') with ⟨α, _, hmα⟩
        rcases Finset.mem_biUnion.mp (MvPolynomial.support_sum hmα) with ⟨β, _, hmβ⟩
        have h_sub : coordWdeg (tracePairAmb (FVec L α β) (FVec L α β)) ≤ 4 := by
          refine (coordWdeg_le_iff _ _).mpr fun m'' hm'' => ?_
          rcases Finset.mem_biUnion.mp (MvPolynomial.support_sum hm'') with ⟨a, _, hma⟩
          have h1 : coordWdeg (FVec L α β a) ≤ 2 :=
            (coordWdeg_le_iff _ _).mpr fun m1 hm1 => (FVec_homogeneous_two L α β a m1 hm1).le
          have hmul := le_trans (coordWdeg_mul_le (FVec L α β a) (FVec L α β a)) (add_le_add h1 h1)
          exact le_trans ((coordWdeg_le_iff _ _).mp hmul m'' hma) (by omega)
        by_cases hc : ((minkowskiMetric α α * minkowskiMetric β β : ℝ) : ℂ) = 0
        · rw [hc, zero_smul] at hmβ; simp at hmβ
        · rw [← coordWdeg_smul _ hc] at h_sub
          exact (coordWdeg_le_iff _ _).mp h_sub m' hmβ
      by_cases hc : ((minkowskiMetric μ ν / 4 : ℝ) : ℂ) = 0
      · rw [hc, zero_smul] at hm; simp at hm
      · rw [← coordWdeg_smul _ hc] at h_tr
        exact (coordWdeg_le_iff _ _).mp h_tr m hm
  refine le_antisymm h_le ?_
  let a₀ : Fin d := ⟨0, L.hd⟩
  by_cases h_eq : μ = ν
  · subst h_eq
    have h_pair : ∃ β γ : Fin 4, β ≠ γ ∧ β ≠ μ ∧ γ ≠ μ := by
      fin_cases μ
      · exact ⟨2, 3, by decide, by decide, by decide⟩
      · exact ⟨2, 3, by decide, by decide, by decide⟩
      · exact ⟨0, 1, by decide, by decide, by decide⟩
      · exact ⟨0, 1, by decide, by decide, by decide⟩
    rcases h_pair with ⟨β, γ, hβγ, hβμ, hγμ⟩
    let v : JetVar d := ({β}, γ, a₀)
    have h_coeff : (stressEnergyAmb L μ μ).coeff (Finsupp.single v 2) ≠ 0 := by
      rw [stressEnergyAmb, MvPolynomial.coeff_add, MvPolynomial.coeff_sum, MvPolynomial.coeff_smul,
        smul_eq_mul, trFSqAmb_coeff_single_two L β γ hβγ]
      have h_first : ∀ α : Fin 4, (tracePairAmb (FVec L μ α) (FVec L μ α)).coeff (Finsupp.single v 2) = 0 := by
        intro α
        simp only [tracePairAmb, MvPolynomial.coeff_sum]
        refine Finset.sum_eq_zero fun a _ => ?_
        rw [coeff_mul_single_two (coeff_zero_of_inLiePoly L (InLiePoly.F μ α) a)]
        have hc0 : (FVec L μ α a).coeff (Finsupp.single v 1) = 0 := by
          simp only [FVec, AComp, coordDeriv_X, MvPolynomial.coeff_add, MvPolynomial.coeff_sub,
            MvPolynomial.coeff_sum, MvPolynomial.coeff_smul, smul_eq_mul]
          have ha1 : (MvPolynomial.X (μ ::ₘ 0, α, a) : CoordPoly d).coeff (Finsupp.single v 1) = 0 := by
            rw [MvPolynomial.coeff_X, if_neg]; intro heq
            exact hβμ.symm (Multiset.singleton_inj.mp (Prod.mk.inj ((Finsupp.single_left_inj one_ne_zero).mp heq)).1)
          have ha2 : (MvPolynomial.X (α ::ₘ 0, μ, a) : CoordPoly d).coeff (Finsupp.single v 1) = 0 := by
            rw [MvPolynomial.coeff_X, if_neg]; intro heq
            exact hγμ.symm (Prod.mk.inj (Prod.mk.inj ((Finsupp.single_left_inj one_ne_zero).mp heq)).2).1
          have ha3 : ∀ b c : Fin d,
              (MvPolynomial.X (0, μ, b) * MvPolynomial.X (0, α, c) : CoordPoly d).coeff
                (Finsupp.single v 1) = 0 := by
            intro b c
            rw [MvPolynomial.X, MvPolynomial.X, MvPolynomial.monomial_mul, one_mul,
              MvPolynomial.coeff_monomial, if_neg]
            intro heq
            have hdeg := congrArg totalDeg heq
            rw [totalDeg_add, totalDeg_single, totalDeg_single, totalDeg_single] at hdeg
            omega
          simp only [ha1, ha2, ha3, sub_self, mul_zero, smul_zero, Finset.sum_const_zero, add_zero]
        rw [hc0, sq, mul_zero]
      simp [MvPolynomial.coeff_smul, h_first]
      have h_nz : ∀ i : Fin 4, (minkowskiMetric i i : ℂ) ≠ 0 := fun i => by
        fin_cases i <;> simp [minkowskiMetric, Matrix.diagonal_apply, toCoords, vec4, ofCoords]
      push_cast
      have h4 : (4 : ℂ) ≠ 0 := by norm_num
      have h2 : (2 : ℂ) ≠ 0 := by norm_num
      simpa [Complex.ofReal_div, Complex.ofReal_ofNat] using
        mul_ne_zero (div_ne_zero (h_nz μ) h4)
          (mul_ne_zero h2 (mul_ne_zero (h_nz β) (h_nz γ)))
    have h_wt : monWeight (Finsupp.single v 2) = 4 := by
      rw [monWeight_single]; simp [v, jetWeight]
    calc 4 = monWeight (Finsupp.single v 2) := h_wt.symm
      _ ≤ coordWdeg (stressEnergyAmb L μ μ) :=
          (coordWdeg_le_iff _ _).mp le_rfl _ (MvPolynomial.mem_support_iff.mpr h_coeff)
  · have h_alpha : ∃ α₀ : Fin 4, α₀ ≠ μ ∧ α₀ ≠ ν := by
      fin_cases μ <;> fin_cases ν
      all_goals first
        | exact ⟨0, by decide, by decide⟩
        | exact ⟨1, by decide, by decide⟩
        | exact ⟨2, by decide, by decide⟩
        | exact ⟨3, by decide, by decide⟩
    rcases h_alpha with ⟨α₀, hαμ, hαν⟩
    let v₁ : JetVar d := ({μ}, α₀, a₀)
    let v₂ : JetVar d := ({ν}, α₀, a₀)
    have hv12 : v₁ ≠ v₂ := fun hh => h_eq (Multiset.singleton_inj.mp (Prod.mk.inj hh).1)
    let m : JetVar d →₀ ℕ := Finsupp.single v₁ 1 + Finsupp.single v₂ 1
    have h_coeff : (stressEnergyAmb L μ ν).coeff m ≠ 0 := by
      rw [stressEnergyAmb, MvPolynomial.coeff_add, MvPolynomial.coeff_sum]
      have h_tr0 : ((minkowskiMetric μ ν / 4 : ℝ) : ℂ) = 0 := by
        fin_cases μ <;> fin_cases ν <;>
          simp_all [minkowskiMetric, Matrix.diagonal_apply, toCoords, vec4, ofCoords]
      simp only [h_tr0, zero_smul, MvPolynomial.coeff_zero, add_zero]
      have h_term : ∀ α : Fin 4,
          (tracePairAmb (FVec L μ α) (FVec L ν α)).coeff m = if α = α₀ then 1 else 0 := by
        intro α
        simp only [tracePairAmb, MvPolynomial.coeff_sum]
        have h_fvec : ∀ (ρ σ : Fin 4) (a : Fin d) (w : JetVar d) (κ τ : Fin 4),
            w = ({κ}, τ, a₀) → κ ≠ τ →
            (FVec L ρ σ a).coeff (Finsupp.single w 1) =
              if (ρ = κ ∧ σ = τ ∧ a = a₀) then 1
              else if (ρ = τ ∧ σ = κ ∧ a = a₀) then -1 else 0 := by
          intro ρ σ a w κ τ hw hκτ
          rcases hw with rfl
          by_cases h1 : ρ = κ ∧ σ = τ ∧ a = a₀
          · rcases h1 with ⟨rfl, rfl, rfl⟩
            rw [if_pos ⟨rfl, rfl, rfl⟩, FVec_coeff_single L hκτ a₀ a₀, if_pos rfl]
          · rw [if_neg h1]
            by_cases h2 : ρ = τ ∧ σ = κ ∧ a = a₀
            · rcases h2 with ⟨rfl, rfl, rfl⟩
              rw [if_pos ⟨rfl, rfl, rfl⟩]
              have h_eq' : FVec L ρ σ a₀ = - FVec L σ ρ a₀ := by
                have := congrArg (fun Φ : AmbientLie d => Φ a₀) (FVec_antisymm L ρ σ)
                simpa using this
              rw [h_eq', MvPolynomial.coeff_neg, FVec_coeff_single L hκτ a₀ a₀, if_pos rfl]
            · rw [if_neg h2]
              simp only [FVec, AComp, coordDeriv_X, MvPolynomial.coeff_add, MvPolynomial.coeff_sub,
                MvPolynomial.coeff_sum, MvPolynomial.coeff_smul, smul_eq_mul]
              have ha1 : (MvPolynomial.X (ρ ::ₘ 0, σ, a) : CoordPoly d).coeff
                  (Finsupp.single ({κ}, τ, a₀) 1) = 0 := by
                rw [MvPolynomial.coeff_X, if_neg]; intro heq
                have h' := (Finsupp.single_left_inj one_ne_zero).mp heq
                exact h1 ⟨Multiset.singleton_inj.mp (Prod.mk.inj h').1,
                  (Prod.mk.inj (Prod.mk.inj h').2).1, (Prod.mk.inj (Prod.mk.inj h').2).2⟩
              have ha2 : (MvPolynomial.X (σ ::ₘ 0, ρ, a) : CoordPoly d).coeff
                  (Finsupp.single ({κ}, τ, a₀) 1) = 0 := by
                rw [MvPolynomial.coeff_X, if_neg]; intro heq
                have h' := (Finsupp.single_left_inj one_ne_zero).mp heq
                exact h2 ⟨(Prod.mk.inj (Prod.mk.inj h').2).1,
                  Multiset.singleton_inj.mp (Prod.mk.inj h').1,
                  (Prod.mk.inj (Prod.mk.inj h').2).2⟩
              have ha3 : ∀ b c : Fin d,
                  (MvPolynomial.X (0, ρ, b) * MvPolynomial.X (0, σ, c) : CoordPoly d).coeff
                    (Finsupp.single ({κ}, τ, a₀) 1) = 0 := by
                intro b c
                rw [MvPolynomial.X, MvPolynomial.X, MvPolynomial.monomial_mul, one_mul,
                  MvPolynomial.coeff_monomial, if_neg]
                intro heq
                have hdeg := congrArg totalDeg heq
                rw [totalDeg_add, totalDeg_single, totalDeg_single, totalDeg_single] at hdeg
                omega
              simp only [ha1, ha2, ha3, sub_self, mul_zero, smul_zero, Finset.sum_const_zero, add_zero]
        have h_sum_a : ∀ a : Fin d,
            (FVec L μ α a * FVec L ν α a).coeff m = if α = α₀ ∧ a = a₀ then 1 else 0 := by
          intro a
          rw [coeff_mul_single_add_single
            (coeff_zero_of_inLiePoly L (InLiePoly.F μ α) a)
            (coeff_zero_of_inLiePoly L (InLiePoly.F ν α) a) hv12]
          rw [h_fvec μ α a v₁ μ α₀ rfl hαμ.symm, h_fvec ν α a v₂ ν α₀ rfl hαν.symm,
            h_fvec μ α a v₂ ν α₀ rfl hαν.symm, h_fvec ν α a v₁ μ α₀ rfl hαμ.symm]
          by_cases hα : α = α₀ <;> by_cases ha : a = a₀
          · subst ha; rw [hα]
            simp [h_eq, hαμ.symm, hαν.symm]
          · simp [hα, ha]
          · simp [hα, ha, hαμ.symm, hαν.symm]
          · simp [hα, ha]
        simp_rw [h_sum_a]
        by_cases hα : α = α₀
        · rw [hα]; simp [Finset.sum_ite_eq']
        · simp [hα]
      simp_rw [MvPolynomial.coeff_smul, smul_eq_mul, h_term]
      simp only [mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte, add_zero]
      fin_cases α₀ <;> simp [minkowskiMetric, Matrix.diagonal_apply, toCoords, vec4, ofCoords]
    have h_wt : monWeight m = 4 := by
      rw [monWeight_add, monWeight_single, monWeight_single, one_mul, one_mul]
      simp [v₁, v₂, jetWeight]
    calc 4 = monWeight m := h_wt.symm
      _ ≤ coordWdeg (stressEnergyAmb L μ ν) :=
          (coordWdeg_le_iff _ _).mp le_rfl _ (MvPolynomial.mem_support_iff.mpr h_coeff)

private theorem invContractAmb_add (m : ℕ) (T : MultilinearMap ℝ (fun _ : Fin m => L.Lie) ℝ)
    (Φ : Fin m → AmbientLie d) (k : Fin m) (X Y : AmbientLie d) :
    invContractAmb L m T (Function.update Φ k (X + Y)) =
      invContractAmb L m T (Function.update Φ k X) +
      invContractAmb L m T (Function.update Φ k Y) := by
  dsimp only [invContractAmb]
  rw [← Finset.sum_add_distrib]
  refine Finset.sum_congr rfl fun idx _ => ?_
  rw [← smul_add]
  congr 1
  have h_upd : ∀ (Z : AmbientLie d),
      (fun j => Function.update Φ k Z j (idx j)) =
      Function.update (fun j => Φ j (idx j)) k (Z (idx k)) :=
    fun Z => funext fun j => by by_cases hj : j = k <;> simp [hj]
  change (∏ j : Fin m, Function.update Φ k (X + Y) j (idx j)) =
    (∏ j : Fin m, Function.update Φ k X j (idx j)) +
    (∏ j : Fin m, Function.update Φ k Y j (idx j))
  rw [h_upd (X + Y), h_upd X, h_upd Y,
    Finset.prod_update_of_mem (Finset.mem_univ k),
    Finset.prod_update_of_mem (Finset.mem_univ k),
    Finset.prod_update_of_mem (Finset.mem_univ k), Pi.add_apply, add_mul]

private theorem invContractAmb_smul (m : ℕ) (T : MultilinearMap ℝ (fun _ : Fin m => L.Lie) ℝ)
    (Φ : Fin m → AmbientLie d) (k : Fin m) (c : ℂ) (X : AmbientLie d) :
    invContractAmb L m T (Function.update Φ k (c • X)) =
      c • invContractAmb L m T (Function.update Φ k X) := by
  dsimp only [invContractAmb]
  rw [Finset.smul_sum]
  refine Finset.sum_congr rfl fun idx _ => ?_
  rw [smul_comm]
  congr 1
  have h_upd : ∀ (Z : AmbientLie d),
      (fun j => Function.update Φ k Z j (idx j)) =
      Function.update (fun j => Φ j (idx j)) k (Z (idx k)) :=
    fun Z => funext fun j => by by_cases hj : j = k <;> simp [hj]
  change (∏ j : Fin m, Function.update Φ k (c • X) j (idx j)) =
    c • (∏ j : Fin m, Function.update Φ k X j (idx j))
  rw [h_upd (c • X), h_upd X,
    Finset.prod_update_of_mem (Finset.mem_univ k),
    Finset.prod_update_of_mem (Finset.mem_univ k), Pi.smul_apply, smul_mul_assoc]

private theorem invContractAmb_ad_invariant (m : ℕ)
    (T : MultilinearMap ℝ (fun _ : Fin m => L.Lie) ℝ)
    (hT : ∀ (g : G) (v : Fin m → L.Lie), T (fun k => L.adjoint_action g (v k)) = T v)
    (A : AmbientLie d) (Φ : Fin m → AmbientLie d) :
    ∑ k : Fin m, invContractAmb L m T (Function.update Φ k (bracketAmb L A (Φ k))) = 0 := by
  dsimp only [invContractAmb]
  have h_split : ∀ (k : Fin m) (idx : Fin m → Fin d),
      ((T (fun j => L.B (idx j)) : ℝ) : ℂ) •
        ∏ j : Fin m, (Function.update Φ k (bracketAmb L A (Φ k)) j) (idx j) =
      ∑ b : Fin d, ∑ c : Fin d,
        ((T (fun j => L.B (idx j)) * L.lie_inner (L.B (idx k)) ⁅L.B b, L.B c⁆ : ℝ) : ℂ) •
          ((∏ j ∈ Finset.univ.erase k, Φ j (idx j)) * (A b * Φ k c)) := by
    intro k idx
    have h_pe := Finset.mul_prod_erase (Finset.univ : Finset (Fin m))
      (fun j => (Function.update Φ k (bracketAmb L A (Φ k)) j) (idx j)) (Finset.mem_univ k)
    rw [← h_pe]
    have h_self : (Function.update Φ k (bracketAmb L A (Φ k)) k) (idx k) =
        ∑ b : Fin d, ∑ c : Fin d,
          ((L.lie_inner (L.B (idx k)) ⁅L.B b, L.B c⁆ : ℝ) : ℂ) • (A b * Φ k c) := by
      simp [bracketAmb, structConst]
    have h_prod_eq :
        (∏ j ∈ Finset.univ.erase k, (Function.update Φ k (bracketAmb L A (Φ k)) j) (idx j)) =
        ∏ j ∈ Finset.univ.erase k, Φ j (idx j) :=
      Finset.prod_congr rfl fun j hj => by rw [Function.update_of_ne (Finset.ne_of_mem_erase hj)]
    rw [h_self, h_prod_eq, Finset.sum_mul, Finset.smul_sum]
    refine Finset.sum_congr rfl fun b _ => ?_
    rw [Finset.sum_mul, Finset.smul_sum]
    refine Finset.sum_congr rfl fun c _ => ?_
    rw [smul_mul_assoc, smul_smul, Complex.ofReal_mul]
    congr 1; ring
  have h_step1 :
      (∑ k : Fin m, ∑ idx : Fin m → Fin d, ((T (fun j => L.B (idx j)) : ℝ) : ℂ) •
        ∏ j : Fin m, (Function.update Φ k (bracketAmb L A (Φ k)) j) (idx j)) =
      ∑ k : Fin m, ∑ idx : Fin m → Fin d, ∑ b : Fin d, ∑ c : Fin d,
        ((T (fun j => L.B (idx j)) * L.lie_inner (L.B (idx k)) ⁅L.B b, L.B c⁆ : ℝ) : ℂ) •
          ((∏ j ∈ Finset.univ.erase k, Φ j (idx j)) * (A b * Φ k c)) :=
    Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun idx _ => h_split k idx
  rw [h_step1]
  have h_reindex : ∀ k : Fin m,
      (∑ idx : Fin m → Fin d, ∑ b : Fin d, ∑ c : Fin d,
        ((T (fun j => L.B (idx j)) * L.lie_inner (L.B (idx k)) ⁅L.B b, L.B c⁆ : ℝ) : ℂ) •
          ((∏ j ∈ Finset.univ.erase k, Φ j (idx j)) * (A b * Φ k c))) =
      ∑ b : Fin d, ∑ idx' : Fin m → Fin d,
        ((T (Function.update (fun j => L.B (idx' j)) k ⁅L.B b, L.B (idx' k)⁆) : ℝ) : ℂ) •
          (A b * ∏ j : Fin m, Φ j (idx' j)) := by
    intro k
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun b _ => ?_
    let e : (Fin m → Fin d) × Fin d ≃ (Fin m → Fin d) × Fin d :=
      { toFun := fun p => (Function.update p.1 k p.2, p.1 k)
        invFun := fun p => (Function.update p.1 k p.2, p.1 k)
        left_inv := fun ⟨idx, c⟩ => Prod.ext (funext fun j => by
          by_cases hj : j = k <;> simp [hj]) (by simp)
        right_inv := fun ⟨idx', a⟩ => Prod.ext (funext fun j => by
          by_cases hj : j = k <;> simp [hj]) (by simp) }
    rw [← Fintype.sum_prod_type', ← Equiv.sum_comp e.symm]
    dsimp only [e, Equiv.coe_fn_symm_mk]
    rw [Fintype.sum_prod_type]
    refine Finset.sum_congr rfl fun idx' _ => ?_
    have h_prod : ∀ a : Fin d,
        (∏ j ∈ Finset.univ.erase k, Φ j (Function.update idx' k a j)) * (A b * Φ k (idx' k)) =
        A b * ∏ j : Fin m, Φ j (idx' j) := by
      intro a
      have h_er : (∏ j ∈ Finset.univ.erase k, Φ j (Function.update idx' k a j)) =
          ∏ j ∈ Finset.univ.erase k, Φ j (idx' j) :=
        Finset.prod_congr rfl fun j hj => by rw [Function.update_of_ne (Finset.ne_of_mem_erase hj)]
      rw [h_er, mul_left_comm, Finset.prod_erase_mul _ _ (Finset.mem_univ k)]
    have h_lin : (∑ a : Fin d,
        L.lie_inner (L.B a) ⁅L.B b, L.B (idx' k)⁆ *
          T (Function.update (fun j => L.B (idx' j)) k (L.B a))) =
        T (Function.update (fun j => L.B (idx' j)) k ⁅L.B b, L.B (idx' k)⁆) := by
      have hexp := L.expand ⁅L.B b, L.B (idx' k)⁆
      conv_rhs => rw [hexp]
      rw [MultilinearMap.map_update_sum]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [MultilinearMap.map_update_smul, smul_eq_mul, L.lie_inner_symm]
    simp only [e, Equiv.coe_fn_symm_mk]
    have h_step : ∀ a : Fin d,
        ((T (fun j => L.B (Function.update idx' k a j)) *
          L.lie_inner (L.B a) ⁅L.B b, L.B (idx' k)⁆ : ℝ) : ℂ) •
            ((∏ j ∈ Finset.univ.erase k, Φ j (Function.update idx' k a j)) *
              (A b * Φ k (idx' k))) =
        ((L.lie_inner (L.B a) ⁅L.B b, L.B (idx' k)⁆ *
          T (Function.update (fun j => L.B (idx' j)) k (L.B a)) : ℝ) : ℂ) •
            (A b * ∏ j : Fin m, Φ j (idx' j)) := by
      intro a
      rw [h_prod a, mul_comm (T _) (L.lie_inner _ _)]
      congr 1; congr 1; congr 1; congr 1; funext j; by_cases hj : j = k <;> simp [hj]
    have h_simp : (∑ a : Fin d,
        ((T (fun j => L.B (Function.update idx' k a j)) *
          L.lie_inner (L.B (Function.update idx' k a k)) ⁅L.B b, L.B (idx' k)⁆ : ℝ) : ℂ) •
            ((∏ j ∈ Finset.univ.erase k, Φ j (Function.update idx' k a j)) *
              (A b * Φ k (idx' k)))) =
        ∑ a : Fin d,
          ((L.lie_inner (L.B a) ⁅L.B b, L.B (idx' k)⁆ *
            T (Function.update (fun j => L.B (idx' j)) k (L.B a)) : ℝ) : ℂ) •
              (A b * ∏ j : Fin m, Φ j (idx' j)) :=
      Finset.sum_congr rfl fun a _ => by
        rw [Function.update_self]; exact h_step a
    calc (∑ a : Fin d, ((T (fun j => L.B (Function.update idx' k a j)) *
          L.lie_inner (L.B (Function.update idx' k a k)) ⁅L.B b, L.B (idx' k)⁆ : ℝ) : ℂ) •
            ((∏ j ∈ Finset.univ.erase k, Φ j (Function.update idx' k a j)) *
              (A b * Φ k (idx' k))))
        = ∑ a : Fin d,
            ((L.lie_inner (L.B a) ⁅L.B b, L.B (idx' k)⁆ *
              T (Function.update (fun j => L.B (idx' j)) k (L.B a)) : ℝ) : ℂ) •
                (A b * ∏ j : Fin m, Φ j (idx' j)) := h_simp
      _ = ((∑ a : Fin d,
            L.lie_inner (L.B a) ⁅L.B b, L.B (idx' k)⁆ *
              T (Function.update (fun j => L.B (idx' j)) k (L.B a)) : ℝ) : ℂ) •
                (A b * ∏ j : Fin m, Φ j (idx' j)) := by
          rw [← Finset.sum_smul]; congr 1; push_cast; rfl
      _ = ((T (Function.update (fun j => L.B (idx' j)) k ⁅L.B b, L.B (idx' k)⁆) : ℝ) : ℂ) •
            (A b * ∏ j : Fin m, Φ j (idx' j)) := by rw [h_lin]
  simp_rw [h_reindex]
  rw [Finset.sum_comm]
  refine Finset.sum_eq_zero fun b _ => ?_
  rw [Finset.sum_comm]
  refine Finset.sum_eq_zero fun idx' _ => ?_
  rw [← Finset.sum_smul]
  have h_mult := multilinear_ad_invariant L m T hT (L.B b) (fun j => L.B (idx' j))
  have h_c0 : ((∑ k : Fin m,
      T (Function.update (fun j => L.B (idx' j)) k ⁅L.B b, L.B (idx' k)⁆) : ℝ) : ℂ) = 0 := by
    rw [h_mult, Complex.ofReal_zero]
  have h_cast : (∑ k : Fin m,
      ((T (Function.update (fun j => L.B (idx' j)) k ⁅L.B b, L.B (idx' k)⁆) : ℝ) : ℂ)) = 0 := by
    push_cast at h_c0 ⊢; exact h_c0
  rw [h_cast, zero_smul]

private theorem stressEnergyAmb_symm (μ ν : Fin 4) :
    stressEnergyAmb L μ ν = stressEnergyAmb L ν μ := by
  dsimp only [stressEnergyAmb, tracePairAmb]
  refine congrArg₂ (· + ·) ?_ ?_
  · refine Finset.sum_congr rfl fun α _ => congrArg _ ?_
    exact Finset.sum_congr rfl fun a _ => mul_comm _ _
  · have hsym : minkowskiMetric μ ν = minkowskiMetric ν μ := by
      fin_cases μ <;> fin_cases ν <;> simp [minkowskiMetric, Matrix.diagonal_apply, toCoords, vec4]
    rw [hsym]

set_option maxHeartbeats 1200000 in
/-- Unconditional constructive builder of `CurvaturePolynomialAlgebra G` from `LieBasisData G d`. -/
noncomputable def buildCurvaturePolynomialAlgebra [CompactSimpleLieGroup G] :
    CurvaturePolynomialAlgebra G where
  Poly := PolyVal d L
  commRing := inferInstance
  algebra := inferInstance
  nontrivial := inferInstance
  conj := fun P => ⟨coordConj P.1, coordConj_inPoly L P.2⟩
  conj_involutive := fun P => Subtype.ext (coordConj_involutive P.1)
  conj_one := Subtype.ext (map_one coordConj)
  conj_add := fun P Q => Subtype.ext (map_add coordConj P.1 Q.1)
  conj_mul := fun P Q => Subtype.ext (map_mul coordConj P.1 Q.1)
  conj_smul := fun c P => Subtype.ext (coordConj_smul c P.1)
  polyFiltration := fun d' =>
    { carrier := { P : PolyVal d L | coordWdeg P.1 ≤ d' }
      zero_mem' := by simp [coordWdeg_zero]
      add_mem' := fun {P Q} hP hQ => le_trans (coordWdeg_add_le P.1 Q.1) (max_le hP hQ)
      smul_mem' := fun c {P} hP => by
        by_cases hc : c = 0
        · simp [hc, coordWdeg_zero]
        · change coordWdeg (c • P.1) ≤ d'
          rw [coordWdeg_smul c hc P.1]; exact hP }
  polyFiltration_mono := fun _ _ hle _ hP => le_trans hP hle
  classicalDim := fun P => coordWdeg P.1
  dim_zero := coordWdeg_zero
  dim_one := coordWdeg_one
  dim_conj := fun P => coordWdeg_coordConj P.1
  dim_smul := fun c P hc => coordWdeg_smul c hc P.1
  mem_polyFiltration_iff_dim_le := fun _ _ => Iff.rfl
  dim_add_le := fun P Q => coordWdeg_add_le P.1 Q.1
  dim_mul_le := fun P Q => coordWdeg_mul_le P.1 Q.1
  dim_mul := fun P Q hP hQ _ =>
    coordWdeg_mul (fun h => hP (Subtype.ext h)) (fun h => hQ (Subtype.ext h))
  Lie := L.Lie
  lieRingLie := L.lieRing
  lieAlgebraLie := L.lieAlgebra
  finDimLie := L.finDim
  topologicalSpaceLie := L.topSpace
  t2SpaceLie := L.t2Space
  topologicalAddGroupLie := L.topAddGroup
  continuousSMulLie := L.contSMul
  adjoint_action := L.adjoint_action
  adjoint_action_one := L.adjoint_action_one
  adjoint_action_mul := L.adjoint_action_mul
  adjoint_action_bracket := L.adjoint_action_bracket
  lie_inner := L.lie_inner
  lie_inner_symm := L.lie_inner_symm
  lie_inner_pos := L.lie_inner_pos
  lie_inner_ad_inv := L.lie_inner_ad_inv
  su2_triple := L.su2_triple
  casimir_adjoint := L.casimir_adjoint
  casimir_adjoint_pos := L.casimir_adjoint_pos
  killing_casimir_identity := L.killing_casimir_identity
  exp := L.exp
  exp_zero := L.exp_zero
  exp_add_of_commute := L.exp_add_of_commute
  exp_continuous := L.exp_continuous
  exp_local_homeomorph := L.exp_local_homeomorph
  exp_one_param_bijection := L.exp_one_param_bijection
  exp_adjoint_conj := L.exp_adjoint_conj
  hasDerivAt_adjoint_exp := L.hasDerivAt_adjoint_exp
  beta_b0 := (11 * (L.casimir_adjoint : ℝ)) / (48 * Real.pi ^ 2)
  beta_b0_eq := rfl
  beta_b0_pos := by
    have hcas : (0 : ℝ) < L.casimir_adjoint := by
      have : 2 ≤ L.casimir_adjoint := L.casimir_adjoint_pos
      exact_mod_cast Nat.lt_of_lt_of_le (by norm_num) this
    positivity
  CoordPoly := CoordPoly d
  commRingCoord := inferInstance
  algebraCoord := inferInstance
  coordDeriv := fun μ => (coordDeriv μ).toLinearMap
  coordDeriv_comm := coordDeriv_comm
  coordDeriv_leibniz := coordDeriv_leibniz
  A_coord := fun μ =>
    { toFun := fun X => ∑ a : Fin d, ((L.lie_inner X (L.B a) : ℝ) : ℂ) • AComp μ a
      map_add' := fun X Y => by simp [map_add, add_smul, Finset.sum_add_distrib]
      map_smul' := fun r X => by
        simp only [LinearMap.map_smul, LinearMap.smul_apply, smul_eq_mul,
          Complex.ofReal_mul, RingHom.id_apply, Finset.smul_sum]
        refine Finset.sum_congr rfl fun a _ => ?_
        rw [← smul_assoc, Complex.real_smul] }
  coord_jet_universal := fun jet h_perm => by
    let jet' : List (Fin 4) → Fin 4 → Fin d → ℂ := fun α ν a => jet α ν (L.B a)
    have h_perm' : ∀ α β, α.Perm β → jet' α = jet' β := fun α β h => by
      simp [jet', h_perm α β h]
    refine ⟨(coordJetEval jet' h_perm').toRingHom, fun c => by simp, fun α ν X => ?_⟩
    have h_fold :
        α.foldr (fun μ P => (coordDeriv μ).toLinearMap P)
            (∑ a : Fin d, ((L.lie_inner X (L.B a) : ℝ) : ℂ) • AComp ν a) =
          ∑ a : Fin d, ((L.lie_inner X (L.B a) : ℝ) : ℂ) •
            (α.foldr (fun μ P => (coordDeriv μ).toLinearMap P) (AComp ν a)) := by
      induction α with
      | nil => simp
      | cons μ α ih => simp only [List.foldr_cons, ih, map_sum, LinearMap.map_smul]
    dsimp only [LinearMap.coe_mk, AddHom.coe_mk]
    rw [h_fold, map_sum]
    have h_eval : ∀ a : Fin d,
        (coordJetEval jet' h_perm').toRingHom
            (((L.lie_inner X (L.B a) : ℝ) : ℂ) •
              α.foldr (fun μ P => (coordDeriv μ).toLinearMap P) (AComp ν a)) =
          ((L.lie_inner X (L.B a) : ℝ) : ℂ) * jet α ν (L.B a) := by
      intro a
      change (coordJetEval jet' h_perm')
          (((L.lie_inner X (L.B a) : ℝ) : ℂ) •
            α.foldr (fun μ P => (coordDeriv μ).toLinearMap P) (MvPolynomial.X (0, ν, a))) = _
      rw [AlgHom.map_smul_of_tower]
      erw [coordJetEval_X_foldr]
      rfl
    simp_rw [h_eval]
    have hX : X = ∑ a : Fin d, L.lie_inner X (L.B a) • L.B a := L.expand X
    conv_rhs => rw [hX, map_sum]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [LinearMap.map_smul, Complex.real_smul]
  CoordPoly_generated := fun S hA hD => by
    refine coordPoly_generated_of_basis S (fun ν a => ?_) hD
    have hB := hA ν (L.B a)
    have h_eq : (∑ i : Fin d, ((L.lie_inner (L.B a) (L.B i) : ℝ) : ℂ) • AComp ν i) =
        MvPolynomial.X (0, ν, a) := by
      simp only [L.orthonormal, apply_ite Complex.ofReal, Complex.ofReal_one, Complex.ofReal_zero,
        ite_smul, one_smul, zero_smul, Finset.sum_ite_eq, Finset.mem_univ, ↓reduceIte, AComp]
    have h_eq' : (∑ i : Fin d, (L.lie_inner (L.B a) (L.B i)) • AComp ν i) =
        AComp ν a := by
      simp only [L.orthonormal, ite_smul, one_smul, zero_smul, Finset.sum_ite_eq,
        Finset.mem_univ, ↓reduceIte]
    dsimp at hB
    rw [h_eq'] at hB
    exact hB
  poly_to_coord := (PolySub L).val
  poly_to_coord_injective := Subtype.coe_injective
  poly_to_coord_algebraMap := fun _ => rfl
  LiePoly := LiePolyVal d L
  addCommGroupLie := inferInstance
  moduleLie := inferInstance
  bracketLiePoly :=
    { bracket := fun Φ Ψ => ⟨bracketAmb L Φ.1 Ψ.1, InLiePoly.bracket Φ.2 Ψ.2⟩ }
  lie_comp :=
    { toFun := fun Φ =>
        { toFun := fun X => ∑ a : Fin d, ((L.lie_inner X (L.B a) : ℝ) : ℂ) • Φ.1 a
          map_add' := fun X Y => by simp [map_add, add_smul, Finset.sum_add_distrib]
          map_smul' := fun r X => by
            simp only [LinearMap.map_smul, LinearMap.smul_apply, smul_eq_mul,
              Complex.ofReal_mul, RingHom.id_apply, Finset.smul_sum]
            refine Finset.sum_congr rfl fun a _ => ?_
            rw [← smul_assoc, Complex.real_smul] }
      map_add' := fun Φ Ψ => by
        ext X; simp [add_smul, smul_add, Finset.sum_add_distrib]
      map_smul' := fun c Φ => by
        ext X; simp [Finset.smul_sum, smul_comm c] }
  lie_comp_injective := fun Φ Ψ h => by
    apply Subtype.ext; funext a
    have ha := congrArg (fun f : L.Lie →ₗ[ℝ] CoordPoly d => f (L.B a)) h
    dsimp at ha
    simp_rw [L.orthonormal] at ha
    simpa using ha
  gauge_action := fun _ => LinearMap.id
  gauge_action_one := fun _ => rfl
  gauge_action_mul := fun _ _ _ => rfl
  lieFiltration := fun d' =>
    { carrier := { Φ : LiePolyVal d L | ambWdeg Φ.1 ≤ d' }
      zero_mem' := by simp [ambWdeg_zero]
      add_mem' := fun {Φ Ψ} hΦ hΨ => le_trans (ambWdeg_add_le Φ.1 Ψ.1) (max_le hΦ hΨ)
      smul_mem' := fun c {Φ} hΦ => by
        by_cases hc : c = 0
        · simp [hc, ambWdeg_zero]
        · change ambWdeg (c • Φ.1) ≤ d'
          rw [ambWdeg_smul hc Φ.1]; exact hΦ }
  lieFiltration_mono := fun _ _ hle _ hΦ => le_trans hΦ hle
  classicalDimLie := fun Φ => ambWdeg Φ.1
  dimLie_zero := ambWdeg_zero
