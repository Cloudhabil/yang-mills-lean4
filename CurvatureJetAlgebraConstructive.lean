      (add_le_add
        (Finset.le_sup (f := fun b => coordWdeg (X.1 b)) (Finset.mem_univ a))
        (Finset.le_sup (f := fun b => coordWdeg (Y.1 b)) (Finset.mem_univ a)))
    exact hmul
  trace_pair_F_dim := fun μ ν h_ne => by
    refine le_antisymm ?_ ?_
    · refine (coordWdeg_le_iff _ _).mpr fun m₀ hm₀ => ?_
      rcases Finset.mem_biUnion.mp (MvPolynomial.support_sum hm₀) with ⟨a, _, hma⟩
      have h1 : coordWdeg (FVec L μ ν a) ≤ 2 :=
        (coordWdeg_le_iff _ _).mpr fun m hm => (FVec_homogeneous_two L μ ν a m hm).le
      exact le_trans ((coordWdeg_le_iff _ _).mp (coordWdeg_mul_le _ _) m₀ hma) (add_le_add h1 h1)
    · have a₀ : Fin d := ⟨0, L.hd⟩
      let v : JetVar d := ({μ}, ν, a₀)
      have h_coeff : (tracePairAmb (FVec L μ ν) (FVec L μ ν)).coeff (Finsupp.single v 2) = 1 := by
        simp only [tracePairAmb, MvPolynomial.coeff_sum]
        have h_term : ∀ a : Fin d,
            (FVec L μ ν a * FVec L μ ν a).coeff (Finsupp.single v 2) = if a = a₀ then 1 else 0 := by
          intro a
          rw [coeff_mul_single_two (coeff_zero_of_inLiePoly L (InLiePoly.F μ ν) a),
            FVec_coeff_single L h_ne a a₀]
          split_ifs <;> simp
        rw [Finset.sum_congr rfl fun a _ => h_term a]
        simp
      have hm : Finsupp.single v 2 ∈ (tracePairAmb (FVec L μ ν) (FVec L μ ν)).support :=
        MvPolynomial.mem_support_iff.mpr (by rw [h_coeff]; exact one_ne_zero)
      have hwt : monWeight (Finsupp.single v 2) = 4 := by
        rw [monWeight_single]; simp [v, jetWeight]
      calc 4 = monWeight (Finsupp.single v 2) := hwt.symm
        _ ≤ coordWdeg (tracePairAmb (FVec L μ ν) (FVec L μ ν)) :=
            (coordWdeg_le_iff _ _).mp le_rfl _ hm
  inv_contract_dim_le := fun m T hT Φ => by
    refine (coordWdeg_le_iff _ _).mpr fun m₀ hm₀ => ?_
    rcases Finset.mem_biUnion.mp (MvPolynomial.support_sum hm₀) with ⟨idx, _, hmidx⟩
    have h_smul_le : ∀ (c : ℂ) (f : CoordPoly d), coordWdeg (c • f) ≤ coordWdeg f := fun c f => by
      by_cases hc : c = 0
      · simp [hc, coordWdeg_zero]
      · rw [coordWdeg_smul c hc]
    have h_prod_le : ∀ (s : Finset (Fin m)) (f : Fin m → CoordPoly d),
        coordWdeg (∏ k ∈ s, f k) ≤ ∑ k ∈ s, coordWdeg (f k) := by
      intro s f
      induction s using Finset.induction with
      | empty => simp [coordWdeg_one]
      | @insert k s hk ih =>
        rw [Finset.prod_insert hk, Finset.sum_insert hk]
        exact le_trans (coordWdeg_mul_le _ _) (add_le_add le_rfl ih)
    have h1 := (coordWdeg_le_iff _ _).mp (h_smul_le _ _) m₀ hmidx
    have h2 := le_trans h1 (h_prod_le Finset.univ _)
    exact le_trans h2 (Finset.sum_le_sum fun k _ =>
      Finset.le_sup (f := fun a => coordWdeg ((Φ k).1 a)) (Finset.mem_univ (idx k)))
  inv_contract_F_dim := fun m T hT μ ν h_ne h_nz => by
    have h_homog : ∀ m₀ ∈ (invContractAmb L m T (fun k => FVec L (μ k) (ν k))).support,
        monWeight m₀ = 2 * m := by
      intro m₀ hm₀
      rcases Finset.mem_biUnion.mp (MvPolynomial.support_sum hm₀) with ⟨idx, _, hmidx⟩
      have hm_prod : m₀ ∈ (∏ k : Fin m, FVec L (μ k) (ν k) (idx k)).support := by
        rw [MvPolynomial.mem_support_iff] at hmidx ⊢
        intro hc
        rw [MvPolynomial.coeff_smul, smul_eq_mul, hc, mul_zero] at hmidx
        exact hmidx rfl
      clear hmidx hm₀
      have h_prod_homog : ∀ (s : Finset (Fin m)) (m₁ : JetVar d →₀ ℕ),
          m₁ ∈ (∏ k ∈ s, FVec L (μ k) (ν k) (idx k)).support →
          monWeight m₁ = 2 * s.card := by
        intro s
        induction s using Finset.induction with
        | empty =>
          intro m₁ hm₁
          simp only [Finset.prod_empty, MvPolynomial.support_one, Finset.mem_singleton] at hm₁
          rw [hm₁, monWeight_zero, Finset.card_empty, mul_zero]
        | @insert k s hk ih =>
          intro m₁ hm₁
          rw [Finset.prod_insert hk] at hm₁
          rcases Finset.mem_add.mp (MvPolynomial.support_mul _ _ hm₁) with ⟨m₂, hm₂, m₃, hm₃, rfl⟩
          rw [monWeight_add, FVec_homogeneous_two L (μ k) (ν k) (idx k) m₂ hm₂,
            ih m₃ hm₃, Finset.card_insert_of_notMem hk]
          ring
      simpa using h_prod_homog Finset.univ m₀ hm_prod
    refine le_antisymm ?_ ?_
    · exact (coordWdeg_le_iff _ _).mpr fun m₀ hm₀ => (h_homog m₀ hm₀).le
    · have h_supp : (invContractAmb L m T (fun k => FVec L (μ k) (ν k))).support.Nonempty :=
        MvPolynomial.support_nonempty.mpr (fun h => h_nz (Subtype.ext h))
      rcases h_supp with ⟨m₀, hm₀⟩
      calc 2 * m = monWeight m₀ := (h_homog m₀ hm₀).symm
        _ ≤ coordWdeg (invContractAmb L m T (fun k => FVec L (μ k) (ν k))) :=
            (coordWdeg_le_iff _ _).mp le_rfl m₀ hm₀
  Poly_generated_by_inv_contract := fun S h1 h_tr h_inv h_mul => by
    rw [eq_top_iff]
    intro P hP
    clear hP
    rcases P with ⟨p, hp⟩
    induction hp with
    | of_complex c =>
      have hc : (⟨algebraMap ℂ (CoordPoly d) c, InPoly.of_complex c⟩ : PolyVal d L) = c • 1 :=
        Subtype.ext (Algebra.algebraMap_eq_smul_one c)
      rw [hc]
      exact S.smul_mem c h1
    | trace_pair hX hY => exact h_tr ⟨_, hX⟩ ⟨_, hY⟩
    | inv_contract m T hT hΦ => exact h_inv m T hT (fun k => ⟨_, hΦ k⟩)
    | add h1' h2' ih1 ih2 => exact S.add_mem (ih1 : ⟨_, h1'⟩ ∈ S) (ih2 : ⟨_, h2'⟩ ∈ S)
    | mul h1' h2' ih1 ih2 => exact h_mul ⟨_, h1'⟩ ⟨_, h2'⟩ ih1 ih2
  transformLie := fun R =>
    { toFun := fun Φ => ⟨transformAmb R Φ.1, transformAmb_inLiePoly L R Φ.2⟩
      map_add' := fun Φ Ψ => Subtype.ext (map_add (transformAmb R) Φ.1 Ψ.1)
      map_smul' := fun c Φ => Subtype.ext (map_smul (transformAmb R) c Φ.1) }
  transformLie_id := by ext Φ a; simp [transformAmb, transformCoord_one]
  transformLie_mul := fun R₁ R₂ _ _ => by
    ext Φ a; simp [transformAmb, transformCoord_mul]
  transformLie_F := fun R μ ν _ => Subtype.ext (transformAmb_FVec L R μ ν)
  transformLie_covDeriv := fun R μ Φ _ => Subtype.ext (transformAmb_covDerivAmb L R μ Φ.1)
  transformLie_bracket := fun R Φ Ψ => Subtype.ext (transformAmb_bracketAmb L R Φ.1 Ψ.1)
  transform := fun R =>
    { toFun := fun P => ⟨transformCoord R P.1, transformCoord_inPoly L R P.2⟩
      map_add' := fun P Q => Subtype.ext (map_add (transformCoord R) P.1 Q.1)
      map_smul' := fun c P => Subtype.ext (AlgHom.map_smul_of_tower (transformCoord R) c P.1) }
  transform_id := by ext P; simp [transformCoord_one]
  transform_mul := fun R₁ R₂ _ _ => by ext P; simp [transformCoord_mul]
  transform_one := fun R => Subtype.ext (map_one (transformCoord R))
  transform_prod := fun R P Q => Subtype.ext (map_mul (transformCoord R) P.1 Q.1)
  transform_trace_pair := fun R Φ Ψ => Subtype.ext (by
    simp [tracePairAmb, transformAmb, map_sum, map_mul])
  transform_inv_contract := fun R m T hT Φ => Subtype.ext (by
    simp [invContractAmb, transformAmb, map_sum, AlgHom.map_smul_of_tower, map_prod])
  transform_dim := fun R P => coordWdeg_transformCoord_le R P.1
  conj_inv_contract_F := fun m T hT μ ν => Subtype.ext (by
    have h_smul : ∀ (r : ℝ) (f : CoordPoly d), coordConj ((r : ℂ) • f) = (r : ℂ) • coordConj f := by
      intro r f
      simp only [Algebra.smul_def, map_mul]
      change coordConj (MvPolynomial.C (r : ℂ)) * coordConj f = MvPolynomial.C (r : ℂ) * coordConj f
      rw [coordConj_C, Complex.conj_ofReal]
    have hF : ∀ k a, coordConj (FVec L (μ k) (ν k) a) = FVec L (μ k) (ν k) a :=
      fun k a => congrFun (conjAmb_FVec L (μ k) (ν k)) a
    change coordConj (invContractAmb L m T (fun k => FVec L (μ k) (ν k))) =
      invContractAmb L m T (fun k => FVec L (μ k) (ν k))
    dsimp only [invContractAmb]
    rw [map_sum]
    refine Finset.sum_congr rfl fun idx _ => ?_
    rw [h_smul, map_prod]
    congr 1
    exact Finset.prod_congr rfl fun k _ => hF k (idx k))
  tr_F_sq := ⟨trFSqAmb L, trFSqAmb_inPoly L⟩
  tr_F_sq_nonzero := fun h => trFSqAmb_nonzero L (congrArg Subtype.val h)
  tr_F_sq_dim := by
    have h_le : coordWdeg (trFSqAmb L) ≤ 4 := by
      refine (coordWdeg_le_iff _ _).mpr fun m hm => ?_
      rcases Finset.mem_biUnion.mp (MvPolynomial.support_sum hm) with ⟨α, _, hmα⟩
      rcases Finset.mem_biUnion.mp (MvPolynomial.support_sum hmα) with ⟨β, _, hmβ⟩
      have h_sub : coordWdeg (tracePairAmb (FVec L α β) (FVec L α β)) ≤ 4 := by
        refine (coordWdeg_le_iff _ _).mpr fun m'' hm'' => ?_
        rcases Finset.mem_biUnion.mp (MvPolynomial.support_sum hm'') with ⟨a, _, hma⟩
        have h1 : coordWdeg (FVec L α β a) ≤ 2 :=
          (coordWdeg_le_iff _ _).mpr fun m1 hm1 => (FVec_homogeneous_two L α β a m1 hm1).le
        have hmul := le_trans (coordWdeg_mul_le (FVec L α β a) (FVec L α β a)) (add_le_add h1 h1)
        exact le_trans ((coordWdeg_le_iff _ _).mp hmul m'' hma) (by omega)
      by_cases hc : ((minkowskiMetric α α * minkowskiMetric β β : ℝ) : ℂ) = 0
      · rw [hc, zero_smul] at hmβ; simp at hmβ
      · rw [← coordWdeg_smul _ hc] at h_sub
        exact (coordWdeg_le_iff _ _).mp h_sub m hmβ
    refine le_antisymm h_le ?_
    have hm : Finsupp.single ({(0 : Fin 4)}, (1 : Fin 4), ⟨0, L.hd⟩) 2 ∈ (trFSqAmb L).support := by
      rw [MvPolynomial.mem_support_iff, trFSqAmb_coeff_single_two L 0 1 (by decide)]
      simp [minkowskiMetric, toCoords, vec4, ofCoords]
    have hwt : monWeight (Finsupp.single ({(0 : Fin 4)}, (1 : Fin 4), ⟨0, L.hd⟩) 2) = 4 := by
      rw [monWeight_single]; simp [jetWeight]
    calc 4 = monWeight (Finsupp.single ({(0 : Fin 4)}, (1 : Fin 4), ⟨0, L.hd⟩) 2) := hwt.symm
      _ ≤ coordWdeg (trFSqAmb L) := (coordWdeg_le_iff _ _).mp le_rfl _ hm
  tr_F_sq_self_conj := Subtype.ext (by
    have h_smul : ∀ (r : ℝ) (f : CoordPoly d), coordConj ((r : ℂ) • f) = (r : ℂ) • coordConj f := by
      intro r f
      simp only [Algebra.smul_def, map_mul]
      change coordConj (MvPolynomial.C (r : ℂ)) * coordConj f = MvPolynomial.C (r : ℂ) * coordConj f
      rw [coordConj_C, Complex.conj_ofReal]
    dsimp only [trFSqAmb, tracePairAmb]
    rw [map_sum]
    refine Finset.sum_congr rfl fun μ _ => ?_
    rw [map_sum]
    refine Finset.sum_congr rfl fun ν _ => ?_
    rw [h_smul]
    congr 1
    rw [map_sum]
    refine Finset.sum_congr rfl fun a _ => ?_
    rw [map_mul]
    have hF : coordConj (FVec L μ ν a) = FVec L μ ν a := congrFun (conjAmb_FVec L μ ν) a
    rw [hF])
  tr_F_sq_def := Subtype.ext rfl
  stress_energy := fun μ ν => ⟨stressEnergyAmb L μ ν, stressEnergyAmb_inPoly L μ ν⟩
  stress_energy_symm := fun μ ν => Subtype.ext (stressEnergyAmb_symm L μ ν)
  stress_energy_dim := fun μ ν => stressEnergyAmb_dim L μ ν
  stress_energy_00_nonzero := fun h => by
    have hdim := stressEnergyAmb_dim L 0 0
    have h0 : stressEnergyAmb L 0 0 = 0 := congrArg Subtype.val h
    rw [h0, coordWdeg_zero] at hdim
    omega
  stress_energy_self_conj := fun μ ν => Subtype.ext (by
    have h_smul : ∀ (r : ℝ) (f : CoordPoly d), coordConj ((r : ℂ) • f) = (r : ℂ) • coordConj f := by
      intro r f
      simp only [Algebra.smul_def, map_mul]
      change coordConj (MvPolynomial.C (r : ℂ)) * coordConj f = MvPolynomial.C (r : ℂ) * coordConj f
      rw [coordConj_C, Complex.conj_ofReal]
    have hF : ∀ α β a, coordConj (FVec L α β a) = FVec L α β a :=
      fun α β a => congrFun (conjAmb_FVec L α β) a
    have h_tr : ∀ α β, coordConj (tracePairAmb (FVec L α β) (FVec L α β)) =
        tracePairAmb (FVec L α β) (FVec L α β) := fun α β => by
      dsimp only [tracePairAmb]
      rw [map_sum]
      exact Finset.sum_congr rfl fun a _ => by rw [map_mul, hF α β a]
    dsimp only [stressEnergyAmb]
    rw [map_add, map_sum, h_smul]
    refine congrArg₂ (· + ·) (Finset.sum_congr rfl fun α _ => ?_) (congrArg _ ?_)
    · rw [h_smul]; congr 1
      dsimp only [tracePairAmb]; rw [map_sum]
      exact Finset.sum_congr rfl fun a _ => by rw [map_mul, hF μ α a, hF ν α a]
    · dsimp only [trFSqAmb]; rw [map_sum]
      refine Finset.sum_congr rfl fun α _ => ?_
      rw [map_sum]
      exact Finset.sum_congr rfl fun β _ => by rw [h_smul, h_tr α β])
  stress_energy_def := fun μ ν => Subtype.ext rfl
  dim_gauge := Module.finrank ℝ L.Lie
  uv_two_point_coeff := fun P =>
    (48 * (Module.finrank ℝ L.Lie : ℝ) / (Real.pi ^ 4)) *
      (polyNormSq P.1 / polyNormSq (trFSqAmb L))
  uv_two_point_coeff_pos := fun P hP => by
    have hP' : P.1 ≠ 0 := fun h => hP (Subtype.ext h)
    have h1 : 0 < (Module.finrank ℝ L.Lie : ℝ) := by
      rw [lie_finrank_eq L]; exact_mod_cast L.hd
    have h2 : 0 < Real.pi ^ 4 := pow_pos Real.pi_pos 4
    have h3 : 0 < polyNormSq P.1 := polyNormSq_pos hP'
    have h4 : 0 < polyNormSq (trFSqAmb L) := polyNormSq_pos (trFSqAmb_nonzero L)
    positivity
  uv_two_point_tr_F_sq_eq := by
    have h4 : polyNormSq (trFSqAmb L) ≠ 0 := (polyNormSq_pos (trFSqAmb_nonzero L)).ne'
    change (48 * (Module.finrank ℝ L.Lie : ℝ) / (Real.pi ^ 4)) *
      (polyNormSq (trFSqAmb L) / polyNormSq (trFSqAmb L)) = _
    rw [div_self h4, mul_one]
  anomalous_exponent := fun _ => 0
  anomalous_tr_F_sq := rfl
  anomalous_stress_energy := fun _ _ => rfl
  ope_coeff := fun P Q R z =>
    if z = 0 then 0
    else ((‖z‖ : ℝ) : ℂ) ^ ((coordWdeg R.1 : ℤ) - (coordWdeg P.1 : ℤ) - (coordWdeg Q.1 : ℤ))
  ope_coeff_scaling := fun P Q R scale z hscale => by
    have hzpow : ∀ (a b : ℂ) (n : ℤ), (a * b) ^ n = a ^ n * b ^ n := mul_zpow
    by_cases hz : z = 0
    · simp [hz]
    · have hsz : scale • z ≠ 0 := smul_ne_zero hscale.ne' hz
      have hnorm : ((‖scale • z‖ : ℝ) : ℂ) = (scale : ℂ) * ((‖z‖ : ℝ) : ℂ) := by
        rw [norm_smul, Real.norm_of_nonneg hscale.le, Complex.ofReal_mul]
      simp only [hz, hsz, ↓reduceIte, hnorm]
      exact hzpow (scale : ℂ) ((‖z‖ : ℝ) : ℂ)
        ((coordWdeg R.1 : ℤ) - (coordWdeg P.1 : ℤ) - (coordWdeg Q.1 : ℤ))

end BuildCurvature

section SU3Instance

open YangMills.LieGroups

/-- Inner product on `LieSU 3`: `⟨X, Y⟩ = -2 * Re(Tr(X Y))`. -/
private def su3InnerFun (X Y : LieSU 3) : ℝ :=
  -2 * (Matrix.trace (X.1 * Y.1)).re

private noncomputable def su3Inner : LieSU 3 →ₗ[ℝ] LieSU 3 →ₗ[ℝ] ℝ where
  toFun X :=
    { toFun := fun Y => su3InnerFun X Y
      map_add' := fun Y Z => by
        simp only [su3InnerFun, Submodule.coe_add, Matrix.mul_add, Matrix.trace_add,
          Complex.add_re, mul_add]
      map_smul' := fun c Y => by
        simp only [su3InnerFun, SetLike.val_smul, Matrix.mul_smul, Matrix.trace_smul,
          smul_eq_mul, Complex.real_smul, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im,
          zero_mul, sub_zero, RingHom.id_apply]
        ring }
  map_add' X₁ X₂ := by
    ext Y
    simp only [LinearMap.coe_mk, AddHom.coe_mk, LinearMap.add_apply, su3InnerFun,
      Submodule.coe_add, Matrix.add_mul, Matrix.trace_add, Complex.add_re, mul_add]
  map_smul' c X := by
    ext Y
    simp only [LinearMap.coe_mk, AddHom.coe_mk, LinearMap.smul_apply, smul_eq_mul,
      RingHom.id_apply, su3InnerFun, SetLike.val_smul, Matrix.smul_mul, Matrix.trace_smul,
      Complex.real_smul, Complex.mul_re, Complex.ofReal_re, Complex.ofReal_im, zero_mul, sub_zero]
    ring

private theorem su3Inner_symm (X Y : LieSU 3) : su3Inner X Y = su3Inner Y X := by
  simp only [su3Inner, LinearMap.coe_mk, AddHom.coe_mk, su3InnerFun]
  rw [Matrix.trace_mul_comm]

private theorem su3Inner_pos (X : LieSU 3) (hX : X ≠ 0) : 0 < su3Inner X X := by
  have h_skew : star X.1 = -X.1 := X.2.1
  have h_val : X.1 ≠ 0 := fun h => hX (Subtype.ext h)
  have h_tr : su3Inner X X = 2 * ∑ i : Fin 3, ∑ j : Fin 3, ‖X.1 i j‖ ^ 2 := by
    simp only [su3Inner, LinearMap.coe_mk, AddHom.coe_mk, su3InnerFun]
    have h_eq : Matrix.trace (X.1 * X.1) = - Matrix.trace (star X.1 * X.1) := by
      calc Matrix.trace (X.1 * X.1)
          = Matrix.trace (-(-X.1) * X.1) := by rw [neg_neg]
        _ = Matrix.trace (-star X.1 * X.1) := by rw [h_skew]
        _ = - Matrix.trace (star X.1 * X.1) := by rw [Matrix.neg_mul, Matrix.trace_neg]
    rw [h_eq, Complex.neg_re]
    have h_lhs : -2 * -(Matrix.trace (star X.1 * X.1)).re =
        2 * (Matrix.trace (star X.1 * X.1)).re := by ring
    rw [h_lhs]
    congr 1
    simp only [Matrix.trace, Matrix.diag, Matrix.mul_apply, Matrix.star_apply, RCLike.star_def]
    rw [Complex.re_sum, Finset.sum_comm]
    refine Finset.sum_congr rfl fun j _ => ?_
    rw [Complex.re_sum]
    refine Finset.sum_congr rfl fun i _ => ?_
    simp [Complex.conj_mul', ← Complex.ofReal_pow]
  rw [h_tr]
  obtain ⟨i, j, hij⟩ : ∃ i j : Fin 3, X.1 i j ≠ 0 := by
    by_contra h_all
    push Not at h_all
    exact h_val (Matrix.ext h_all)
  have h_pos : 0 < ‖X.1 i j‖ ^ 2 := sq_pos_of_pos (norm_pos_iff.mpr hij)
  have h_nn : ∀ a b : Fin 3, 0 ≤ ‖X.1 a b‖ ^ 2 := fun a b => sq_nonneg _
  have h_sum_j : 0 < ∑ b : Fin 3, ‖X.1 i b‖ ^ 2 :=
    Finset.sum_pos' (fun b _ => h_nn i b) ⟨j, Finset.mem_univ j, h_pos⟩
  have h_sum_i : 0 < ∑ a : Fin 3, ∑ b : Fin 3, ‖X.1 a b‖ ^ 2 :=
    Finset.sum_pos' (fun a _ => Finset.sum_nonneg fun b _ => h_nn a b) ⟨i, Finset.mem_univ i, h_sum_j⟩
  linarith

private def su3Adjoint (g : SU3) : LieSU 3 →ₗ[ℝ] LieSU 3 where
  toFun := sunAdjoint 3 g
  map_add' X Y := by
    apply Subtype.ext
    simp only [sunAdjoint, Submodule.coe_add, Matrix.mul_add, Matrix.add_mul]
  map_smul' c X := by
    apply Subtype.ext
    simp only [sunAdjoint, SetLike.val_smul, Matrix.mul_smul, Matrix.smul_mul, RingHom.id_apply]

private theorem su3Adjoint_one : su3Adjoint 1 = LinearMap.id := by
  ext X i j
  simp [su3Adjoint, sunAdjoint]

private theorem su3Adjoint_mul (g h : SU3) (X : LieSU 3) :
    su3Adjoint (g * h) X = su3Adjoint g (su3Adjoint h X) := by
  apply Subtype.ext
  simp only [su3Adjoint, LinearMap.coe_mk, AddHom.coe_mk, sunAdjoint, Submonoid.coe_mul,
    star_mul, Matrix.mul_assoc]

private theorem su3Adjoint_bracket (g : SU3) (X Y : LieSU 3) :
    su3Adjoint g ⁅X, Y⁆ = ⁅su3Adjoint g X, su3Adjoint g Y⁆ := by
  apply Subtype.ext
  have hg : star g.1 * g.1 = 1 := by
    rcases Matrix.mem_specialUnitaryGroup_iff.mp g.2 with ⟨h1, _⟩
    exact Matrix.mem_unitaryGroup_iff'.mp h1
  simp only [su3Adjoint, LinearMap.coe_mk, AddHom.coe_mk, sunAdjoint]
  change g.1 * (X.1 * Y.1 - Y.1 * X.1) * star g.1 =
    (g.1 * X.1 * star g.1) * (g.1 * Y.1 * star g.1) -
    (g.1 * Y.1 * star g.1) * (g.1 * X.1 * star g.1)
  have h1 : (g.1 * X.1 * star g.1) * (g.1 * Y.1 * star g.1) = g.1 * (X.1 * Y.1) * star g.1 := by
    calc g.1 * X.1 * star g.1 * (g.1 * Y.1 * star g.1)
        = g.1 * X.1 * (star g.1 * g.1) * Y.1 * star g.1 := by simp only [Matrix.mul_assoc]
      _ = g.1 * (X.1 * Y.1) * star g.1 := by rw [hg, Matrix.mul_one]; simp only [Matrix.mul_assoc]
  have h2 : (g.1 * Y.1 * star g.1) * (g.1 * X.1 * star g.1) = g.1 * (Y.1 * X.1) * star g.1 := by
    calc g.1 * Y.1 * star g.1 * (g.1 * X.1 * star g.1)
        = g.1 * Y.1 * (star g.1 * g.1) * X.1 * star g.1 := by simp only [Matrix.mul_assoc]
      _ = g.1 * (Y.1 * X.1) * star g.1 := by rw [hg, Matrix.mul_one]; simp only [Matrix.mul_assoc]
  rw [h1, h2, Matrix.mul_sub, Matrix.sub_mul]

private theorem su3Inner_ad_inv (g : SU3) (X Y : LieSU 3) :
    su3Inner (su3Adjoint g X) (su3Adjoint g Y) = su3Inner X Y := by
  have hg : star g.1 * g.1 = 1 := by
    rcases Matrix.mem_specialUnitaryGroup_iff.mp g.2 with ⟨h1, _⟩
    exact Matrix.mem_unitaryGroup_iff'.mp h1
  simp only [su3Inner, LinearMap.coe_mk, AddHom.coe_mk, su3InnerFun, su3Adjoint, sunAdjoint]
  have h_prod : (g.1 * X.1 * star g.1) * (g.1 * Y.1 * star g.1) = g.1 * (X.1 * Y.1) * star g.1 := by
    calc g.1 * X.1 * star g.1 * (g.1 * Y.1 * star g.1)
        = g.1 * X.1 * (star g.1 * g.1) * Y.1 * star g.1 := by simp only [Matrix.mul_assoc]
      _ = g.1 * (X.1 * Y.1) * star g.1 := by rw [hg, Matrix.mul_one]; simp only [Matrix.mul_assoc]
  rw [h_prod, Matrix.trace_mul_comm (g.1 * (X.1 * Y.1)) (star g.1), ← Matrix.mul_assoc,
    ← Matrix.mul_assoc, hg, Matrix.one_mul]

private theorem su3Inner_ad_skew (Y X Z : LieSU 3) :
    su3Inner ⁅Y, X⁆ Z + su3Inner X ⁅Y, Z⁆ = 0 := by
  simp only [su3Inner, LinearMap.coe_mk, AddHom.coe_mk, su3InnerFun]
  have h1 : (Y.1 * X.1 - X.1 * Y.1) * Z.1 + X.1 * (Y.1 * Z.1 - Z.1 * Y.1) =
      Y.1 * (X.1 * Z.1) - (X.1 * Z.1) * Y.1 := by
    noncomm_ring
  have h_tr : Matrix.trace ((Y.1 * X.1 - X.1 * Y.1) * Z.1) +
      Matrix.trace (X.1 * (Y.1 * Z.1 - Z.1 * Y.1)) = 0 := by
    rw [← Matrix.trace_add, h1, Matrix.trace_sub, Matrix.trace_mul_comm Y.1 (X.1 * Z.1), sub_self]
  have h_re := congrArg Complex.re h_tr
  simp only [Complex.add_re, Complex.zero_re] at h_re
  change -2 * (Matrix.trace ((Y.1 * X.1 - X.1 * Y.1) * Z.1)).re +
      -2 * (Matrix.trace (X.1 * (Y.1 * Z.1 - Z.1 * Y.1))).re = 0
  linarith

/-- Explicit orthonormal Gell-Mann basis `B_a = (-I / 2) λ_a` for `LieSU 3`. -/
private noncomputable def su3BasisMat (a : Fin 8) : Matrix (Fin 3) (Fin 3) ℂ :=
  let s3 : ℂ := ((Real.sqrt 3 : ℝ) : ℂ)
  match a with
  | 0 => !![0, -Complex.I / 2, 0; -Complex.I / 2, 0, 0; 0, 0, 0]
  | 1 => !![0, -1 / 2, 0; 1 / 2, 0, 0; 0, 0, 0]
  | 2 => !![-Complex.I / 2, 0, 0; 0, Complex.I / 2, 0; 0, 0, 0]
  | 3 => !![0, 0, -Complex.I / 2; 0, 0, 0; -Complex.I / 2, 0, 0]
  | 4 => !![0, 0, -1 / 2; 0, 0, 0; 1 / 2, 0, 0]
  | 5 => !![0, 0, 0; 0, 0, -Complex.I / 2; 0, -Complex.I / 2, 0]
  | 6 => !![0, 0, 0; 0, 0, -1 / 2; 0, 1 / 2, 0]
  | 7 => !![-Complex.I / (2 * s3), 0, 0; 0, -Complex.I / (2 * s3), 0; 0, 0, Complex.I / s3]

private theorem su3BasisMat_mem (a : Fin 8) : su3BasisMat a ∈ LieSU 3 := by
  refine ⟨?_, ?_⟩
  · ext i j
    fin_cases a <;> fin_cases i <;> fin_cases j <;>
      simp [su3BasisMat, Matrix.star_apply, Complex.conj_ofReal] <;> ring
  · fin_cases a <;>
      simp [su3BasisMat, Matrix.trace, Fin.sum_univ_three] <;> ring

private noncomputable def su3Basis (a : Fin 8) : LieSU 3 :=
  ⟨su3BasisMat a, su3BasisMat_mem a⟩

private theorem su3Basis_orthonormal (a b : Fin 8) :
    su3Inner (su3Basis a) (su3Basis b) = if a = b then 1 else 0 := by
  have hs3 : (Real.sqrt 3) ^ 2 = 3 := Real.sq_sqrt (by norm_num)
  have hs3_ne : (Real.sqrt 3 : ℝ) ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr (by norm_num))
  simp only [su3Inner, LinearMap.coe_mk, AddHom.coe_mk, su3InnerFun, su3Basis]
  fin_cases a <;> fin_cases b <;>
    simp [su3BasisMat, Matrix.trace, Fin.sum_univ_three, Matrix.mul_apply,
      Complex.div_re, Complex.div_im, Complex.mul_re, Complex.mul_im] <;>
    field_simp [hs3_ne] <;>
    nlinarith [hs3]

private theorem su3Inner_basis0 (X : LieSU 3) :
    su3Inner X (su3Basis 0) = -2 * (X.1 0 1).im := by
  have h01 : star (X.1 0 1) = - X.1 1 0 := by
    have h := congrArg (fun M : Matrix (Fin 3) (Fin 3) ℂ => M 1 0) X.2.1
    simpa [Matrix.star_apply] using h
  have h10_im : (X.1 1 0).im = (X.1 0 1).im := by
    have h := congrArg Complex.im h01; simp at h; linarith
  simp [su3Inner, su3InnerFun, su3Basis, su3BasisMat, Matrix.trace, Fin.sum_univ_three,
    Matrix.mul_apply, h10_im]
  ring

private theorem su3Inner_basis1 (X : LieSU 3) :
    su3Inner X (su3Basis 1) = -2 * (X.1 0 1).re := by
  have h01 : star (X.1 0 1) = - X.1 1 0 := by
    have h := congrArg (fun M : Matrix (Fin 3) (Fin 3) ℂ => M 1 0) X.2.1
    simpa [Matrix.star_apply] using h
  have h10_re : (X.1 1 0).re = - (X.1 0 1).re := by
    have h := congrArg Complex.re h01; simp at h; linarith
  simp [su3Inner, su3InnerFun, su3Basis, su3BasisMat, Matrix.trace, Fin.sum_univ_three,
    Matrix.mul_apply, h10_re]
  ring

private theorem su3Inner_basis2 (X : LieSU 3) :
    su3Inner X (su3Basis 2) = (X.1 1 1).im - (X.1 0 0).im := by
  simp [su3Inner, su3InnerFun, su3Basis, su3BasisMat, Matrix.trace, Fin.sum_univ_three,
    Matrix.mul_apply]
  ring

private theorem su3Inner_basis3 (X : LieSU 3) :
    su3Inner X (su3Basis 3) = -2 * (X.1 0 2).im := by
  have h02 : star (X.1 0 2) = - X.1 2 0 := by
    have h := congrArg (fun M : Matrix (Fin 3) (Fin 3) ℂ => M 2 0) X.2.1
    simpa [Matrix.star_apply] using h
  have h20_im : (X.1 2 0).im = (X.1 0 2).im := by
    have h := congrArg Complex.im h02; simp at h; linarith
  simp [su3Inner, su3InnerFun, su3Basis, su3BasisMat, Matrix.trace, Fin.sum_univ_three,
    Matrix.mul_apply, h20_im]
  ring

private theorem su3Inner_basis4 (X : LieSU 3) :
    su3Inner X (su3Basis 4) = -2 * (X.1 0 2).re := by
  have h02 : star (X.1 0 2) = - X.1 2 0 := by
    have h := congrArg (fun M : Matrix (Fin 3) (Fin 3) ℂ => M 2 0) X.2.1
    simpa [Matrix.star_apply] using h
  have h20_re : (X.1 2 0).re = - (X.1 0 2).re := by
    have h := congrArg Complex.re h02; simp at h; linarith
  simp [su3Inner, su3InnerFun, su3Basis, su3BasisMat, Matrix.trace, Fin.sum_univ_three,
    Matrix.mul_apply, h20_re]
  ring

private theorem su3Inner_basis5 (X : LieSU 3) :
    su3Inner X (su3Basis 5) = -2 * (X.1 1 2).im := by
  have h12 : star (X.1 1 2) = - X.1 2 1 := by
    have h := congrArg (fun M : Matrix (Fin 3) (Fin 3) ℂ => M 2 1) X.2.1
    simpa [Matrix.star_apply] using h
  have h21_im : (X.1 2 1).im = (X.1 1 2).im := by
    have h := congrArg Complex.im h12; simp at h; linarith
  simp [su3Inner, su3InnerFun, su3Basis, su3BasisMat, Matrix.trace, Fin.sum_univ_three,
    Matrix.mul_apply, h21_im]
  ring

private theorem su3Inner_basis6 (X : LieSU 3) :
    su3Inner X (su3Basis 6) = -2 * (X.1 1 2).re := by
  have h12 : star (X.1 1 2) = - X.1 2 1 := by
    have h := congrArg (fun M : Matrix (Fin 3) (Fin 3) ℂ => M 2 1) X.2.1
    simpa [Matrix.star_apply] using h
  have h21_re : (X.1 2 1).re = - (X.1 1 2).re := by
    have h := congrArg Complex.re h12; simp at h; linarith
  simp [su3Inner, su3InnerFun, su3Basis, su3BasisMat, Matrix.trace, Fin.sum_univ_three,
    Matrix.mul_apply, h21_re]
  ring

private theorem su3Inner_basis7 (X : LieSU 3) :
    su3Inner X (su3Basis 7) = - Real.sqrt 3 * ((X.1 0 0).im + (X.1 1 1).im) := by
  have hs3 : (Real.sqrt 3) ^ 2 = 3 := Real.sq_sqrt (by norm_num)
  have hs3_ne : (Real.sqrt 3 : ℝ) ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr (by norm_num))
  have h_tr : X.1 0 0 + X.1 1 1 + X.1 2 2 = 0 := by
    simpa [Matrix.trace, Fin.sum_univ_three, add_assoc] using X.2.2
  have h22_im : (X.1 2 2).im = - (X.1 0 0).im - (X.1 1 1).im := by
    have h := congrArg Complex.im h_tr; simp at h; linarith
  simp [su3Inner, su3InnerFun, su3Basis, su3BasisMat, Matrix.trace, Fin.sum_univ_three,
    Matrix.mul_apply, Complex.div_re, Complex.div_im, h22_im]
  field_simp [hs3_ne]
  nlinarith [hs3]

set_option maxHeartbeats 800000 in
private theorem su3_expand (X : LieSU 3) :
    X = ∑ a : Fin 8, su3Inner X (su3Basis a) • su3Basis a := by
  have hs3 : (Real.sqrt 3) ^ 2 = 3 := Real.sq_sqrt (by norm_num)
  have hs3_ne : (Real.sqrt 3 : ℝ) ≠ 0 := ne_of_gt (Real.sqrt_pos.mpr (by norm_num))
  have h_skew : ∀ i j : Fin 3, star (X.1 j i) = - X.1 i j := fun i j => by
    have h := congrArg (fun M : Matrix (Fin 3) (Fin 3) ℂ => M i j) X.2.1
    simpa [Matrix.star_apply] using h
  have h_tr : X.1 0 0 + X.1 1 1 + X.1 2 2 = 0 := by
    simpa [Matrix.trace, Fin.sum_univ_three, add_assoc] using X.2.2
  have h00_re : (X.1 0 0).re = 0 := by
    have h := congrArg Complex.re (h_skew 0 0); simp at h; linarith
  have h11_re : (X.1 1 1).re = 0 := by
    have h := congrArg Complex.re (h_skew 1 1); simp at h; linarith
  have h22_re : (X.1 2 2).re = 0 := by
    have h := congrArg Complex.re (h_skew 2 2); simp at h; linarith
  have h22_im : (X.1 2 2).im = - (X.1 0 0).im - (X.1 1 1).im := by
    have h := congrArg Complex.im h_tr; simp at h; linarith
  have h10_re : (X.1 1 0).re = - (X.1 0 1).re := by
    have h := congrArg Complex.re (h_skew 0 1); simpa using h
  have h10_im : (X.1 1 0).im = (X.1 0 1).im := by
    have h := congrArg Complex.im (h_skew 0 1); simpa using h
  have h20_re : (X.1 2 0).re = - (X.1 0 2).re := by
    have h := congrArg Complex.re (h_skew 0 2); simpa using h
  have h20_im : (X.1 2 0).im = (X.1 0 2).im := by
    have h := congrArg Complex.im (h_skew 0 2); simpa using h
  have h21_re : (X.1 2 1).re = - (X.1 1 2).re := by
    have h := congrArg Complex.re (h_skew 1 2); simpa using h
  have h21_im : (X.1 2 1).im = (X.1 1 2).im := by
    have h := congrArg Complex.im (h_skew 1 2); simpa using h
  apply Subtype.ext
  ext i j
  fin_cases i <;> fin_cases j <;>
    (simp only [Submodule.coe_sum, SetLike.val_smul, Matrix.sum_apply, Matrix.smul_apply,
       Fin.sum_univ_eight, su3Inner_basis0, su3Inner_basis1, su3Inner_basis2, su3Inner_basis3,
       su3Inner_basis4, su3Inner_basis5, su3Inner_basis6, su3Inner_basis7];
     simp only [su3Basis];
     apply Complex.ext <;>
     simp [su3BasisMat, Complex.div_re, Complex.div_im, h00_re, h11_re, h22_re, h22_im,
       h10_re, h10_im, h20_re, h20_im, h21_re, h21_im] <;>
     (try (ring; done)) <;>
     (try (ring_nf; rw [hs3]; ring; done)) <;>
     (try (field_simp [hs3_ne]; ring_nf; rw [hs3]; ring; done)) <;>
     norm_num)

private theorem su3_su2_triple :
    ∃ (X Y Z : LieSU 3),
      ⁅X, Y⁆ = Z ∧ ⁅Y, Z⁆ = X ∧ ⁅Z, X⁆ = Y ∧ su3Inner X X = 1 ∧
      ∀ X' Y' Z' : LieSU 3, X' ≠ 0 → ⁅X', Y'⁆ = Z' → ⁅Y', Z'⁆ = X' → ⁅Z', X'⁆ = Y' →
        1 ≤ su3Inner X' X' := by
  refine ⟨su3Basis 0, su3Basis 1, su3Basis 2, ?_, ?_, ?_, ?_, ?_⟩
  · apply Subtype.ext
    change (su3Basis 0).1 * (su3Basis 1).1 - (su3Basis 1).1 * (su3Basis 0).1 = (su3Basis 2).1
    ext i j
    fin_cases i <;> fin_cases j <;>
      (simp [su3Basis, su3BasisMat, Matrix.mul_apply, Fin.sum_univ_three, Complex.I_sq, Complex.I_mul_I];
       try ring; try norm_num [Complex.I_sq])
  · apply Subtype.ext
    change (su3Basis 1).1 * (su3Basis 2).1 - (su3Basis 2).1 * (su3Basis 1).1 = (su3Basis 0).1
    ext i j
    fin_cases i <;> fin_cases j <;>
      (simp [su3Basis, su3BasisMat, Matrix.mul_apply, Fin.sum_univ_three, Complex.I_sq, Complex.I_mul_I];
       try ring; try norm_num [Complex.I_sq])
  · apply Subtype.ext
    change (su3Basis 2).1 * (su3Basis 0).1 - (su3Basis 0).1 * (su3Basis 2).1 = (su3Basis 1).1
    ext i j
    fin_cases i <;> fin_cases j <;>
      (simp [su3Basis, su3BasisMat, Matrix.mul_apply, Fin.sum_univ_three, Complex.I_sq, Complex.I_mul_I];
       try ring; try norm_num [Complex.I_sq])
  · simpa using su3Basis_orthonormal 0 0
  · intro X' Y' Z' hX'_ne hXY hYZ hZX
    let H : Matrix (Fin 3) (Fin 3) ℂ := Complex.I • X'.1
    have hH : H.IsHermitian := by
      rw [Matrix.IsHermitian]
      change star (Complex.I • X'.1) = Complex.I • X'.1
      rw [star_smul, Complex.star_def, Complex.conj_I, X'.2.1, neg_smul, smul_neg, neg_neg]
    let W : Matrix (Fin 3) (Fin 3) ℂ := Y'.1 + Complex.I • Z'.1
    have hW_ne : W ≠ 0 := by
      intro hW0
      have hY_eq : Y'.1 = - (Complex.I • Z'.1) := eq_neg_of_add_eq_zero_left hW0
      have hX_val : X'.1 = 0 := by
        have h1 : X'.1 = Y'.1 * Z'.1 - Z'.1 * Y'.1 := congrArg Subtype.val hYZ.symm
        rw [h1, hY_eq]
        noncomm_ring
      exact hX'_ne (Subtype.ext hX_val)
    have hHW : H * W - W * H = W := by
      have h1 : X'.1 * Y'.1 - Y'.1 * X'.1 = Z'.1 := congrArg Subtype.val hXY
      have h2 : Z'.1 * X'.1 - X'.1 * Z'.1 = Y'.1 := congrArg Subtype.val hZX
      have h2' : X'.1 * Z'.1 - Z'.1 * X'.1 = -Y'.1 := by rw [← h2]; abel
      calc H * W - W * H
          = Complex.I • (X'.1 * Y'.1 - Y'.1 * X'.1) +
              (Complex.I * Complex.I) • (X'.1 * Z'.1 - Z'.1 * X'.1) := by
            simp only [H, W, Matrix.mul_add, Matrix.add_mul, Matrix.smul_mul, Matrix.mul_smul,
              smul_smul, smul_sub]
            module
        _ = Complex.I • Z'.1 + (-1 : ℂ) • (-Y'.1) := by rw [h1, h2', Complex.I_mul_I]
        _ = W := by simp [W]; abel
    let U : Matrix.unitaryGroup (Fin 3) ℂ := hH.eigenvectorUnitary
    have h_spec := hH.spectral_theorem
    have h_diag : (star U.1) * H * U.1 = Matrix.diagonal (RCLike.ofReal ∘ hH.eigenvalues) := by
      have hU_unit : (star U.1) * U.1 = 1 := Matrix.mem_unitaryGroup_iff'.mp U.2
      calc (star U.1) * H * U.1
          = (star U.1) * (U.1 * Matrix.diagonal (RCLike.ofReal ∘ hH.eigenvalues) * star U.1) * U.1 := by
            conv_lhs => rw [h_spec, Unitary.conjStarAlgAut_apply]; rfl
        _ = ((star U.1) * U.1) * Matrix.diagonal (RCLike.ofReal ∘ hH.eigenvalues) * ((star U.1) * U.1) := by
            simp only [Matrix.mul_assoc]
        _ = Matrix.diagonal (RCLike.ofReal ∘ hH.eigenvalues) := by rw [hU_unit, Matrix.one_mul, Matrix.mul_one]
    let W' : Matrix (Fin 3) (Fin 3) ℂ := (star U.1) * W * U.1
    have hW'_ne : W' ≠ 0 := by
      intro h0
      have hU1 : U.1 * star U.1 = 1 := Matrix.mem_unitaryGroup_iff.mp U.2
      have hW0 : W = 0 := by
        calc W = (U.1 * star U.1) * W * (U.1 * star U.1) := by rw [hU1, Matrix.one_mul, Matrix.mul_one]
          _ = U.1 * W' * star U.1 := by simp only [W', Matrix.mul_assoc]
          _ = 0 := by rw [h0, Matrix.mul_zero, Matrix.zero_mul]
      exact hW_ne hW0
    obtain ⟨j, k, hjk⟩ : ∃ j k : Fin 3, W' j k ≠ 0 := by
      by_contra h_all
      push Not at h_all
      exact hW'_ne (Matrix.ext h_all)
    have h_comm_W' : Matrix.diagonal (RCLike.ofReal ∘ hH.eigenvalues) * W' -
        W' * Matrix.diagonal (RCLike.ofReal ∘ hH.eigenvalues) = W' := by
      have hU1 : U.1 * star U.1 = 1 := Matrix.mem_unitaryGroup_iff.mp U.2
      calc Matrix.diagonal (RCLike.ofReal ∘ hH.eigenvalues) * W' -
              W' * Matrix.diagonal (RCLike.ofReal ∘ hH.eigenvalues)
          = (star U.1 * H * U.1) * (star U.1 * W * U.1) -
              (star U.1 * W * U.1) * (star U.1 * H * U.1) := by rw [← h_diag]
        _ = star U.1 * (H * (U.1 * star U.1) * W - W * (U.1 * star U.1) * H) * U.1 := by
            simp only [Matrix.mul_assoc, Matrix.mul_sub, Matrix.sub_mul]
        _ = star U.1 * (H * W - W * H) * U.1 := by rw [hU1, Matrix.mul_one, Matrix.mul_one]
        _ = W' := by rw [hHW]
    have h_entry := congrArg (fun M : Matrix (Fin 3) (Fin 3) ℂ => M j k) h_comm_W'
    simp only [Matrix.sub_apply, Matrix.diagonal_mul, Matrix.mul_diagonal, Function.comp_apply,
      RCLike.ofReal_real_eq_id, id_eq] at h_entry
    have h_diff : ((hH.eigenvalues j : ℂ) - (hH.eigenvalues k : ℂ) - 1) * W' j k = 0 := by
      linear_combination h_entry
    have h_eig_c : (hH.eigenvalues j : ℂ) - (hH.eigenvalues k : ℂ) = 1 := by
      rcases mul_eq_zero.mp h_diff with h0 | h0
      · exact sub_eq_zero.mp h0
      · exact absurd h0 hjk
    have h_eig : hH.eigenvalues j - hH.eigenvalues k = 1 := by
      exact Complex.ofReal_injective (by simpa using h_eig_c)
    have h_ne_jk : j ≠ k := by
      intro h_eq; rw [h_eq, sub_self] at h_eig; norm_num at h_eig
    have h_norm : su3Inner X' X' = 2 * ∑ m : Fin 3, (hH.eigenvalues m) ^ 2 := by
      have hHH : H * H = - (X'.1 * X'.1) := by
        simp only [H, Matrix.smul_mul, Matrix.mul_smul, smul_smul, Complex.I_mul_I, neg_one_smul]
      have h_tr_sq : Matrix.trace (H * H) =
          Matrix.trace (Matrix.diagonal (RCLike.ofReal ∘ hH.eigenvalues) *
            Matrix.diagonal (RCLike.ofReal ∘ hH.eigenvalues)) := by
        have hU1 : U.1 * star U.1 = 1 := Matrix.mem_unitaryGroup_iff.mp U.2
        calc Matrix.trace (H * H)
            = Matrix.trace ((U.1 * star U.1) * H * (U.1 * star U.1) * H) := by
              simp [hU1]
          _ = Matrix.trace (star U.1 * H * (U.1 * star U.1) * H * U.1) := by
              simp only [Matrix.mul_assoc]
              rw [Matrix.trace_mul_comm U.1]
              simp only [Matrix.mul_assoc]
          _ = Matrix.trace ((star U.1 * H * U.1) * (star U.1 * H * U.1)) := by
              simp only [Matrix.mul_assoc]
          _ = _ := by rw [h_diag]
      simp only [su3Inner, LinearMap.coe_mk, AddHom.coe_mk, su3InnerFun]
      have h_tr_X : -2 * (Matrix.trace (X'.1 * X'.1)).re = 2 * (Matrix.trace (H * H)).re := by
        rw [hHH, Matrix.trace_neg, Complex.neg_re]; ring
      rw [h_tr_X, h_tr_sq]
      simp [Matrix.trace, sq]
    rw [h_norm]
    have h_sum_ge : (hH.eigenvalues j) ^ 2 + (hH.eigenvalues k) ^ 2 ≤
        ∑ m : Fin 3, (hH.eigenvalues m) ^ 2 := by
      have h_nn : ∀ m : Fin 3, 0 ≤ (hH.eigenvalues m) ^ 2 := fun m => sq_nonneg _
      have h_sub : ({j, k} : Finset (Fin 3)) ⊆ Finset.univ := Finset.subset_univ _
      calc (hH.eigenvalues j) ^ 2 + (hH.eigenvalues k) ^ 2
          = ∑ m ∈ ({j, k} : Finset (Fin 3)), (hH.eigenvalues m) ^ 2 := by
            rw [Finset.sum_pair h_ne_jk]
        _ ≤ ∑ m ∈ Finset.univ, (hH.eigenvalues m) ^ 2 :=
            Finset.sum_le_sum_of_subset_of_nonneg h_sub (fun m _ _ => h_nn m)
    nlinarith [sq_nonneg (hH.eigenvalues j + hH.eigenvalues k)]

private noncomputable def su3BasisObj : Module.Basis (Fin 8) ℝ (LieSU 3) :=
  Module.Basis.mk
    (Fintype.linearIndependent_iff.mpr fun c hc a => by
      have h0 : su3Inner (∑ b : Fin 8, c b • su3Basis b) (su3Basis a) = 0 := by
        rw [hc, map_zero, LinearMap.zero_apply]
      simp only [map_sum, map_smul, LinearMap.coe_sum, LinearMap.smul_apply,
        Finset.sum_apply, smul_eq_mul, su3Basis_orthonormal, mul_ite, mul_one, mul_zero] at h0
      simpa using h0)
    (fun X _ => by
      rw [su3_expand X]
      exact Submodule.sum_mem _ fun a _ =>
        Submodule.smul_mem _ _ (Submodule.subset_span (Set.mem_range_self a)))

private theorem su3_trace_eq_sum (T : LieSU 3 →ₗ[ℝ] LieSU 3) :
    LinearMap.trace ℝ (LieSU 3) T = ∑ k : Fin 8, su3Inner (T (su3Basis k)) (su3Basis k) := by
  rw [LinearMap.trace_eq_matrix_trace ℝ su3BasisObj T]
  simp only [Matrix.trace, Matrix.diag, LinearMap.toMatrix_apply]
  refine Finset.sum_congr rfl fun k _ => ?_
  have h_b : ∀ a : Fin 8, su3BasisObj a = su3Basis a := fun a => by simp [su3BasisObj]
  have h_exp := su3_expand (T (su3BasisObj k))
  have h_eq : T (su3BasisObj k) =
      ∑ a : Fin 8, su3Inner (T (su3Basis k)) (su3Basis a) • su3BasisObj a := by
    rw [← h_b k]
    conv_lhs => rw [h_exp]
    simp_rw [h_b]
  conv_lhs => rw [h_eq, map_sum]
  simp only [map_smul, Module.Basis.repr_self, Finsupp.coe_finsetSum, Finsupp.coe_smul,
    Finset.sum_apply, Pi.smul_apply, smul_eq_mul, Finsupp.single_apply, mul_ite, mul_one,
    mul_zero, Finset.sum_ite_eq', Finset.mem_univ, ↓reduceIte]

private theorem su3Inner_bracket_eq (A B C D : LieSU 3) :
    su3Inner ⁅A, B⁆ ⁅C, D⁆ =
      -2 * (Matrix.trace ((A.1 * B.1 - B.1 * A.1) * (C.1 * D.1 - D.1 * C.1))).re := rfl

