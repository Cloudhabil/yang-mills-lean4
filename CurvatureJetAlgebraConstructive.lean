theorem ad_invariant_trace_amb (A Φ Ψ : AmbientLie d) :
    ∑ a : Fin d, (bracketAmb L A Φ a * Ψ a + Φ a * bracketAmb L A Ψ a) = 0 := by
  simp only [bracketAmb, Finset.sum_mul, Finset.mul_sum, smul_mul_assoc, mul_smul_comm]
  rw [Finset.sum_add_distrib]
  have h_swap :
      (∑ x : Fin d, ∑ b : Fin d, ∑ c : Fin d, ((structConst L x b c : ℝ) : ℂ) • (A b * Φ c * Ψ x)) =
      - ∑ x : Fin d, ∑ b : Fin d, ∑ c : Fin d, ((structConst L x b c : ℝ) : ℂ) • (Φ x * (A b * Ψ c)) := by
    rw [← Finset.sum_neg_distrib]
    trans (∑ b : Fin d, ∑ c : Fin d, ∑ x : Fin d,
        - (((structConst L c b x : ℝ) : ℂ) • (Φ c * (A b * Ψ x))))
    · rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun b _ => ?_
      rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun c _ => Finset.sum_congr rfl fun x _ => ?_
      rw [structConst_skew_ac L x b c, Complex.ofReal_neg, neg_smul]
      congr 2; ring
    · rw [Finset.sum_comm]
      refine Finset.sum_congr rfl fun c _ => ?_
      rw [← Finset.sum_neg_distrib]
      refine Finset.sum_congr rfl fun b _ => ?_
      rw [Finset.sum_neg_distrib]
  rw [h_swap, neg_add_cancel]

/-! ============================================================================
    PART 3: `LiePolySub`, `LiePoly`, `classicalDimLie`, `covDeriv_dim`, `transformLie`
    ============================================================================ -/

/-- Inductive predicate characterizing `AmbientLie d` elements in `LiePoly`. -/
inductive InLiePoly : AmbientLie d → Prop
  | F (μ ν : Fin 4) : InLiePoly (FVec L μ ν)
  | covDeriv (μ : Fin 4) {Φ : AmbientLie d} : InLiePoly Φ → InLiePoly (covDerivAmb L μ Φ)
  | bracket {Φ Ψ : AmbientLie d} : InLiePoly Φ → InLiePoly Ψ → InLiePoly (bracketAmb L Φ Ψ)
  | zero : InLiePoly 0
  | add {Φ Ψ : AmbientLie d} : InLiePoly Φ → InLiePoly Ψ → InLiePoly (Φ + Ψ)
  | smul (c : ℂ) {Φ : AmbientLie d} : InLiePoly Φ → InLiePoly (c • Φ)

/-- `LiePolySub L` is the `ℂ`-submodule of `AmbientLie d` generated by `FVec` under `covDerivAmb` and `bracketAmb`. -/
def LiePolySub : Submodule ℂ (AmbientLie d) where
  carrier := { Φ | InLiePoly L Φ }
  zero_mem' := InLiePoly.zero
  add_mem' hΦ hΨ := InLiePoly.add hΦ hΨ
  smul_mem' c _ hΦ := InLiePoly.smul c hΦ

abbrev LiePolyVal (d : ℕ) (L : LieBasisData G d) : Type := ↥(LiePolySub L)

/-- Ambient weighted scaling dimension of `Φ : AmbientLie d`. -/
def ambWdeg (Φ : AmbientLie d) : ℕ :=
  Finset.univ.sup (fun a : Fin d => coordWdeg (Φ a))

theorem ambWdeg_zero : ambWdeg (0 : AmbientLie d) = 0 := by
  simp [ambWdeg, coordWdeg_zero]

theorem ambWdeg_smul {c : ℂ} (hc : c ≠ 0) (Φ : AmbientLie d) :
    ambWdeg (c • Φ) = ambWdeg Φ := by
  simp only [ambWdeg, Pi.smul_apply]
  refine Finset.sup_congr rfl fun a _ => coordWdeg_smul c hc (Φ a)

theorem ambWdeg_add_le (Φ Ψ : AmbientLie d) :
    ambWdeg (Φ + Ψ) ≤ max (ambWdeg Φ) (ambWdeg Ψ) := by
  refine Finset.sup_le fun a _ => ?_
  calc coordWdeg (Φ a + Ψ a) ≤ max (coordWdeg (Φ a)) (coordWdeg (Ψ a)) := coordWdeg_add_le _ _
    _ ≤ max (ambWdeg Φ) (ambWdeg Ψ) :=
      max_le_max (Finset.le_sup (f := fun x => coordWdeg (Φ x)) (Finset.mem_univ a))
        (Finset.le_sup (f := fun x => coordWdeg (Ψ x)) (Finset.mem_univ a))

theorem ambWdeg_le_iff (Φ : AmbientLie d) (k : ℕ) :
    ambWdeg Φ ≤ k ↔ ∀ a : Fin d, coordWdeg (Φ a) ≤ k := by
  simp [ambWdeg, Finset.sup_le_iff]

theorem monWeight_eq_zero_iff {m : JetVar d →₀ ℕ} : monWeight m = 0 ↔ m = 0 := by
  constructor
  · intro h
    ext v
    by_contra hv
    have hpos : 0 < m v := Nat.pos_of_ne_zero hv
    have hv_mem : v ∈ m.support := Finsupp.mem_support_iff.mpr hv
    have hle : m v * jetWeight v ≤ monWeight m := by
      dsimp [monWeight, Finsupp.sum]
      exact Finset.single_le_sum (f := fun x => m x * jetWeight x) (fun _ _ => Nat.zero_le _) hv_mem
    have hjw : 1 ≤ jetWeight v := by
      rcases v with ⟨α, ν, a⟩; simp [jetWeight]
    nlinarith
  · intro h; subst h; simp [monWeight]

theorem coordDeriv_coeff_zero {d : ℕ} (μ : Fin 4) (f : CoordPoly d) :
    (coordDeriv μ f).coeff 0 = 0 := by
  induction f using MvPolynomial.induction_on with
  | C c => simp [MvPolynomial.algebraMap_eq]
  | add f g hf hg => simp [map_add, hf, hg]
  | mul_X f v hf =>
    rw [coordDeriv_leibniz, MvPolynomial.coeff_add]
    have h2 : (f * coordDeriv μ (MvPolynomial.X v)).coeff 0 = 0 := by
      rw [coordDeriv_X, MvPolynomial.coeff_mul]
      simp [MvPolynomial.coeff_X']
    have h3 : (coordDeriv μ f * MvPolynomial.X v).coeff 0 = 0 := by
      rw [MvPolynomial.coeff_mul]
      simp [MvPolynomial.coeff_X']
    rw [h3, h2, zero_add]

theorem coeff_zero_of_inLiePoly {Φ : AmbientLie d} (hΦ : InLiePoly L Φ) :
    ∀ a : Fin d, (Φ a).coeff 0 = 0 := by
  induction hΦ with
  | F μ ν =>
    intro a
    simp only [FVec, MvPolynomial.coeff_add, MvPolynomial.coeff_sub, MvPolynomial.coeff_sum,
      MvPolynomial.coeff_smul, smul_eq_mul]
    have h1 : (coordDeriv μ (AComp ν a)).coeff 0 = 0 := coordDeriv_coeff_zero μ _
    have h2 : (coordDeriv ν (AComp μ a)).coeff 0 = 0 := coordDeriv_coeff_zero ν _
    have h3 : ∀ b c : Fin d, (AComp μ b * AComp ν c).coeff 0 = 0 := by
      intro b c
      rw [AComp, MvPolynomial.coeff_mul]
      simp [MvPolynomial.coeff_X']
    simp [h1, h2, h3]
  | covDeriv μ _ ih =>
    intro a
    simp only [covDerivAmb, LinearMap.coe_mk, AddHom.coe_mk, MvPolynomial.coeff_add,
      MvPolynomial.coeff_sum, MvPolynomial.coeff_smul, smul_eq_mul, coordDeriv_coeff_zero, zero_add]
    refine Finset.sum_eq_zero fun b _ => Finset.sum_eq_zero fun c _ => ?_
    rw [MvPolynomial.coeff_mul]
    simp [AComp, MvPolynomial.coeff_X']
  | bracket _ _ ih1 ih2 =>
    intro a
    simp only [bracketAmb, MvPolynomial.coeff_sum, MvPolynomial.coeff_smul, smul_eq_mul]
    refine Finset.sum_eq_zero fun b _ => Finset.sum_eq_zero fun c _ => ?_
    rw [MvPolynomial.coeff_mul]
    simp [ih1 b]
  | zero => intro a; simp
  | add _ _ ih1 ih2 => intro a; simp [ih1 a, ih2 a]
  | smul c _ ih => intro a; simp [ih a]

/-- Total polynomial degree `∑ v, m v` of a monomial exponent `m`. -/
def totalDeg {d : ℕ} (m : JetVar d →₀ ℕ) : ℕ := m.sum (fun _ n => n)

theorem totalDeg_zero {d : ℕ} : totalDeg (0 : JetVar d →₀ ℕ) = 0 := by
  simp [totalDeg]

theorem totalDeg_single {d : ℕ} (v : JetVar d) (k : ℕ) :
    totalDeg (Finsupp.single v k) = k := by
  simp [totalDeg]

theorem totalDeg_add {d : ℕ} (m₁ m₂ : JetVar d →₀ ℕ) :
    totalDeg (m₁ + m₂) = totalDeg m₁ + totalDeg m₂ := by
  simp only [totalDeg]
  exact Finsupp.sum_add_index' (fun _ => rfl) (fun _ _ _ => rfl)

theorem coordDeriv_monomial {d : ℕ} (μ : Fin 4) (m : JetVar d →₀ ℕ) (c : ℂ) :
    coordDeriv μ (MvPolynomial.monomial m c) =
      ∑ v ∈ m.support, (c * (m v : ℂ)) •
        MvPolynomial.monomial (m - Finsupp.single v 1 + Finsupp.single (μ ::ₘ v.1, v.2) 1) 1 := by
  induction m using Finsupp.induction generalizing c with
  | zero =>
    rw [← MvPolynomial.C_apply]
    simp [MvPolynomial.algebraMap_eq]
  | single_add v₀ k m₀ hv₀ hk ih =>
    have h_mul : MvPolynomial.monomial (Finsupp.single v₀ k + m₀) c =
        (MvPolynomial.X v₀) ^ k * MvPolynomial.monomial m₀ c := by
      rw [MvPolynomial.X_pow_eq_monomial, MvPolynomial.monomial_mul, one_mul]
    have h_deriv_pow : ∀ j : ℕ, coordDeriv μ ((MvPolynomial.X v₀ : CoordPoly d) ^ j) =
        (j : ℂ) • ((MvPolynomial.X v₀) ^ (j - 1) * MvPolynomial.X (μ ::ₘ v₀.1, v₀.2)) := by
      intro j
      induction j with
      | zero => simp [MvPolynomial.algebraMap_eq]
      | succ j ihj =>
        rw [pow_succ, coordDeriv_leibniz, ihj, coordDeriv_X]
        cases j with
        | zero => simp
        | succ j' =>
          simp only [Nat.add_sub_cancel, Nat.cast_add, Nat.cast_one, Prod.mk.eta]
          rw [smul_mul_assoc, mul_assoc, mul_comm (MvPolynomial.X (μ ::ₘ v₀.1, v₀.2)) (MvPolynomial.X v₀),
            ← mul_assoc, ← pow_succ]
          conv_rhs => rw [add_smul, one_smul]
    rw [h_mul, coordDeriv_leibniz, h_deriv_pow k, ih c]
    have h_supp : (Finsupp.single v₀ k + m₀).support = insert v₀ m₀.support := by
      rw [Finsupp.support_add_eq]
      · rw [Finsupp.support_single]
        · exact Finset.singleton_union v₀ m₀.support
        · exact hk
      · exact Disjoint.symm (Finset.disjoint_left.mpr fun v hv hvs => by
          rw [Finsupp.mem_support_iff, Finsupp.single_apply] at hvs
          split_ifs at hvs with heq
          · subst heq; exact hv₀ hv
          · exact hvs rfl)
    rw [h_supp, Finset.sum_insert hv₀]
    have h_v0 : (Finsupp.single v₀ k + m₀) v₀ = k := by
      simp [Finsupp.notMem_support_iff.mp hv₀]
    have h_term1 :
        ((k : ℂ) • ((MvPolynomial.X v₀ : CoordPoly d) ^ (k - 1) * MvPolynomial.X (μ ::ₘ v₀.1, v₀.2))) *
          MvPolynomial.monomial m₀ c =
        (c * ((Finsupp.single v₀ k + m₀) v₀ : ℂ)) •
          MvPolynomial.monomial (Finsupp.single v₀ k + m₀ - Finsupp.single v₀ 1 +
            Finsupp.single (μ ::ₘ v₀.1, v₀.2) 1) 1 := by
      rw [h_v0, smul_mul_assoc, MvPolynomial.X_pow_eq_monomial, MvPolynomial.X,
        MvPolynomial.monomial_mul, MvPolynomial.monomial_mul, MvPolynomial.smul_monomial,
        smul_eq_mul, one_mul, one_mul, mul_comm (k : ℂ) c]
      rw [MvPolynomial.smul_monomial, smul_eq_mul, mul_one]
      congr 2
      ext w
      simp only [Finsupp.coe_add, Finsupp.coe_tsub, Pi.add_apply, Pi.sub_apply, Finsupp.single_apply]
      by_cases hw : w = v₀
      · subst hw; split_ifs <;> omega
      · split_ifs <;> simp_all <;> omega
    have h_term2 :
        (MvPolynomial.X v₀ : CoordPoly d) ^ k *
          (∑ v ∈ m₀.support, (c * (m₀ v : ℂ)) •
            MvPolynomial.monomial (m₀ - Finsupp.single v 1 + Finsupp.single (μ ::ₘ v.1, v.2) 1) 1) =
        ∑ v ∈ m₀.support, (c * ((Finsupp.single v₀ k + m₀) v : ℂ)) •
          MvPolynomial.monomial (Finsupp.single v₀ k + m₀ - Finsupp.single v 1 +
            Finsupp.single (μ ::ₘ v.1, v.2) 1) 1 := by
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun v hv => ?_
      have hne : v ≠ v₀ := fun heq => hv₀ (heq ▸ hv)
      have hv_val : (Finsupp.single v₀ k + m₀) v = m₀ v := by
        simp [Finsupp.single_apply, hne.symm]
      rw [hv_val, mul_smul_comm, MvPolynomial.X_pow_eq_monomial, MvPolynomial.monomial_mul,
        one_mul]
      refine congrArg (fun m => (c * (m₀ v : ℂ)) • MvPolynomial.monomial m 1) ?_
      ext w
      simp only [Finsupp.coe_add, Finsupp.coe_tsub, Pi.add_apply, Pi.sub_apply, Finsupp.single_apply]
      by_cases hw : w = v
      · subst hw
        have hw0 : m₀ w ≥ 1 := Finsupp.mem_support_iff.mp hv |> Nat.pos_of_ne_zero
        split_ifs <;> omega
      · split_ifs <;> simp_all <;> omega
    rw [h_term1, h_term2]

theorem covDeriv_dim_amb (μ : Fin 4) (Φ : AmbientLie d)
    (h_zero : ∀ a : Fin d, (Φ a).coeff 0 = 0)
    (hΦ : Φ ≠ 0) (hD : covDerivAmb L μ Φ ≠ 0) :
    ambWdeg (covDerivAmb L μ Φ) = ambWdeg Φ + 1 := by
  refine le_antisymm ?_ ?_
  · refine (ambWdeg_le_iff _ _).mpr fun a => ?_
    calc coordWdeg (covDerivAmb L μ Φ a)
        ≤ max (coordWdeg (coordDeriv μ (Φ a)))
            (coordWdeg (∑ b : Fin d, ∑ c : Fin d,
              ((structConst L a b c : ℝ) : ℂ) • (AComp μ b * Φ c))) := coordWdeg_add_le _ _
      _ ≤ ambWdeg Φ + 1 := by
          refine max_le ?_ ?_
          · calc coordWdeg (coordDeriv μ (Φ a))
                ≤ coordWdeg (Φ a) + 1 := coordWdeg_coordDeriv_le μ _
              _ ≤ ambWdeg Φ + 1 :=
                  Nat.add_le_add_right (Finset.le_sup (f := fun b => coordWdeg (Φ b)) (Finset.mem_univ a)) 1
          · refine (coordWdeg_le_iff _ _).mpr fun m hm => ?_
            rcases Finset.mem_biUnion.mp (MvPolynomial.support_sum hm) with ⟨b, _, hm1⟩
            rcases Finset.mem_biUnion.mp (MvPolynomial.support_sum hm1) with ⟨c, _, hm2⟩
            have hbc : coordWdeg (((structConst L a b c : ℝ) : ℂ) • (AComp μ b * Φ c)) ≤
                ambWdeg Φ + 1 := by
              by_cases hc : ((structConst L a b c : ℝ) : ℂ) = 0
              · simp [hc, coordWdeg_zero]
              · rw [coordWdeg_smul _ hc]
                calc coordWdeg (AComp μ b * Φ c)
                    ≤ coordWdeg (AComp μ b) + coordWdeg (Φ c) := coordWdeg_mul_le _ _
                  _ ≤ 1 + ambWdeg Φ := by
                      have hA : coordWdeg (AComp μ b) ≤ 1 := by
                        rw [AComp, coordWdeg_X]; simp
                      exact Nat.add_le_add hA (Finset.le_sup (f := fun x => coordWdeg (Φ x)) (Finset.mem_univ c))
                  _ = ambWdeg Φ + 1 := Nat.add_comm 1 _
            exact (coordWdeg_le_iff _ _).mp hbc m hm2
  · set k := ambWdeg Φ
    have hΦ_ex : ∃ a : Fin d, Φ a ≠ 0 := by
      by_contra h_all; push Not at h_all; exact hΦ (funext h_all)
    -- `pairSet` of `(a, m)` achieving `monWeight m = k`
    let pairSet : Finset (Fin d × (JetVar d →₀ ℕ)) :=
      Finset.univ.biUnion fun a =>
        ((Φ a).support.filter (fun m => monWeight m = k)).map
          ⟨fun m => (a, m), fun m₁ m₂ h => (Prod.mk.inj h).2⟩
    have h_pair_ne : pairSet.Nonempty := by
      have h_sup_att : ∃ a ∈ (Finset.univ : Finset (Fin d)), coordWdeg (Φ a) = k := by
        obtain ⟨a_ne, ha_ne⟩ := hΦ_ex
        obtain ⟨a, ha, ha_eq⟩ :=
          Finset.exists_mem_eq_sup Finset.univ ⟨a_ne, Finset.mem_univ a_ne⟩ (fun a => coordWdeg (Φ a))
        exact ⟨a, ha, ha_eq.symm⟩
      rcases h_sup_att with ⟨a_top, _, ha_top⟩
      by_cases h_supp_ne : (Φ a_top).support.Nonempty
      · obtain ⟨m_top, hm_top, hmw_top⟩ :=
          Finset.exists_mem_eq_sup (Φ a_top).support h_supp_ne monWeight
        refine ⟨(a_top, m_top), Finset.mem_biUnion.mpr ⟨a_top, Finset.mem_univ a_top, ?_⟩⟩
        rw [Finset.mem_map]
        have h_cw_eq : coordWdeg (Φ a_top) = (Φ a_top).support.sup monWeight :=
          le_antisymm ((coordWdeg_le_iff _ _).mpr fun m hm => Finset.le_sup hm)
            (Finset.sup_le fun m hm => (coordWdeg_le_iff _ _).mp le_rfl m hm)
        have ha_top' : (Φ a_top).support.sup monWeight = k := h_cw_eq.symm.trans ha_top
        exact ⟨m_top, Finset.mem_filter.mpr ⟨hm_top, hmw_top.symm.trans ha_top'⟩, rfl⟩
      · rw [Finset.not_nonempty_iff_eq_empty, MvPolynomial.support_eq_empty] at h_supp_ne
        rw [h_supp_ne, coordWdeg_zero] at ha_top
        obtain ⟨a_ne, ha_ne⟩ := hΦ_ex
        have hk_le : coordWdeg (Φ a_ne) ≤ k :=
          Finset.le_sup (f := fun a => coordWdeg (Φ a)) (Finset.mem_univ a_ne)
        rw [← ha_top, Nat.le_zero] at hk_le
        have h_supp_a : (Φ a_ne).support.Nonempty := MvPolynomial.support_nonempty.mpr ha_ne
        obtain ⟨m_ne, hm_ne⟩ := h_supp_a
        have hmw_le : monWeight m_ne ≤ coordWdeg (Φ a_ne) :=
          (coordWdeg_le_iff _ _).mp le_rfl m_ne hm_ne
        rw [hk_le, Nat.le_zero, monWeight_eq_zero_iff] at hmw_le
        subst hmw_le
        exact absurd (h_zero a_ne) (MvPolynomial.mem_support_iff.mp hm_ne)
    obtain ⟨⟨a₀, m₀⟩, hm₀_mem, hm₀_min⟩ :=
      Finset.exists_min_image pairSet (fun p => totalDeg p.2) h_pair_ne
    set d_min := totalDeg m₀
    have hm₀_supp : m₀ ∈ (Φ a₀).support := by
      rcases Finset.mem_biUnion.mp hm₀_mem with ⟨a', _, hm'⟩
      rw [Finset.mem_map] at hm'
      rcases hm' with ⟨m', hm'_f, hm'_eq⟩
      rcases Prod.mk.inj hm'_eq with ⟨rfl, rfl⟩
      exact (Finset.mem_filter.mp hm'_f).1
    have hm₀_wt : monWeight m₀ = k := by
      rcases Finset.mem_biUnion.mp hm₀_mem with ⟨a', _, hm'⟩
      rw [Finset.mem_map] at hm'
      rcases hm' with ⟨m', hm'_f, hm'_eq⟩
      rcases Prod.mk.inj hm'_eq with ⟨rfl, rfl⟩
      exact (Finset.mem_filter.mp hm'_f).2
    let filt := (Φ a₀).support.filter (fun m => monWeight m = k ∧ totalDeg m = d_min)
    let P : CoordPoly d := ∑ m ∈ filt, MvPolynomial.monomial m ((Φ a₀).coeff m)
    have hm₀_filt : m₀ ∈ filt := Finset.mem_filter.mpr ⟨hm₀_supp, hm₀_wt, rfl⟩
    have hP_coeff : ∀ m : JetVar d →₀ ℕ, P.coeff m = if m ∈ filt then (Φ a₀).coeff m else 0 := by
      intro m
      simp only [P, MvPolynomial.coeff_sum, MvPolynomial.coeff_monomial]
      rw [Finset.sum_ite_eq']
    have hP_ne : P ≠ 0 := by
      intro h0
      have := congrArg (fun f : CoordPoly d => f.coeff m₀) h0
      rw [hP_coeff m₀, if_pos hm₀_filt, MvPolynomial.coeff_zero] at this
      exact MvPolynomial.mem_support_iff.mp hm₀_supp this
    have hm₀_ne_zero : m₀ ≠ 0 := fun h => by
      subst h; exact MvPolynomial.mem_support_iff.mp hm₀_supp (h_zero a₀)
    let varSet : Finset (JetVar d) := P.support.biUnion Finsupp.support
    have hP_vars_ne : varSet.Nonempty := by
      obtain ⟨v, hv⟩ := Finsupp.support_nonempty_iff.mpr hm₀_ne_zero
      refine ⟨v, Finset.mem_biUnion.mpr ⟨m₀, ?_, hv⟩⟩
      rw [MvPolynomial.mem_support_iff, hP_coeff m₀, if_pos hm₀_filt]
      exact MvPolynomial.mem_support_iff.mp hm₀_supp
    obtain ⟨v₀, hv₀_vars, hv₀_max⟩ :=
      Finset.exists_max_image varSet (fun v => v.1.card) hP_vars_ne
    let v₁ : JetVar d := (μ ::ₘ v₀.1, v₀.2)
    have hv₁_not_vars : v₁ ∉ varSet := by
      intro hv₁
      have hle := hv₀_max v₁ hv₁
      simp [v₁] at hle
    obtain ⟨m_star, hm_star_supp, hv₀_m_star⟩ := Finset.mem_biUnion.mp hv₀_vars
    have hm_star_filt : m_star ∈ filt := by
      rw [MvPolynomial.mem_support_iff, hP_coeff m_star] at hm_star_supp
      split_ifs at hm_star_supp with hf
      · exact hf
      · exact absurd rfl hm_star_supp
    have hm_star_orig : m_star ∈ (Φ a₀).support := (Finset.mem_filter.mp hm_star_filt).1
    have hm_star_wt : monWeight m_star = k := (Finset.mem_filter.mp hm_star_filt).2.1
    have hm_star_deg : totalDeg m_star = d_min := (Finset.mem_filter.mp hm_star_filt).2.2
    have hm_star_v1 : m_star v₁ = 0 := by
      by_contra hne
      exact hv₁_not_vars (Finset.mem_biUnion.mpr ⟨m_star, hm_star_supp,
        Finsupp.mem_support_iff.mpr hne⟩)
    let m_target : JetVar d →₀ ℕ := m_star - Finsupp.single v₀ 1 + Finsupp.single v₁ 1
    have hm_target_wt : monWeight m_target = k + 1 := by
      have hv0_pos : 1 ≤ m_star v₀ := Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp hv₀_m_star)
      have h_sub : monWeight (m_star - Finsupp.single v₀ 1) + jetWeight v₀ = monWeight m_star := by
        have h_eq : m_star = (m_star - Finsupp.single v₀ 1) + Finsupp.single v₀ 1 := by
          ext w; simp only [Finsupp.coe_add, Finsupp.coe_tsub, Pi.add_apply, Pi.sub_apply,
            Finsupp.single_apply]
          by_cases hw : w = v₀
          · subst hw; split_ifs <;> omega
          · split_ifs <;> simp_all
        conv_rhs => rw [h_eq, monWeight_add, monWeight_single, one_mul]
      rw [monWeight_add, monWeight_single, one_mul]
      have hj1 : jetWeight v₁ = jetWeight v₀ + 1 := by
        rcases v₀ with ⟨α₀, ν₀, b₀⟩
        simp [v₁, jetWeight]
      omega
    have hm_target_deg : totalDeg m_target = d_min := by
      have hv0_pos : 1 ≤ m_star v₀ := Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp hv₀_m_star)
      have h_eq : m_star = (m_star - Finsupp.single v₀ 1) + Finsupp.single v₀ 1 := by
        ext w; simp only [Finsupp.coe_add, Finsupp.coe_tsub, Pi.add_apply, Pi.sub_apply,
          Finsupp.single_apply]
        by_cases hw : w = v₀
        · subst hw; split_ifs <;> omega
        · split_ifs <;> simp_all
      have hd_sub : totalDeg (m_star - Finsupp.single v₀ 1) + 1 = totalDeg m_star := by
        conv_rhs => rw [h_eq, totalDeg_add, totalDeg_single]
      rw [totalDeg_add, totalDeg_single]
      omega
    have hm_target_in_supp : m_target ∈ (covDerivAmb L μ Φ a₀).support := by
      rw [MvPolynomial.mem_support_iff]
      simp only [covDerivAmb, LinearMap.coe_mk, AddHom.coe_mk, MvPolynomial.coeff_add,
        MvPolynomial.coeff_sum, MvPolynomial.coeff_smul, smul_eq_mul]
      -- Nonlinear part vanishes at `m_target`:
      have h_nonlin : ∀ b c : Fin d, (AComp μ b * Φ c).coeff m_target = 0 := by
        intro b c
        rw [AComp, MvPolynomial.coeff_mul]
        refine Finset.sum_eq_zero fun p hp => ?_
        by_cases h1 : (MvPolynomial.X (0, μ, b) : CoordPoly d).coeff p.1 = 0
        · simp [h1]
        · rw [MvPolynomial.coeff_X] at h1
          have hp1 : p.1 = Finsupp.single (0, μ, b) 1 := by
            by_contra hne; exact h1 (if_neg (Ne.symm hne))
          by_cases h2 : (Φ c).coeff p.2 = 0
          · simp [h2]
          · exfalso
            have hp_eq : p.1 + p.2 = m_target := by simpa using hp
            have hmw : monWeight p.2 = k := by
              have := congrArg monWeight hp_eq
              rw [monWeight_add, hp1, monWeight_single, one_mul, hm_target_wt] at this
              have hj : jetWeight (0, μ, b) = 1 := by simp [jetWeight]
              omega
            have hdeg : totalDeg p.2 + 1 = d_min := by
              have := congrArg totalDeg hp_eq
              rw [totalDeg_add, hp1, totalDeg_single, hm_target_deg] at this
              omega
            have hp2_pair : (c, p.2) ∈ pairSet := by
              refine Finset.mem_biUnion.mpr ⟨c, Finset.mem_univ c, ?_⟩
              rw [Finset.mem_map]
              exact ⟨p.2, Finset.mem_filter.mpr ⟨MvPolynomial.mem_support_iff.mpr h2, hmw⟩, rfl⟩
            have hmin := hm₀_min (c, p.2) hp2_pair
            dsimp at hmin
            omega
      simp only [h_nonlin, mul_zero, Finset.sum_const_zero, add_zero]
      -- Linear `coordDeriv μ (Φ a₀)` part at `m_target`:
      have h_deriv_coeff : (coordDeriv μ (Φ a₀)).coeff m_target =
          (Φ a₀).coeff m_star * (m_star v₀ : ℂ) := by
        conv_lhs => rw [MvPolynomial.as_sum (Φ a₀), map_sum, MvPolynomial.coeff_sum]
        have h_term : ∀ m ∈ (Φ a₀).support,
            (coordDeriv μ (MvPolynomial.monomial m ((Φ a₀).coeff m))).coeff m_target =
              if m = m_star then (Φ a₀).coeff m_star * (m_star v₀ : ℂ) else 0 := by
          intro m hm
          rw [coordDeriv_monomial, MvPolynomial.coeff_sum]
          have h_v : ∀ v ∈ m.support,
              (((Φ a₀).coeff m * (m v : ℂ)) •
                MvPolynomial.monomial (m - Finsupp.single v 1 + Finsupp.single (μ ::ₘ v.1, v.2) 1) 1).coeff m_target =
                if m = m_star ∧ v = v₀ then (Φ a₀).coeff m_star * (m_star v₀ : ℂ) else 0 := by
            intro v hv
            rw [MvPolynomial.coeff_smul, MvPolynomial.coeff_monomial, smul_eq_mul]
            split_ifs with h_eq h_mv
            · rcases h_mv with ⟨rfl, rfl⟩; simp
            · exfalso
              have hv_pos : 1 ≤ m v := Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp hv)
              have hm_eq : m = (m - Finsupp.single v 1) + Finsupp.single v 1 := by
                ext w; simp only [Finsupp.coe_add, Finsupp.coe_tsub, Pi.add_apply, Pi.sub_apply,
                  Finsupp.single_apply]
                by_cases hw : w = v
                · subst hw; split_ifs <;> omega
                · split_ifs <;> simp_all
              have h_mw : monWeight m = k := by
                have := congrArg monWeight h_eq
                rw [monWeight_add, monWeight_single, one_mul, hm_target_wt] at this
                have h_sub_mw : monWeight (m - Finsupp.single v 1) + jetWeight v = monWeight m := by
                  conv_rhs => rw [hm_eq, monWeight_add, monWeight_single, one_mul]
                have hjv : jetWeight (μ ::ₘ v.1, v.2) = jetWeight v + 1 := by
                  rcases v with ⟨α, ν, b⟩; simp [jetWeight]
                omega
              have h_deg : totalDeg m = d_min := by
                have := congrArg totalDeg h_eq
                rw [totalDeg_add, totalDeg_single, hm_target_deg] at this
                have h_sub_deg : totalDeg (m - Finsupp.single v 1) + 1 = totalDeg m := by
                  conv_rhs => rw [hm_eq, totalDeg_add, totalDeg_single]
                omega
              have hm_filt : m ∈ filt := Finset.mem_filter.mpr ⟨hm, h_mw, h_deg⟩
              have hm_v1 : m v₁ = 0 := by
                by_contra hne
                exact hv₁_not_vars (Finset.mem_biUnion.mpr ⟨m, by
                  rw [MvPolynomial.mem_support_iff, hP_coeff m, if_pos hm_filt]
                  exact MvPolynomial.mem_support_iff.mp hm, Finsupp.mem_support_iff.mpr hne⟩)
              have h_at_v1 := congrArg (fun f : JetVar d →₀ ℕ => f v₁) h_eq
              simp only [Finsupp.coe_add, Finsupp.coe_tsub, Pi.add_apply, Pi.sub_apply,
                Finsupp.single_apply, hm_v1, Nat.zero_sub, zero_add] at h_at_v1
              have hv1_eq : v₁ = (μ ::ₘ v.1, v.2) := by
                by_contra hne
                rw [if_neg (fun h => hne h.symm)] at h_at_v1
                dsimp [m_target] at h_at_v1
                simp only [Finsupp.coe_add, Finsupp.coe_tsub, Pi.add_apply, Pi.sub_apply,
                  Finsupp.single_apply, hm_star_v1, Nat.zero_sub, zero_add] at h_at_v1
                split_ifs at h_at_v1 <;> omega
              have hv_eq : v = v₀ :=
                Prod.ext ((Multiset.cons_inj_right μ).mp (Prod.mk.inj hv1_eq).1).symm
                  (Prod.mk.inj hv1_eq).2.symm
              have hm_eq_star : m = m_star := by
                have hv0_ne_v1 : v₀ ≠ v₁ := fun h =>
                  (Finsupp.mem_support_iff.mp hv₀_m_star) (h ▸ hm_star_v1)
                ext w
                have h_at_w := congrArg (fun f : JetVar d →₀ ℕ => f w) h_eq
                rw [hv_eq] at h_at_w
                simp only [m_target, Finsupp.add_apply, Finsupp.tsub_apply, Finsupp.single_apply] at h_at_w
                by_cases hw0 : w = v₀
                · subst w
                  have hv0_s : 1 ≤ m_star v₀ := Nat.pos_of_ne_zero (Finsupp.mem_support_iff.mp hv₀_m_star)
                  have hv_s : 1 ≤ m v₀ := hv_eq ▸ hv_pos
                  rw [if_neg hv0_ne_v1.symm] at h_at_w
                  split_ifs at h_at_w <;> omega
                · by_cases hw1 : w = v₁
                  · subst w; rw [hm_v1, hm_star_v1]
                  · have hw0' : v₀ ≠ w := Ne.symm hw0
                    have hw1' : (μ ::ₘ v₀.1, v₀.2) ≠ w := Ne.symm hw1
                    have hw1'' : v₁ ≠ w := Ne.symm hw1
                    simp only [m_target, Finsupp.add_apply, Finsupp.tsub_apply, Finsupp.single_apply,
                      if_neg hw0', if_neg hw1', if_neg hw1'', Nat.sub_zero, add_zero] at h_at_w
                    exact h_at_w
              exact h_mv ⟨hm_eq_star, hv_eq⟩
            · exfalso
              have ⟨hm', hv'⟩ := ‹m = m_star ∧ v = v₀›
              exact h_eq (by rw [hm', hv'])
            · simp
          rw [Finset.sum_congr rfl h_v]
          split_ifs with hm_eq
          · subst hm_eq; simp [hv₀_m_star]
          · simp [hm_eq]
        rw [Finset.sum_congr rfl h_term, Finset.sum_ite_eq']
        simp [hm_star_orig]
      rw [h_deriv_coeff]
      refine mul_ne_zero (MvPolynomial.mem_support_iff.mp hm_star_orig) ?_
      exact Nat.cast_ne_zero.mpr (Finsupp.mem_support_iff.mp hv₀_m_star)
    calc k + 1 = monWeight m_target := hm_target_wt.symm
      _ ≤ coordWdeg (covDerivAmb L μ Φ a₀) := (coordWdeg_le_iff _ _).mp le_rfl m_target hm_target_in_supp
      _ ≤ ambWdeg (covDerivAmb L μ Φ) := Finset.le_sup (f := fun a => coordWdeg (covDerivAmb L μ Φ a)) (Finset.mem_univ a₀)

theorem FVec_coeff_single {μ ν : Fin 4} (h_ne : μ ≠ ν) (a a₀ : Fin d) :
    (FVec L μ ν a).coeff (Finsupp.single ({μ}, ν, a₀) 1) = if a = a₀ then 1 else 0 := by
  simp only [FVec, AComp, coordDeriv_X]
  have h1 : (MvPolynomial.X (μ ::ₘ 0, ν, a) : CoordPoly d).coeff
      (Finsupp.single ({μ}, ν, a₀) 1) = if a = a₀ then 1 else 0 := by
    rw [MvPolynomial.coeff_X]
    by_cases ha : a = a₀
    · subst ha; simp
    · simp only [if_neg ha]; rw [if_neg]; intro h
      exact ha (Prod.mk.inj (Prod.mk.inj ((Finsupp.single_left_inj one_ne_zero).mp h)).2).2
  have h2 : (MvPolynomial.X (ν ::ₘ 0, μ, a) : CoordPoly d).coeff
      (Finsupp.single ({μ}, ν, a₀) 1) = 0 := by
    rw [MvPolynomial.coeff_X]
    rw [if_neg]; intro h
    exact h_ne (Prod.mk.inj (Prod.mk.inj ((Finsupp.single_left_inj one_ne_zero).mp h)).2).1
  have h3 : ∀ b c : Fin d,
      (MvPolynomial.X (0, μ, b) * MvPolynomial.X (0, ν, c) : CoordPoly d).coeff
        (Finsupp.single ({μ}, ν, a₀) 1) = 0 := by
    intro b c
    rw [MvPolynomial.X, MvPolynomial.X, MvPolynomial.monomial_mul, one_mul, MvPolynomial.coeff_monomial]
    split_ifs with h
    · exfalso
      have h_at := congrArg (fun f : JetVar d →₀ ℕ => f (0, μ, b)) h
      simp only [Finsupp.add_apply, Finsupp.single_apply] at h_at
      have hne0 : (({μ} : Multiset (Fin 4)), ν, a₀) ≠ (0, μ, b) := by
        intro heq
        have := congrArg Multiset.card (Prod.mk.inj heq).1
        simp at this
      rw [if_neg hne0] at h_at
      split_ifs at h_at <;> omega
    · rfl
  simp only [MvPolynomial.coeff_add, MvPolynomial.coeff_sub, MvPolynomial.coeff_sum,
    MvPolynomial.coeff_smul, smul_eq_mul]
  rw [h1, h2, sub_zero]
  simp [h3]

theorem FVec_nonzero {μ ν : Fin 4} (h_ne : μ ≠ ν) : FVec L μ ν ≠ 0 := by
  intro h
  have a₀ : Fin d := ⟨0, L.hd⟩
  have hc := congrArg (fun Φ : AmbientLie d => (Φ a₀).coeff (Finsupp.single ({μ}, ν, a₀) 1)) h
  rw [FVec_coeff_single L h_ne a₀ a₀, if_pos rfl] at hc
  simp at hc

theorem FVec_homogeneous_two (μ ν : Fin 4) (a : Fin d) :
    ∀ m ∈ (FVec L μ ν a).support, monWeight m = 2 := by
  intro m hm
  simp only [FVec, AComp, coordDeriv_X] at hm
  rcases Finset.mem_union.mp (MvPolynomial.support_add hm) with hm1 | hm2
  · rw [sub_eq_add_neg] at hm1
    rcases Finset.mem_union.mp (MvPolynomial.support_add hm1) with hm1a | hm1b
    · rw [MvPolynomial.support_X, Finset.mem_singleton] at hm1a
      rw [hm1a, monWeight_single, one_mul]
      simp [jetWeight]
    · rw [MvPolynomial.support_neg, MvPolynomial.support_X, Finset.mem_singleton] at hm1b
      rw [hm1b, monWeight_single, one_mul]
      simp [jetWeight]
  · rcases Finset.mem_biUnion.mp (MvPolynomial.support_sum hm2) with ⟨b, _, hmb⟩
    rcases Finset.mem_biUnion.mp (MvPolynomial.support_sum hmb) with ⟨c, _, hmc⟩
    have hmc' : m ∈ (MvPolynomial.X (0, μ, b) * MvPolynomial.X (0, ν, c) : CoordPoly d).support := by
      rw [MvPolynomial.mem_support_iff] at hmc ⊢
      intro hc
      rw [MvPolynomial.coeff_smul, smul_eq_mul, hc, mul_zero] at hmc
      exact hmc rfl
    rw [MvPolynomial.X, MvPolynomial.X, MvPolynomial.monomial_mul, one_mul,
      MvPolynomial.support_monomial] at hmc'
    split_ifs at hmc' with h10
    · simp at hmc'
    · rw [Finset.mem_singleton.mp hmc', monWeight_add, monWeight_single, monWeight_single,
        one_mul, one_mul]
      simp [jetWeight]

theorem FVec_dim {μ ν : Fin 4} (h_ne : μ ≠ ν) : ambWdeg (FVec L μ ν) = 2 := by
  refine le_antisymm ?_ ?_
  · refine (ambWdeg_le_iff _ _).mpr fun a => (coordWdeg_le_iff _ _).mpr fun m hm => ?_
    exact (FVec_homogeneous_two L μ ν a m hm).le
  · have a₀ : Fin d := ⟨0, L.hd⟩
    have hm : Finsupp.single ({μ}, ν, a₀) 1 ∈ (FVec L μ ν a₀).support := by
      rw [MvPolynomial.mem_support_iff, FVec_coeff_single L h_ne a₀ a₀, if_pos rfl]
      exact one_ne_zero
    have hwt : monWeight (Finsupp.single ({μ}, ν, a₀) 1) = 2 := by
      rw [monWeight_single, one_mul]; simp [jetWeight]
    calc 2 = monWeight (Finsupp.single ({μ}, ν, a₀) 1) := hwt.symm
      _ ≤ coordWdeg (FVec L μ ν a₀) := (coordWdeg_le_iff _ _).mp le_rfl _ hm
      _ ≤ ambWdeg (FVec L μ ν) := Finset.le_sup (f := fun a => coordWdeg (FVec L μ ν a)) (Finset.mem_univ a₀)

/-- `ℂ`-linear action of `R : Matrix (Fin 4) (Fin 4) ℝ` on `AmbientLie d`. -/
def transformAmb (R : Matrix (Fin 4) (Fin 4) ℝ) : AmbientLie d →ₗ[ℂ] AmbientLie d where
  toFun Φ a := transformCoord R (Φ a)
  map_add' Φ Ψ := funext fun a => map_add (transformCoord R) (Φ a) (Ψ a)
  map_smul' c Φ := funext fun a => map_smul (transformCoord R) c (Φ a)

theorem transformAmb_one : transformAmb (d := d) 1 = LinearMap.id := by
  ext Φ a; simp [transformAmb, transformCoord_one]

theorem transformAmb_mul (R₁ R₂ : Matrix (Fin 4) (Fin 4) ℝ) :
    transformAmb (d := d) (R₁ * R₂) = (transformAmb R₁).comp (transformAmb R₂) := by
  ext Φ a; simp [transformAmb, transformCoord_mul]

private lemma sum4_swap {α β γ δ M : Type*} [Fintype α] [Fintype β] [Fintype γ] [Fintype δ]
    [AddCommMonoid M] (f : α → β → γ → δ → M) :
    (∑ a, ∑ b, ∑ c, ∑ d, f a b c d) = ∑ c, ∑ d, ∑ a, ∑ b, f a b c d := by
  calc (∑ a, ∑ b, ∑ c, ∑ d, f a b c d)
      = ∑ a, ∑ c, ∑ b, ∑ d, f a b c d := Finset.sum_congr rfl fun _ _ => Finset.sum_comm
    _ = ∑ c, ∑ a, ∑ b, ∑ d, f a b c d := Finset.sum_comm
    _ = ∑ c, ∑ a, ∑ d, ∑ b, f a b c d := Finset.sum_congr rfl fun _ _ =>
          Finset.sum_congr rfl fun _ _ => Finset.sum_comm
    _ = ∑ c, ∑ d, ∑ a, ∑ b, f a b c d := Finset.sum_congr rfl fun _ _ => Finset.sum_comm

private lemma sum3_swap {α β γ M : Type*} [Fintype α] [Fintype β] [Fintype γ]
    [AddCommMonoid M] (f : α → β → γ → M) :
    (∑ a, ∑ b, ∑ c, f a b c) = ∑ c, ∑ a, ∑ b, f a b c := by
  calc (∑ a, ∑ b, ∑ c, f a b c)
      = ∑ a, ∑ c, ∑ b, f a b c := Finset.sum_congr rfl fun _ _ => Finset.sum_comm
    _ = ∑ c, ∑ a, ∑ b, f a b c := Finset.sum_comm

theorem transformAmb_FVec (R : Matrix (Fin 4) (Fin 4) ℝ) (μ ν : Fin 4) :
    transformAmb R (FVec L μ ν) =
      ∑ μ' : Fin 4, ∑ ν' : Fin 4, ((R μ' μ * R ν' ν : ℝ) : ℂ) • FVec L μ' ν' := by
  funext a
  simp only [transformAmb, LinearMap.coe_mk, AddHom.coe_mk, Finset.sum_apply, Pi.smul_apply,
    FVec, AComp, map_add, map_sub, map_sum, AlgHom.map_smul_of_tower, map_mul]
  have h_cd_sum : ∀ (μ : Fin 4) (f : Fin 4 → CoordPoly d),
      coordDeriv μ (∑ i : Fin 4, f i) = ∑ i : Fin 4, coordDeriv μ (f i) :=
    fun μ f => map_sum (coordDeriv μ) f Finset.univ
  have h_cd_smul : ∀ (μ : Fin 4) (c : ℂ) (p : CoordPoly d),
      coordDeriv μ (c • p) = c • coordDeriv μ p :=
    fun μ c p => (coordDeriv μ).map_smul c p
  simp only [transformCoord_deriv, transformCoord_X, actJet_zero]
  simp only [smul_add, smul_sub, Finset.smul_sum, smul_smul, Complex.ofReal_mul]
  simp only [Finset.sum_mul, Finset.mul_sum, smul_mul_assoc, mul_smul_comm]
  simp only [Finset.sum_add_distrib, Finset.sum_sub_distrib]
  have h_lhs_1 : (∑ x : Fin 4, ((R x μ : ℝ) : ℂ) •
      coordDeriv x (∑ ν' : Fin 4, ((R ν' ν : ℝ) : ℂ) • MvPolynomial.X (0, ν', a))) =
      ∑ x : Fin 4, ∑ x_1 : Fin 4,
        (((R x μ : ℝ) : ℂ) * ((R x_1 ν : ℝ) : ℂ)) • coordDeriv x (MvPolynomial.X (0, x_1, a)) := by
    refine Finset.sum_congr rfl fun x _ => ?_
    rw [h_cd_sum, Finset.smul_sum]
    refine Finset.sum_congr rfl fun x_1 _ => ?_
    rw [h_cd_smul, smul_smul]
  have h_lhs_2 : (∑ x : Fin 4, ((R x ν : ℝ) : ℂ) •
      coordDeriv x (∑ ν' : Fin 4, ((R ν' μ : ℝ) : ℂ) • MvPolynomial.X (0, ν', a))) =
      ∑ x : Fin 4, ∑ x_1 : Fin 4,
        (((R x μ : ℝ) : ℂ) * ((R x_1 ν : ℝ) : ℂ)) • coordDeriv x_1 (MvPolynomial.X (0, x, a)) := by
    trans (∑ x_1 : Fin 4, ∑ x : Fin 4,
        (((R x μ : ℝ) : ℂ) * ((R x_1 ν : ℝ) : ℂ)) • coordDeriv x_1 (MvPolynomial.X (0, x, a)))
    · refine Finset.sum_congr rfl fun x_1 _ => ?_
      rw [h_cd_sum, Finset.smul_sum]
      refine Finset.sum_congr rfl fun x _ => ?_
      rw [h_cd_smul, smul_smul, mul_comm ((R x_1 ν : ℝ) : ℂ) ((R x μ : ℝ) : ℂ)]
    · exact Finset.sum_comm
  rw [h_lhs_1, h_lhs_2]
  refine congrArg₂ (fun p q : CoordPoly d => p + q) rfl ?_
  simp only [Finset.smul_sum, smul_smul]
  have h_swap : ∀ (f : Fin d → Fin d → Fin 4 → Fin 4 → CoordPoly d),
      (∑ x, ∑ x_1, ∑ x_2, ∑ x_3, f x x_1 x_2 x_3) =
      ∑ x_2, ∑ x_3, ∑ x, ∑ x_1, f x x_1 x_2 x_3 := fun f => by
    calc (∑ x, ∑ x_1, ∑ x_2, ∑ x_3, f x x_1 x_2 x_3)
      _ = ∑ x, ∑ x_2, ∑ x_1, ∑ x_3, f x x_1 x_2 x_3 :=
          Finset.sum_congr rfl fun x _ => Finset.sum_comm
      _ = ∑ x_2, ∑ x, ∑ x_1, ∑ x_3, f x x_1 x_2 x_3 := Finset.sum_comm
      _ = ∑ x_2, ∑ x, ∑ x_3, ∑ x_1, f x x_1 x_2 x_3 :=
          Finset.sum_congr rfl fun x_2 _ => Finset.sum_congr rfl fun x _ => Finset.sum_comm
      _ = ∑ x_2, ∑ x_3, ∑ x, ∑ x_1, f x x_1 x_2 x_3 :=
          Finset.sum_congr rfl fun x_2 _ => Finset.sum_comm
  rw [h_swap]
  rw [Finset.sum_comm]
  refine Finset.sum_congr rfl fun x _ => Finset.sum_congr rfl fun x_1 _ =>
    Finset.sum_congr rfl fun x_2 _ => Finset.sum_congr rfl fun x_3 _ => ?_
  congr 1; ring

theorem transformAmb_covDerivAmb (R : Matrix (Fin 4) (Fin 4) ℝ) (μ : Fin 4) (Φ : AmbientLie d) :
    transformAmb R (covDerivAmb L μ Φ) =
      ∑ μ' : Fin 4, ((R μ' μ : ℝ) : ℂ) • covDerivAmb L μ' (transformAmb R Φ) := by
  ext a
  simp only [transformAmb, covDerivAmb, LinearMap.coe_mk, AddHom.coe_mk, Finset.sum_apply,
    Pi.smul_apply, map_add, map_sum, AlgHom.map_smul_of_tower, map_mul, AComp,
    transformCoord_deriv, transformCoord_X, actJet_zero]
  simp only [Finset.sum_mul, smul_mul_assoc, smul_add, Finset.smul_sum]
  rw [Finset.sum_add_distrib]
  congr 2
  trans (∑ μ' : Fin 4, ∑ b : Fin d, ∑ c : Fin d,
    ((structConst L a b c : ℝ) : ℂ) • (((R μ' μ : ℝ) : ℂ) • (AComp μ' b * transformCoord R (Φ c))))
  · exact sum3_swap (fun b c μ' =>
      ((structConst L a b c : ℝ) : ℂ) • (((R μ' μ : ℝ) : ℂ) • (AComp μ' b * transformCoord R (Φ c))))
  · refine Finset.sum_congr rfl fun μ' _ => ?_
    dsimp only [AComp]
    refine Finset.sum_congr rfl fun b _ => Finset.sum_congr rfl fun c _ => ?_
    rw [smul_comm]

theorem transformAmb_bracketAmb (R : Matrix (Fin 4) (Fin 4) ℝ) (Φ Ψ : AmbientLie d) :
    transformAmb R (bracketAmb L Φ Ψ) =
      bracketAmb L (transformAmb R Φ) (transformAmb R Ψ) := by
  ext a
  simp [transformAmb, bracketAmb, map_sum, AlgHom.map_smul_of_tower, map_mul]

theorem transformAmb_inLiePoly (R : Matrix (Fin 4) (Fin 4) ℝ) {Φ : AmbientLie d}
    (hΦ : InLiePoly L Φ) : InLiePoly L (transformAmb R Φ) := by
  induction hΦ with
  | F μ ν =>
    rw [transformAmb_FVec]
    exact Submodule.sum_mem (LiePolySub L) fun μ' _ =>
      Submodule.sum_mem (LiePolySub L) fun ν' _ =>
        InLiePoly.smul _ (InLiePoly.F μ' ν')
  | covDeriv μ _ ih =>
    rw [transformAmb_covDerivAmb]
    exact Submodule.sum_mem (LiePolySub L) fun μ' _ =>
      InLiePoly.smul _ (InLiePoly.covDeriv μ' ih)
  | bracket _ _ ih1 ih2 =>
    rw [transformAmb_bracketAmb]
    exact InLiePoly.bracket ih1 ih2
  | zero => simpa using InLiePoly.zero
  | add _ _ ih1 ih2 =>
    rw [map_add]; exact InLiePoly.add ih1 ih2
  | smul c _ ih =>
    rw [map_smul]; exact InLiePoly.smul c ih

theorem coordConj_deriv {d : ℕ} (μ : Fin 4) (f : CoordPoly d) :
    coordConj (coordDeriv μ f) = coordDeriv μ (coordConj f) := by
  induction f using MvPolynomial.induction_on with
  | C c => simp [coordConj, MvPolynomial.algebraMap_eq]
  | add f g hf hg => simp [map_add, hf, hg]
  | mul_X f v hf =>
    rcases v with ⟨α, ν, a⟩
    simp [coordDeriv_leibniz, coordConj_X, coordDeriv_X, hf, map_mul]

theorem coordConj_real_smul {d : ℕ} (r : ℝ) (f : CoordPoly d) :
    coordConj (r • f) = r • coordConj f := by
  simp only [Algebra.smul_def, map_mul]
  change coordConj (MvPolynomial.C (r : ℂ)) * coordConj f = MvPolynomial.C (r : ℂ) * coordConj f
  rw [coordConj_C, Complex.conj_ofReal]

/-- Componentwise complex conjugation on `AmbientLie d`. -/
def conjAmb (Φ : AmbientLie d) : AmbientLie d := fun a => coordConj (Φ a)

theorem conjAmb_FVec (μ ν : Fin 4) : conjAmb (FVec L μ ν) = FVec L μ ν := by
  ext a
  simp [conjAmb, FVec, AComp, coordDeriv_X, map_add, map_sub, map_sum,
    coordConj_real_smul, coordConj_X, map_mul]

theorem conjAmb_covDerivAmb (μ : Fin 4) (Φ : AmbientLie d) :
    conjAmb (covDerivAmb L μ Φ) = covDerivAmb L μ (conjAmb Φ) := by
  ext a
  simp [conjAmb, covDerivAmb, AComp, map_add, map_sum, coordConj_real_smul,
    coordConj_deriv, coordConj_X, map_mul]

theorem conjAmb_bracketAmb (Φ Ψ : AmbientLie d) :
    conjAmb (bracketAmb L Φ Ψ) = bracketAmb L (conjAmb Φ) (conjAmb Ψ) := by
  ext a
  simp [conjAmb, bracketAmb, map_sum, coordConj_real_smul, map_mul]

theorem conjAmb_inLiePoly {Φ : AmbientLie d} (hΦ : InLiePoly L Φ) :
    InLiePoly L (conjAmb Φ) := by
  induction hΦ with
  | F μ ν => rw [conjAmb_FVec]; exact InLiePoly.F μ ν
  | covDeriv μ _ ih => rw [conjAmb_covDerivAmb]; exact InLiePoly.covDeriv μ ih
  | bracket _ _ ih1 ih2 => rw [conjAmb_bracketAmb]; exact InLiePoly.bracket ih1 ih2
  | zero =>
    have : conjAmb (0 : AmbientLie d) = 0 := funext fun a => map_zero coordConj
    rw [this]; exact InLiePoly.zero
  | add _ _ ih1 ih2 =>
    have : ∀ A B : AmbientLie d, conjAmb (A + B) = conjAmb A + conjAmb B :=
      fun A B => funext fun a => map_add coordConj (A a) (B a)
    rw [this]; exact InLiePoly.add ih1 ih2
  | smul c _ ih =>
    have : ∀ (k : ℂ) (A : AmbientLie d), conjAmb (k • A) = starRingEnd ℂ k • conjAmb A :=
      fun k A => funext fun a => coordConj_smul k (A a)
    rw [this]; exact InLiePoly.smul _ ih

